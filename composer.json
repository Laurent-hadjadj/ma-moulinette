{
    "type": "project",
    "license": "CC-BY-NC-SA-4.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "name": "ma-moulinette/ma-moulinette",
    "description": "Dépendances symfony pour l'application Ma-Moulinette",
    "require": {
        "php": ">=8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.1",
        "dompdf/dompdf": "^3.1.6",
        "dragonmantank/cron-expression": "^3.6.0",
        "easycorp/easyadmin-bundle": "^5.5.1",
        "knplabs/knp-paginator-bundle": "^6.11.0",
        "matomo/device-detector": "^6.5.1",
        "setasign/fpdf": "^1.9.0",
        "setasign/fpdi": "^2.6.8",
        "symfony/asset": "^8.1.0",
        "symfony/asset-mapper": "^8.1.7",
        "symfony/cache": "^8.1.7",
        "symfony/clock": "^8.1.0",
        "symfony/config": "^8.1.5",
        "symfony/console": "^8.1.7",
        "symfony/dependency-injection": "^8.1.7",
        "symfony/doctrine-messenger": "^8.1.7",
        "symfony/dotenv": "^8.1.6",
        "symfony/expression-language": "8.1.6",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^8.1.7",
        "symfony/framework-bundle": "^8.1.7",
        "symfony/http-client": "^8.1.7",
        "symfony/http-foundation": "^8.1.7",
        "symfony/intl": "^8.1.5",
        "symfony/ldap": "^8.1.0",
        "symfony/mailer": "^8.1.7",
        "symfony/messenger": "^8.1.7",
        "symfony/mime": "^8.1.7",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/process": "^8.1.7",
        "symfony/property-access": "^8.1.4",
        "symfony/property-info": "^8.1.7",
        "symfony/rate-limiter": "^8.1.6",
        "symfony/runtime": "^8.1.0",
        "symfony/scheduler": "^8.1.7",
        "symfony/security-bundle": "8.1.7",
        "symfony/security-core": "8.1.6",
        "symfony/serializer": "^8.1.7",
        "symfony/string": "^8.1.7",
        "symfony/translation": "^8.1.5",
        "symfony/twig-bundle": "^8.1.7",
        "symfony/validator": "^8.1.7",
        "symfony/yaml": "^8.1.6",
        "twig/extra-bundle": "^3.24.0",
        "twig/intl-extra": "^3.24.0",
        "twig/twig": "^3.24.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "justinrainbow/json-schema": "^6.12.0",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.5",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.3.4",
        "symfony/browser-kit": "^8.1.5",
        "symfony/css-selector": "^8.1.6",
        "symfony/debug-bundle": "^8.1.0",
        "symfony/dom-crawler": "^8.1.5",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/phpunit-bridge": "^8.1.6",
        "symfony/stopwatch": "^8.1.0",
        "symfony/web-profiler-bundle": "^8.1.7"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php -d xdebug.mode=off vendor/bin/phpunit",
        "test:unit": "@php -d xdebug.mode=off vendor/bin/phpunit --testsuite=unit",
        "test:integration": "@php -d xdebug.mode=off vendor/bin/phpunit --testsuite=integration",
        "test:functional": "@php -d xdebug.mode=off vendor/bin/phpunit --testsuite=functional",
        "test:coverage": "@php -d xdebug.mode=off -d pcov.enabled=1 vendor/bin/phpunit --coverage-text=var/coverage/coverage.txt --coverage-html=var/coverage/coverage-html"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}

{
    "type": "project",
    "license": "CC-BY-NC-SA-4.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "name": "ma-moulinette/ma-moulinette",
    "description": "Dépendances symfony pour l'application Ma-Moulinette",
    "require": {
        "php": ">=8.3.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "cesargb/php-log-rotation": "^2.7.1",
        "doctrine/annotations": "^2.0.2",
        "doctrine/dbal": "^4.2.1",
        "doctrine/doctrine-bundle": "^2.13.1",
        "doctrine/orm": "^3.3.1",
        "dragonmantank/cron-expression": "^3.4.0",
        "easycorp/easyadmin-bundle": "^4.20.3",
        "knplabs/knp-paginator-bundle": "^6.6.1",
        "symfony/asset": "^7.3.0",
        "symfony/asset-mapper": "^7.3.0",
        "symfony/cache": "^7.3.1",
        "symfony/clock": "^7.3.0",
        "symfony/console": "^7.3.1",
        "symfony/doctrine-messenger": "^7.3.0",
        "symfony/dotenv": "^7.3.0",
        "symfony/expression-language": "^7.3.0",
        "symfony/filesystem": "^7.3.0",
        "symfony/flex": "^2.4.7",
        "symfony/form": "^7.3.0",
        "symfony/framework-bundle": "^7.3.1",
        "symfony/http-client": "^7.3.1",
        "symfony/intl": "^7.3.0",
        "symfony/mailer": "^7.2.6",
        "symfony/messenger": "7.3.*",
        "symfony/mime": "^7.2.6",
        "symfony/monolog-bundle": "^3.10.0",
        "symfony/notifier": "^7.3.0",
        "symfony/process": "^7.3.0",
        "symfony/property-access": "^7.3.0",
        "symfony/property-info": "^7.3.1",
        "symfony/proxy-manager-bridge": "^6.4.13",
        "symfony/rate-limiter": "^7.3.0",
        "symfony/runtime": "^7.3.0",
        "symfony/scheduler": "^7.2.3",
        "symfony/security-bundle": "7.3.0",
        "symfony/security-core": "7.3.0",
        "symfony/serializer": "^7.3.0",
        "symfony/string": "^7.3.0",
        "symfony/translation": "^7.3.0",
        "symfony/twig-bundle": "^7.1.0",
        "symfony/validator": "^7.3.0",
        "symfony/web-link": "^7.3.0",
        "symfony/yaml": "^7.3.0",
        "twig/extra-bundle": "^3.17.0",
        "twig/intl-extra": "^3.17.0",
        "twig/twig": "^3.17.1"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "doctrine/doctrine-migrations-bundle": "^3.3.1",
        "justinrainbow/json-schema": "^5.3.0",
        "phpdocumentor/reflection-docblock": "^5.6.1",
        "phpstan/phpdoc-parser": "^1.33.0",
        "phpstan/phpstan": "^1.12.13",
        "phpunit/phpunit": "^9.6.22",
        "symfony/browser-kit": "^7.3.0",
        "symfony/css-selector": "^7.3.0",
        "symfony/debug-bundle": "^7.3.0",
        "symfony/dom-crawler": "^7.3.0",
        "symfony/maker-bundle": "^1.61.0",
        "symfony/phpunit-bridge": "^7.3.0",
        "symfony/stopwatch": "^7.3.0",
        "symfony/web-profiler-bundle": "^7.3.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    }
}

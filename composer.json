{
    "type": "project",
    "license": "CC-BY-NC-SA-4.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "name": "ma-moulinette/ma-moulinette",
    "description": "Dépendances symfony pour l'application Ma-Moulinette",
    "require": {
        "php": ">=8.4.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "amphp/file": "^3.2.0",
        "amphp/http-client": "^5.3.4",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.3",
        "dompdf/dompdf": "^3.1.5",
        "dragonmantank/cron-expression": "^3.6.0",
        "easycorp/easyadmin-bundle": "^5.0.5",
        "knplabs/knp-paginator-bundle": "^6.10.0",
        "symfony/asset": "^8.0.8",
        "symfony/asset-mapper": "^8.0.8",
        "symfony/cache": "^8.0.8",
        "symfony/clock": "^8.0.8",
        "symfony/config": "^8.0.8",
        "symfony/console": "^8.0.8",
        "symfony/dependency-injection": "^8.0.8",
        "symfony/doctrine-messenger": "^8.0.6",
        "symfony/dotenv": "^8.0.8",
        "symfony/expression-language": "^8.0.8",
        "symfony/flex": "^2.10.0",
        "symfony/form": "^8.0.8",
        "symfony/framework-bundle": "^8.0.8",
        "symfony/http-client": "^8.0.8",
        "symfony/http-foundation": "^8.0.8",
        "symfony/intl": "^8.0.8",
        "symfony/ldap": "^8.0.8",
        "symfony/mailer": "^8.0.8",
        "symfony/messenger": "^8.0.8",
        "symfony/mime": "^8.0.8",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "^8.0.8",
        "symfony/process": "^8.0.8",
        "symfony/property-access": "^8.0.8",
        "symfony/property-info": "^8.0.8",
        "symfony/rate-limiter": "^8.0.8",
        "symfony/runtime": "^8.0.8",
        "symfony/scheduler": "^8.0.8",
        "symfony/security-bundle": "^8.0.8",
        "symfony/security-core": "^8.0.8",
        "symfony/serializer": "^8.0.8",
        "symfony/string": "^8.0.8",
        "symfony/translation": "^8.0.8",
        "symfony/twig-bundle": "^8.0.8",
        "symfony/validator": "^8.0.8",
        "symfony/web-link": "^8.0.8",
        "symfony/yaml": "^8.0.8",
        "twig/extra-bundle": "^3.24.0",
        "twig/intl-extra": "^3.24.0",
        "twig/twig": "^3.24.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "justinrainbow/json-schema": "^6.8.0",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "phpstan/phpstan": "^2.1.48",
        "phpunit/phpunit": "^13.1.5",
        "symfony/browser-kit": "^8.0.8",
        "symfony/css-selector": "^8.0.8",
        "symfony/debug-bundle": "^8.0.8",
        "symfony/dom-crawler": "^8.0.8",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^8.0.8",
        "symfony/stopwatch": "^8.0.8",
        "symfony/web-profiler-bundle": "^8.0.8"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}

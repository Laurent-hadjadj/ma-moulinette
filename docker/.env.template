############# Environnement (linux/amd64)
platform=linux/amd64

#Default vars
LOCAL_TZ=Europe/Paris
LOCAL_LANG=fr_FR.utf8

############# Volumes
## à modifier selon l'environnement
root_volume="."

############# PostgreSQL
postgresql_initdb="--locale-provider=icu --icu-locale=fr-FR"
postgresql_version=18.1-alpine3.22
postgresql_user=db_user
# Mot de passe du superuser PostgreSQL (compte 'postgres' du container)
postgresql_password=changeMe_PostgresStrongPassword
# Mot de passe de l'utilisateur applicatif db_user (injecté dans 01_create_roles.sql)
db_user_password=changeMe_DbUserStrongPassword
postgresql_db=ma_moulinette

############# Nginx
nginx_version=1.29.3

############# PRoXY
http_proxy=http://proxy.serveur.fr:8080
https_proxy=http://proxy.serveur.fr:8080
no_proxy=localhost,127.0.0.1,localaddress,.serveur.fr,localhost,*.serveur.fr,postgresql,php-fpm,nginx

############# OWASP DependencyCheck ingestion
# MODIF 2026-05-08 : token bearer pour l'endpoint /api/secure/dependency-check/upload
# Générer via : openssl rand -hex 32
# Doit être identique cote CI GitLab (variable masquee DC_INGEST_TOKEN_PROD)
# Si vide ou égal a "changeme", l'endpoint répond 503 par sécurité.
DC_INGEST_TOKEN=changeme

############# Chiffrement du mot de passe d'accès Actuator
# MODIF 2026-07-14 : clé de chiffrement (AES-256-GCM) du mot de passe stocké
# dans l'inventaire Actuator. À REGENERER pour tout déploiement réel via :
# openssl rand -base64 32
# La valeur ci-dessous n'est qu'un exemple de démonstration.
ACTUATOR_CIPHER_KEY=ZaMR9NBLPvcMhq/L8kBQC72QkrVImo2GkGM/bY8rmzE=

############# Jobs cron prod (cron-ma-moulinette)
# MODIF 2026-05-21 : variables pour app:sonar:update-tags et app:collecte:run
# URL et token de l'instance SonarQube (app:sonar:update-tags — tous les jours a 01h30)
# Le token doit disposer du scope "Administer" ou "Create Project" sur SonarQube.
SONAR_URL=https://sonar.serveur.fr
SONAR_TOKEN=changeme_sonar_token

# URL et token de l'application Ma-Moulinette (app:collecte:run — tous les jours a 00h30)
# Le token se génère dans Ma-Moulinette : Profil → Jetons d'accès.
MAMOUL_URL=https://ma.moulinette.serveur.fr
MAMOUL_TOKEN=changeme_mamoul_token

# MODIF 2026-07-21 : ces 7 variables sont requises au démarrage de
# app:sonar:update-tags et app:collecte:run (absence = échec immédiat de la
# commande, cf. config/services.yaml). Valeurs par défaut = vérification TLS
# activée ; ne mettre *_VERIFY_PEER/*_VERIFY_HOST à 0 que si SONAR_URL/MAMOUL_URL
# utilisent un certificat interne non reconnu par le magasin de CA du container.
MAMOUL_CLI_VERIFY_PEER=1
MAMOUL_CLI_VERIFY_HOST=1
MAMOUL_CLI_CIPHERS="DEFAULT:!DH"
MAMOUL_CLI_USE_PROXY=0
MAMOUL_CLI_PROXY_URL=
MAMOUL_CLI_PROXY_USER_PWD=
MAMOUL_CLI_NO_PROXY='localhost,127.0.0.1'

#Traefik vars
traefik_host=[changeMe].serveur.fr
traefik_pathprefix=/ma-moulinette
traefik_lb_port=80
traefik_container=ma-moulinette
traefik_forwarded_prefix=/ma-moulinette/
traefik_enable=true

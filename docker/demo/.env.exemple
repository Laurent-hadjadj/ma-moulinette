# Copier en .env (ignoré par git) puis remplacer chaque valeur. Valeurs à générer, jamais réutilisées d'ailleurs.
# Le type attendu est indiqué au-dessus de chaque variable (hex = openssl rand -hex 24 ; base64 = openssl rand -base64 32).

# Mot de passe du superuser PostgreSQL. Type : hex, 48 caractères (aucune contrainte de forme).
DEMO_POSTGRES_PASSWORD=remplacer
# Mot de passe du rôle applicatif db_user. Type : HEX uniquement, 48 caractères : il est inséré dans l'URL DATABASE_URL,
# donc ni « / », ni « + », ni « = » (ce que produit le base64).
DEMO_DB_USER_PASSWORD=remplacer
# Secret de l'application (APP_SECRET, SECRET, SALT) ET clé de chiffrement Actuator (ACTUATOR_CIPHER_KEY).
# Type : BASE64 de 32 octets (44 caractères). Un hex de 48 caractères est refusé comme clé Actuator
# (InvalidCipherKeyException : la clé doit décoder en exactement 32 octets).
DEMO_APP_SECRET=remplacer

# SonarQube (lecture seule) : laisser vide pour une démo sans SonarQube (adresse invalide, aucun appel sortant).
#   DEMO_SONAR_URL   Type : adresse https:// de l'instance (ne jamais la committer)
#   DEMO_SONAR_TOKEN Type : jeton utilisateur du compte « ma-moulinette-demo » (durée limitée : noter la date d'expiration)
DEMO_SONAR_URL=
DEMO_SONAR_TOKEN=

# Mot de passe du compte de démonstration demo@ma-moulinette.fr (seule son empreinte entre en base, à chaque restauration).
# Type : texte libre, mémorisable. Il sera communiqué aux visiteurs : sans valeur sensible, mais jamais celui d'un vrai compte.
DEMO_USER_PASSWORD=remplacer

# --- Poste de développement uniquement : inutile sur le serveur ---
# Pile de préparation des données (docker-compose.prepa.yml, PostgreSQL jetable sur 127.0.0.1:5435) : voir preparer-donnees.sh.
# Type : hex, 48 caractères, pour les deux.
DEMO_PREPA_POSTGRES_PASSWORD=remplacer
DEMO_PREPA_DB_USER_PASSWORD=remplacer

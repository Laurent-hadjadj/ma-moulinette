#####################################################################
##              ma-moulinette v2.5.0-RELEASE                       ##
##              Environnement de production                        ##
#####################################################################

######################################################################
###               Infrastructure                                    ##
######################################################################
###> symfony/framework-bundle ###
# TODO - Type d'environnement prod|dev
APP_ENV=prod
# TODO - Activation du mode debug = 1
APP_DEBUG=0
VAR_DUMPER_FORMAT=server

# Clé UUIDv4 ou ULID v7
# https://www.uuidgenerator.net/version7
# TODO - Ajouter une nouvelle clé
APP_SECRET=<UUIDv4 ou ULIDv7>

# Type environnement : DEV, REC, PRD
# TODO - Ajouter le type d'environnement
ENVIRONNEMENT=<PRD>
###< symfony/framework-bundle ###

###> symfony/lock ###
LOCK_DSN=semaphore
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
# TODO - Changer les paramètres si besoin (attention => scripts)
DATABASE_URL=postgresql://<db_user>:<db_password>@<localhost>:<5432>/ma_moulinette?serverVersion=15&charset=utf8
###< doctrine/doctrine-bundle ###

###> symfony/webapp-meta ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/webapp-meta ###

###> ldap ###
# TODO - Adapter les paramètres à votre infra
LDAP_HOST=<LDAP_HOST>
# TODO - 389|636
LDAP_PORT=<LDAP_PORT>
# TODO - none|ssl
LDAP_ENCRYPTION=<LDAP_ENCRYPTION>
# TODO - @ma-moulinette.fr
LDAP_UPN_SUFFIX=<LDAP_UPN_SUFFIX>
#TODO - ex. "ou=developpement,dc=ma-moulinette,dc=fr"
LDAP_BASE_DN=<LDAP_BASE_DN>
# TODO - ex. "cn=svc_dev,ou=utilisateurs,dc=ma-moulinette,dc=fr"
LDAP_BIND_DN=<LDAP_BIND_DN>
LDAP_BIND_PASSWORD=<LDAP_BIND_PASSWORD>
LDAP_X_TLS_REQUIRE_CERT=0
###< ldap ###

###> sonarqube.configuration ###
# TODO : Paramètres d'accès au serveur SonarQube
# TODO : TOKEN | USER+PASSWORD
SONAR_URL=<SONAR_URL>
SONAR_TOKEN=<SONAR_TOKEN>
SONAR_USER=<SONAR_USER>
SONAR_PASSWORD=<SONAR_PASSWORD>

SONAR_ACTIVITY_TOKEN=<SONAR_ACTIVITY_TOKEN>
SONAR_ACTIVITY_USER=<SONAR_ACTIVITY_USER>
SONAR_ACTIVITY_PASSWORD=<SONAR_ACTIVITY_PASSWORD>
###< sonarqube ###

######################################################################
###               Accessibilité                                     ##
######################################################################

###> Application ###
# On autorise les hosts suivants :
# TODO : "^ma-petite-entreprise\.fr$" | 10.0.0.1
TRUST_HOST1=<TRUST_HOST1>
TRUST_HOST2=<TRUST_HOST2>

# serveur proxy
# TODO : https://proxy.monapplocation.fr:8080
PROXY=''
# TODO : Adresses non proxyfiées.
TRUSTED_PROXIES='localhost,127.0.0.1'

# vérification des certificats
# TODO : 0 = false, 1 = true
# TODO : Nécessite une vérification du certificat SSL utilisé.
VERIFY_PEER=0
# TODO : vérifie le nom du certificat proxy par rapport à l'hôte
VERIFY_HOST=0

# Définition des ciphers TLS1.3
# TODO : Définit la liste des chiffrements. Tous sauf DH
CIPHERS="DEFAULT:!DH"
###< Application ###

###> Commandes ###
#  Variables de connexion SSL et proxy pour les commandes en ligne de commande (ex: app:collecte:run, app:update-sonar-tags, etc.)
MAMOUL_CLI_VERIFY_PEER=0
MAMOUL_CLI_VERIFY_HOST=0
MAMOUL_CLI_CIPHERS="DEFAULT:!DH"

# Variables de configuration du proxy pour les commandes en ligne de commande
## 0 = false, 1 = true
MAMOUL_CLI_USE_PROXY=0
MAMOUL_CLI_PROXY_URL=''
MAMOUL_CLI_PROXY_USER_PWD=''
MAMOUL_CLI_NO_PROXY='localhost,127.0.0.1'
###< Commandes ###

#####################################################################
###               Application                                      ##
#####################################################################

# clé pour chiffré le cookie de connexion
# Clé UUIDv4 ou ULID v7
# https://www.uuidgenerator.net/version7
# TODO - Changer la clé
SECRET=<UUIDv4 ou ULIDv7>
# Nombre de favori affiché sur la page d’accueil
NOMBRE_FAVORI=8
# On vérifie tous les jours la présence d'un nouveau projet
MAJ_PROJET=0
# On vérifie tous les 30 jours la présence d'un changement de profil
MAJ_PROFIL=30

# Chemin relatif vers les journaux d'audit des traitements de masse.
PATH_AUDIT='/var/audit'

###> [2.0.0] API ###
## App.Client, pour l'accès du front aux API
# Chaîne secrète arbitraire (comparaison en texte brut côté serveur,
# ApiClientHeaderSubscriber ne fait ni base64 ni bcrypt sur cette valeur).
# Format recommandé : 64 chars hex (openssl rand -hex 32).
APP_CLIENT_TOKEN=<APP_CLIENT_TOKEN>
# TODO : url autorisée
APP_ALLOWED_ORIGINS='localhost,127.0.0.1'

# [2.0.0] Salt pour la protection des appels vers l'API
# Format recommande : 26 chars hex.
# TODO - Ajouter une nouvelle clé
CSRF_SALT=<openssl rand -hex 26>

# Token pour la protection des appels vers l'API /api/public/traitements/automatique
# Chaîne secrète arbitraire (comparaison en texte brut côté serveur,
# BatchAutoController ne fait ni base64 ni bcrypt sur cette valeur).
# Format recommandé : 64 chars hex (openssl rand -hex 32).
API_CLIENT_TOKEN=<API_CLIENT_TOKEN>
###< [2.0.0] API ###

###> [2.1.0] Actuator ###
# TODO : Clé pour chiffrer le password du compte actuator (AES-256-GCM).
clsACTUATOR_CIPHER_KEY=<openssl rand -base64 32>
###< Actuator ###

###> [2.0.0] dc-ingest ###
# Token bearer pour les endpoints : POST /api/secure/dependency-check/upload
# Format recommande : 64 chars hex (openssl rand -hex 32).
DC_INGEST_TOKEN=changeme
###< dc-ingest ###

###> [2.3.0] zap-ingest ###
# Token bearer pour les endpoints : POST /api/secure/zap/upload (rapport ZAP DAST).
# Format recommande : 64 chars hex (openssl rand -hex 32).
ZAP_INGEST_TOKEN=changeme
###< zap-ingest ###

###> [2.0.0] rapport pdf watermark ###
# Mode du filigrane sur les rapports PDF (Suivi, Owasp, etc.)
#   always       : filigrane sur tous les documents
#   confidential : filigrane uniquement si document_type contient "confidentiel" (défaut)
#   never        : filigrane désactivé
# TODO : statut des rapports
RAPPORT_PDF_WATERMARK_MODE=confidential
###< rapport pdf watermark ###

###> batch userAgent ###
# [2.3.0] Nombre de userAgent traité au chargement de la page PROJET
USER_AGENT_BATCH_MANUEL=25
# [2.3.0] Nombre de userAgent traité manuellement depuis la page STATISTIQUE (utilisateur)
USER_AGENT_BATCH_AUTOMATIQUE=500
###< batch userAgent ###

###> [2.0.0] Répartition par module ###
# Liste des clés pour l'identification des modules applicatives
MODULE_FRONTEND="presentation,webapp,front,frontend,angular,templates,styles,css,js,ts,vue,react,svelte,scss,less,html,xhtml"
MODULE_BACKEND="metier,back,backend,controller,api,service,business,common,dao,dto,sql,liquibase,changelog,middleoffice,rest,soap,entite,entity,repository,interface, converter, serviceweb,serviceweb-client"
MODULE_AUTRE="batch,rdd,etl,pipeline,processing"
###< [2.0.0] Répartition par module ###

######################################################################
###               Gestion des extensions                            ##
######################################################################

###> OWASP ###
# TODO : OWASP Top10 - valeur autorisée : 8 (8, 9), 10 (2024, 2025 et 2026)
SONAR_VERSION=10
###< OWASP ###

###> [2.3.0] Empreinte-Écologique-Extension ###
# Utilisation des plugins SonarQube Creedengo (creedengo-java/javascript/php/python).
# Les plugins correspondants doivent être installés sur le serveur SonarQube pour activer.
# TODO : Ajouter les plugins + TRUE
CREEDENGO_ENABLED=false
###< Empreinte-Écologique-Extension ###

###> TRACK_MY_LOGGER ###
# Utilisation du plugin SonarQube Track-Logger-Method
# TODO : Ajouter le plugin + true
TRACK_LOGGER_METHOD=false
###< TRACK_MY_LOGGER ###


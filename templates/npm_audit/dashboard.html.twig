{% set title = 'npm audit - Dashboard ' ~ project_artifact %}
{% set description = app_name ~ ' - dashboard npm audit du scan.' %}
{% set bottom = 'footer-fixed' %}

<!DOCTYPE html>
<html lang="fr" dir="ltr">

    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {% block importmap %}
        {{ importmap('npm-audit-dashboard') }}
        {% endblock %}
    </head>

    <body>
        {{ include('header.html.twig') }}

        <header class="grid-container margin-top-1">
            <nav aria-label="Fil d'Ariane, vous etes ici">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li><a href="{{ path('npm_audit_index') }}">npm audit</a></li>
                    <li>
                        <a href="{{ path('npm_audit_projet', {
                            'group': project_group,
                            'artifact': project_artifact,
                            'version': project_version}) }}">{{ project_artifact }} {{ project_version }}</a>
                    </li>
                    <li aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </header>

        {{ include('_message.html.twig') }}

        <main class="grid-container margin-bottom-2">
            <h2 class="h4 claire-hand">
                <span aria-hidden="true">📊</span> Dashboard npm audit &mdash; {{ project_artifact }}
                <span class="open-sans">{{ project_version }}</span>
            </h2>

            {% if scan is null %}
                <div class="callout alert-callout-border warning">
                    <p><span aria-hidden="true">⚠️</span> Aucun scan npm audit disponible pour ce projet.</p>
                </div>
            {% else %}
                <div class="grid-x grid-margin-x margin-bottom-1">
                    <div class="cell small-12 medium-7">
                        <div class="npm-chart-container">
                            <canvas id="npm-dash-severity" role="img" aria-label="Répartition des vulnérabilités par sévérité"></canvas>
                        </div>
                    </div>
                    <div class="cell small-12 medium-5">
                        {{ _self.info_callout('Répartition des <strong>' ~ scan.vulnCountTotal ~ ' vulnérabilité(s)</strong> du dernier scan par sévérité npm native (critical/high/moderate/low/info).') }}
                    </div>
                </div>

                <div class="grid-x grid-margin-x margin-bottom-1">
                    <div class="cell small-12 medium-7">
                        <div class="npm-chart-container">
                            <canvas id="npm-dash-origin" role="img" aria-label="Répartition des vulnérabilités par origine et par sévérité"></canvas>
                        </div>
                    </div>
                    <div class="cell small-12 medium-5">
                        {{ _self.info_callout('Vulnérabilités par <strong>origine</strong> (Production/Dev/Indéterminé), ventilées par sévérité. « Indéterminé » si le payload ne contenait pas le rapport <code>prodOnly</code> (<code>npm audit --omit=dev</code>). <strong>Limite connue</strong> : <code>npm audit</code> ne distingue que production/non-production, pas <em>optional</em>/<em>peer</em> séparément pour une vulnérabilité donnée — cette ventilation plus fine existe uniquement au niveau du décompte global des dépendances (tuiles de la page détail), pas par vulnérabilité.') }}
                    </div>
                </div>

                <div class="grid-x grid-margin-x margin-bottom-1">
                    <div class="cell small-12 medium-7">
                        <div class="npm-chart-container">
                            <canvas id="npm-dash-direct" role="img" aria-label="Répartition des vulnérabilités dépendances directes vs transitives, par sévérité"></canvas>
                        </div>
                    </div>
                    <div class="cell small-12 medium-5">
                        {{ _self.info_callout('Vulnérabilités sur des dépendances <strong>directes</strong> (déclarées dans votre <code>package.json</code>) ou <strong>transitives</strong> (introduites par une autre dépendance), ventilées par sévérité. Une vulnérabilité directe est actionnable immédiatement par l\'équipe ; une vulnérabilité transitive dépend souvent d\'une mise à jour chez un mainteneur tiers.') }}
                    </div>
                </div>

                <div class="grid-x grid-margin-x margin-bottom-1">
                    <div class="cell small-12 medium-7">
                        <div class="npm-chart-container">
                            <canvas id="npm-dash-top-packages" role="img" aria-label="Top 10 des paquets les plus vulnérables de ce scan"></canvas>
                        </div>
                    </div>
                    <div class="cell small-12 medium-5">
                        {{ _self.info_callout('<strong>Top 10</strong> des paquets de <strong>ce scan</strong> ayant le plus de vulnérabilités détectées (toutes sévérités confondues) — un paquet avec plusieurs avis de sécurité distincts compte pour autant de findings.') }}
                    </div>
                </div>
            {% endif %}
            <div class="margin-bottom-4" aria-hidden="true">&nbsp;</div>
        </main>

        <script type="application/json" id="npm-audit-chart-data">{{ chart_data|json_encode|raw }}</script>

        {% macro info_callout(text) %}
        <div class="callout alert-callout-border info margin-bottom-1 clear-both">
            <p class="open-sans font-size-085 margin-bottom-0">
                <span aria-hidden="true">ℹ️</span> {{ text|raw }}
            </p>
        </div>
        {% endmacro %}

        {{ include('footer.html.twig') }}
    </body>

</html>

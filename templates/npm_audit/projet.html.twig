{% set title = 'npm audit - ' ~ project_artifact %}
{% set description = app_name ~ ' - detail scan npm audit.' %}
{% set bottom = 'footer-fixed' %}

<!DOCTYPE html>
<html lang="fr" dir="ltr">

    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {% block importmap %}
        {{ importmap('npm-audit') }}
        {% endblock %}
    </head>

    <body>
        {{ include('header.html.twig') }}

        <header class="grid-container margin-top-1">
            <nav aria-label="Fil d'Ariane, vous etes ici">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li><a href="{{ path('npm_audit_index') }}">npm audit</a></li>
                    <li aria-current="page">{{ project_artifact }} {{ project_version }}</li>
                </ol>
            </nav>
        </header>

        {{ include('_message.html.twig') }}

        <main class="grid-container margin-bottom-2">
            <h2 class="h4 claire-hand">
                <span aria-hidden="true">📦</span> {{ project_artifact }}
                <span class="text-muted">({{ project_group }})</span>
                &mdash; <span class="open-sans">{{ project_version }}</span>
            </h2>

            {% if scan is not null %}
            <div class="cell shrink margin-bottom-1">
                <a
                    id="bouton-ouvrir-npm-audit-dashboard"
                    href="{{ path('npm_audit_dashboard', {
                    'group': project_group,
                    'artifact': project_artifact,
                    'version': project_version}) }}"
                    class="button open-sans focus-dark-light"
                >
                    <span aria-hidden="true">📊</span> Dashboard
                </a>
                <a
                    id="bouton-ouvrir-rapport-PDF"
                    href="{{ path('npm_audit_projet_pdf', {
                    'group': project_group,
                    'artifact': project_artifact,
                    'version': project_version}) }}"
                    class="button open-sans focus-dark-light"
                    target="_blank"
                    rel="noopener"
                >
                    <span aria-hidden="true">📄</span> Rapport PDF
                </a>
            </div>

            {# Tuiles de synthèse : scan + dépendances (prod/dev/optional/peer, sans équivalent DC) + total vulnérabilités. #}
            <div class="grid-x grid-margin-x grid-margin-y margin-bottom-1">
                <div class="cell small-6 medium-3 large-2">
                    <div class="npm-info-tile">
                        <span class="npm-info-tile-title">Scan du</span>
                        <span class="npm-info-tile-divider" aria-hidden="true"></span>
                        <span class="npm-info-tile-value">{{ scan.scanDate|date('Y-m-d H:i') }}</span>
                    </div>
                </div>
                <div class="cell small-6 medium-3 large-2">
                    <div class="npm-info-tile">
                        <span class="npm-info-tile-title">Dépendances prod</span>
                        <span class="npm-info-tile-divider" aria-hidden="true"></span>
                        <span class="npm-info-tile-value">{{ scan.depCountProd }} / {{ scan.depCountTotal }}</span>
                    </div>
                </div>
                <div class="cell small-6 medium-3 large-2">
                    <div class="npm-info-tile">
                        <span class="npm-info-tile-title">Dépendances dev</span>
                        <span class="npm-info-tile-divider" aria-hidden="true"></span>
                        <span class="npm-info-tile-value">{{ scan.depCountDev }} / {{ scan.depCountTotal }}</span>
                    </div>
                </div>
                <div class="cell small-6 medium-3 large-2">
                    <div class="npm-info-tile">
                        <span class="npm-info-tile-title">Optional / Peer</span>
                        <span class="npm-info-tile-divider" aria-hidden="true"></span>
                        <span class="npm-info-tile-value">{{ scan.depCountOptional }} / {{ scan.depCountPeer }}</span>
                    </div>
                </div>
                <div class="cell small-12 medium-6 large-4">
                    <div class="npm-info-tile npm-info-tile-total">
                        <span class="npm-info-tile-title">Vulnérabilités détectées</span>
                        <span class="npm-info-tile-divider" aria-hidden="true"></span>
                        <span class="npm-info-tile-value">{{ scan.vulnCountTotal }} au total</span>
                    </div>
                </div>
            </div>

            <h3 class="h5 claire-hand"><span aria-hidden="true">📊</span> Répartition par sévérité</h3>
            <div class="grid-x grid-margin-x grid-margin-y severity-summary margin-bottom-1">
                <div class="cell small-12 medium-auto large-auto severity-cell">
                    <span class="badge-level critical">CRITICAL</span>
                    <span class="severity-count">{{ scan.vulnCountCritical }}</span>
                </div>
                <div class="cell small-12 medium-auto large-auto severity-cell">
                    <span class="badge-level high">HIGH</span>
                    <span class="severity-count">{{ scan.vulnCountHigh }}</span>
                </div>
                <div class="cell small-12 medium-auto large-auto severity-cell">
                    <span class="badge-level moderate">MODERATE</span>
                    <span class="severity-count">{{ scan.vulnCountModerate }}</span>
                </div>
                <div class="cell small-12 medium-auto large-auto severity-cell">
                    <span class="badge-level low">LOW</span>
                    <span class="severity-count">{{ scan.vulnCountLow }}</span>
                </div>
                <div class="cell small-12 medium-auto large-auto severity-cell">
                    <span class="badge-level info">INFO</span>
                    <span class="severity-count">{{ scan.vulnCountInfo }}</span>
                </div>
            </div>
            {% endif %}

            {% if package_summary is not empty %}
                <h3 class="h5 claire-hand"><span aria-hidden="true">📦</span> Paquets concernés ({{ package_summary|length }})</h3>
                <div class="cell small-12 margin-bottom-1 text-justify">
                    {{ _self.info_callout(
                        ' Pour mémoire<br><br>'
                        ~ '<strong>CVSS</strong> (Common Vulnerability Scoring System) : score de gravité technique de 0 à 10 — ici, le plus élevé parmi les avis de ce paquet. <br> '
                        ~ '<strong>CWE</strong> (Common Weakness Enumeration) : catégorie du type de faille (injection, dépassement de buffer…) ; le nombre affiché compte les catégories distinctes, pas les avis eux-mêmes. <br>'
                        ~ '<strong>GHSA</strong> (GitHub Security Advisory) : l\'identifiant utilisé par npm audit (colonne Advisory du détail ci-dessous) — proche d\'un CVE (catalogue MITRE) sans être identique, les deux se recoupent souvent.'
                    ) }}
                </div>
                <div class="grid-x grid-margin-x margin-bottom-1">
                    <div class="cell small-12 medium-7">
                        <div class="cell table-scroll">
                            <table class="open-sans v-middle">
                                <thead>
                                    <tr>
                                        <th>Paquet</th>
                                        <th class="text-center">Type</th>
                                        <th class="text-center">Origine</th>
                                        <th class="text-center">CVSS</th>
                                        <th class="text-center">CWE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in package_summary %}
                                        <tr class="v-middle">
                                            <td class="v-middle"><strong>{{ p.name }}</strong></td>
                                            <td class="text-center v-middle">
                                                {% if p.is_direct %}
                                                    <span class="badge-cve" title="Dépendance directe de votre package.json">Direct</span>
                                                {% else %}
                                                    <span class="badge-cve" title="Dépendance transitive (introduite par une autre dépendance)">Transitif</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center v-middle">
                                                {% if p.is_prod is null %}
                                                    <span class="badge-origin unknown" title="Rapport « prodOnly » absent de l'upload : impossible de déterminer si ce paquet est utilisé en production.">Indéterminé</span>
                                                {% elseif p.is_prod %}
                                                    <span class="badge-origin prod" title="Paquet présent dans le rapport de production (npm audit --omit=dev).">Production</span>
                                                {% else %}
                                                    <span class="badge-origin dev" title="Paquet absent du rapport de production : utilisé uniquement en développement.">Dev</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center v-middle" title="Score CVSS le plus élevé parmi les avis de sécurité de ce paquet.">
                                                {{ p.cvss_max is not null ? p.cvss_max : '-' }}
                                            </td>
                                            <td class="text-center v-middle" title="Nombre de catégories CWE distinctes cumulées sur ce paquet.">
                                                {% if p.cwe_count > 0 %}
                                                    <span class="badge-cve">{{ p.cwe_count }}</span>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="cell small-12 medium-5 text-justify">
                        {{ _self.info_callout(
                            'Ce tableau liste les <strong>' ~ package_summary|length ~ ' paquet(s)</strong> ayant au moins un avis de sécurité réel, qui cumulent <strong>' ~ findings|length ~ ' avis distincts</strong> ci-dessous (un même paquet peut en avoir plusieurs). <br>'
                            ~ (scan.vulnCountTotal != package_summary|length
                                ? (' npm audit annonce par ailleurs <strong>' ~ scan.vulnCountTotal ~ ' paquet(s)</strong> dans ses propres statistiques (tuiles et badges ci-dessus) : ce total peut inclure un paquet signalé uniquement par propagation depuis une dépendance vulnérable, sans aucun avis qui lui soit propre — c\'est le cas ici.')
                                : '')
                        ) }}
                    </div>
                </div>
            {% endif %}

            <h3 class="h5 claire-hand"><span aria-hidden="true">🔎</span> Détail par avis de sécurité ({{ findings|length }})</h3>
            {% if findings is empty %}
                <p class="open-sans">Aucune vulnérabilité détectée.</p>
            {% else %}
                {% set severities = [
                    { key: 'critical', label: 'Vulnérabilités CRITICAL', badge: 'critical' },
                    { key: 'high',     label: 'Vulnérabilités HIGH',     badge: 'high' },
                    { key: 'moderate', label: 'Vulnérabilités MODERATE', badge: 'moderate' },
                    { key: 'low',      label: 'Vulnérabilités LOW',      badge: 'low' },
                    { key: 'info',     label: 'Vulnérabilités INFO',     badge: 'info' },
                ] %}

                {% for sev in severities %}
                    {% set sev_findings = findings|filter(f => f.severity == sev.key) %}
                    {% if sev_findings|length > 0 %}
                        <h4 class="h5 claire-hand margin-top-1">
                            {{ sev.label }}
                            <span class="badge-count {{ sev.badge }}">{{ sev_findings|length }}</span>
                        </h4>
                        <div class="cell table-scroll">
                            <table class="open-sans v-middle">
                                <thead>
                                    <tr>
                                        <th>Paquet</th>
                                        <th class="text-center">Type</th>
                                        <th class="text-center">Origine</th>
                                        <th class="text-center">CVSS</th>
                                        <th>Advisory</th>
                                        <th>Plage vulnérable</th>
                                        <th class="text-center">Correctif</th>
                                        <th>CWE</th>
                                        <th>Titre</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for f in sev_findings %}
                                        <tr class="v-middle">
                                            <td class="v-middle"><strong>{{ f.dependency_name }}</strong></td>
                                            <td class="text-center v-middle">
                                                {% if f.is_direct %}
                                                    <span class="badge-cve" title="Dépendance directe de votre package.json">Direct</span>
                                                {% else %}
                                                    <span class="badge-cve" title="Dépendance transitive (introduite par une autre dépendance)">Transitif</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center v-middle">
                                                {% if f.is_prod is null %}
                                                    <span class="badge-origin unknown" title="Rapport « prodOnly » absent de l'upload : impossible de déterminer si ce paquet est utilisé en production.">Indéterminé</span>
                                                {% elseif f.is_prod %}
                                                    <span class="badge-origin prod" title="Paquet présent dans le rapport de production (npm audit --omit=dev).">Production</span>
                                                {% else %}
                                                    <span class="badge-origin dev" title="Paquet absent du rapport de production : utilisé uniquement en développement.">Dev</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center v-middle">{{ f.cvss is not null ? f.cvss : '-' }}</td>
                                            <td class="v-middle">
                                                {% if f.url %}
                                                    <a href="{{ f.url }}" target="_blank" rel="noopener noreferrer">{{ f.advisory_id }}</a>
                                                {% else %}
                                                    {{ f.advisory_id }}
                                                {% endif %}
                                            </td>
                                            <td class="v-middle" title="Plage de version vulnérable constatée au scan — pas la version installée exacte, npm audit ne la restitue pas de façon fiable.">
                                                {{ f.range ?: '-' }}
                                                {% if f.installed_version %}
                                                    <br>
                                                    <small class="text-muted" title="Version réellement installée, résolue depuis le rapport complémentaire « installed » (npm ls --all --json) fourni par la CI.">
                                                        Installée : {{ f.installed_version }}
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td class="text-center v-middle">
                                                {% if f.fix_available %}
                                                    <span class="badge-level neutre" title="{{ f.fix_to_version ? 'Mise à jour vers ' ~ f.fix_to_version ~ (f.fix_is_semver_major ? ' (changement majeur)' : '') : 'Correctif disponible' }}">Oui</span>
                                                {% else %}
                                                    <span class="text-muted">Non</span>
                                                {% endif %}
                                            </td>
                                            <td class="v-middle">
                                                {% for cwe in f.cwes %}
                                                    <span class="badge-cve">{{ cwe }}</span>
                                                {% endfor %}
                                            </td>
                                            <td class="v-middle">
                                                {{ f.title|slice(0, 200) }}
                                                {% if f.title|length > 200 %}
                                                    …
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
            <div class="margin-bottom-4" aria-hidden="true">&nbsp;</div>
        </main>

        {% macro info_callout(text) %}
        <div class="callout alert-callout-border info margin-bottom-1 clear-both">
            <p class="open-sans font-size-085 margin-bottom-0">
                <span aria-hidden="true">ℹ️</span> {{ text|raw }}
            </p>
        </div>
        {% endmacro %}

        {{ include('footer.html.twig') }}
    </body>

</html>

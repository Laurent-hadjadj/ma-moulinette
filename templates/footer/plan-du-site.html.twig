<html	lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement du code javascript #}
    {% block importmap %}{{ importmap('footer-plan-du-site') }}{% endblock %}
  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}
    <br>

    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}" alt="">Accueil</a></li>
          <li><span class="show-for-sr">Vous êtes sur la page :</span>Plan-du-site</li>
        </ol>
      </nav>
    </header>

    <main class="grid-container grid-x">
      <div class="grid-x">
        <h1 class="h5 claire-hand cell">Légende</h1>
        <ul class="open-sans">
          <li class="marqueur-circle color-bleu">Indique un lien vers une page.</li>
          <li class="marqueur-square color-bleu">Indique une action (ouvrir une page, lancer une action).</li>
          <li class="marqueur-no-bullet color-bleu">
            <img class="cadenas" src="{{ asset('images/lock-bleu-32x32.min.svg') }}" alt="cadenas">
            La page nécessite une identification.
          </li>
        </ul>
      </div>

      <div class="timeline">
        {# Authentification #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">Authentification</p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('accueil', {}) }}">Se connecter</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('register', {}) }}">S'inscrire</a>
              </li>
            </ul>
          </div>
        </div>

        {# Menu #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">
              <img class="cadenas" src="{{ asset('images/lock-blanc-32x32.min.svg') }}" alt="cadenas">
              Menu principal
            </p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-circle">
                <a href="/admin?menuIndex=2&submenuIndex=-1">Gestion des utilisateurs.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('suivi', {}) }}">Gestion des batch.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="/admin?menuIndex=1&submenuIndex=-1">Informations.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('preferences', {}) }}">Mes préférences.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('logout', {}) }}">Se déconnecter.</a>
              </li>
            </ul>
          </div>
        </div>

        {# Accueil #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">
              <img class="cadenas" src="{{ asset('images/lock-blanc-32x32.min.svg') }}" alt="cadenas">Accueil</p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-square">Mise à jour de la liste des projets.</li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('profil', {}) }}">Liste des profils SonarQube.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('projet', {}) }}">Mon projet</a>
              </li>
            </ul>
          </div>
        </div>

        {# Profils #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">
              <img class="cadenas" src="{{ asset('images/lock-blanc-32x32.min.svg') }}" alt="cadenas">Liste des profils SonarQube.</p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-square">Mise à jour de la table.</li>
              <li class="timeline-content-link marqueur-square">Répartition des langages.</li>
            </ul>
          </div>
        </div>

        {# Projet #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">
              <img class="cadenas" src="{{ asset('images/lock-blanc-32x32.min.svg') }}" alt="cadenas">Mon Projet</p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-square">Collecte des données.</li>
              <li class="timeline-content-link marqueur-square">Afficher les résultats.</li>
              <li class="timeline-content-link marqueur-square">Afficher ma liste de projets.</li>
              <li class="timeline-content-link marqueur-square">Enregistrer les données collectées.</li>
              <li class="timeline-content-link marqueur-square">Lancer une analyse OWASP de mon projet.</li>
              <li class="timeline-content-link marqueur-square">Afficher la répartition des indicateurs par module.</li>
              <li class="timeline-content-link marqueur-square">Afficher le tableau de bord du COSUI.</li>
              <li class="timeline-content-link marqueur-square">Afficher les tableaux de suivi de mon projet.</li>
            </ul>
          </div>
        </div>

        {# bas de page #}
        <div class="timeline-item">
          <div class="timeline-icon">
            <img class="lien" src="{{ asset('images/link-32x32.min.svg') }}" alt="lien">
          </div>
          <div class="timeline-content">
            <p class="open-sans timeline-content-titre">Bas de page</p>
            <ul class="open-sans timeline-content-liste">
              <li class="timeline-content-link marqueur-circle">
                <a href="{{ path('plan_du_site', {}) }}">Plan du site.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{ path('accessibilite', {}) }}">Accessibilité</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{ path('cgu', {}) }}">Mentions légales.</a>
              </li>
              <li class="timeline-content-link marqueur-circle">
                <a href="{ path('rgpd', {}) }}">Données personnelles.</a>
              </li>
            </ul>
          </div>
        </div>

        {# Fin du bloc #}
      </div>
    </main>
    <br>
    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

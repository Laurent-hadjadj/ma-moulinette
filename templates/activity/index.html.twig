{# MODIF 2026-09-14 : Suppression de 2 </div> (spinner) #}
{% set title = 'Activité' %}
{% set description = 'Ma Moulinette - Suivi des analyses SonarQube.' %}
{% set bottom = "footer-fixed" %}

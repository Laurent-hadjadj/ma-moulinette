<html lang="fr">
    {# Chargement de la section HEAD #}
    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {# Chargement des assets JS et CSS #}
        {% block importmap %}
            {{ importmap('activity') }}
        {% endblock %}

    </head>

    <body>
        {# Chargement de la section header #}
        {{ include('header.html.twig') }}
        <br>
        <header class="grid-container margin-top-1">
            <nav id="fil-ariane" aria-label="vous êtes ici :">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li><span class="show-for-sr">vous êtes ici :</span>Activité</li>
                </ol>
            </nav>
        </header>

        {# Message d'information php #}
        {{ include('_message.html.twig') }}

        <main class="grid-container">
            <h1 class="h2 claire-hand">Suivi des analyses SonarQube</h1>
            <h2 class="claire-hand h4">Tableau de bord consolidé. </h2>

            <p id="js-date-enregistrement" class="h4 open-sans">
                <strong>Dernière date d'enregistrement : </strong> {{ data[0]['date_enregistrement'] }}
            </p>

            <div class="grid-x grid-margin-x align-right margin-top-2">
                <div class="cell shrink">
                    <a id="bouton-ouvrir-rapport-activity-pdf"
                        href="{{ path('activity_rapport_pdf') }}"
                        target="_blank"
                        class="button open-sans focus-dark-light"
                        title="Exporter le rapport Activité au format PDF (90 derniers jours)"
                        aria-label="Export PDF">
                        <span aria-hidden="true">📄</span> Export PDF
                    </a>
                </div>
                <div class="cell shrink">
                    <button
                        id="bouton-activity-refresh"
                        class="button open-sans focus-dark-light js-activity-refresh"
                        type="button"
                        aria-label="Recalcule les statistiques d'activité."
                    ><span aria-hidden="true">🔄</span>
                        <span class="show-for-medium open-sans color-blanc">&nbsp;Recalculer les statistiques.</span>
                        <span class="show-for-small-only open-sans color-blanc">&nbsp;Recalculer.</span>
                    </button>
                </div>
            </div>
            <div class="spinner js-spinner" style="display: none;"></div>

            <table class="hover">
                <thead>
                    <tr>
                        <th class="text-center open-sans">
                            <div class="tool-tip-activity"><span class="tool-tip-activity-text-top">L'année des analyses.</span>Année</div>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity"><span class="tool-tip-activity-text-top">Le nombre de jours depuis la première analyse.</span>Jour</span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Analyse
                                <span class="tool-tip-activity-text-top">Le nombre total d'analyses.</span></span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Moyenne
                                <span class="tool-tip-activity-text-top">La moyenne des analyses par jour.</span></span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Succès
                                <span class="tool-tip-activity-text-top">Le nombre d'analyse réussi.</span></span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Échec
                                <span class="tool-tip-activity-text-top">Le nombre d'analyse échoué.</span></span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Taux de réussite
                                <span class="tool-tip-activity-text-top">Le pourcentage de réussite.</span></span>
                        </th>
                        <th class="text-center open-sans">
                            <span class="tool-tip-activity">Temp Max
                                <span class="tool-tip-activity-text-top">Le temps maximum pour une analyse.</span></span>
                        </th>
                    </tr>
                </thead>
                <tbody id="js-tableau-stats" class="text-center open-sans">
                    {% for item in data %}
                        <tr>
                            <td>{{ item.year }}</td>
                            <td>{{ item.day }}</td>
                            <td>{{ item.analyse }}</td>
                            <td>{{ item.analyse_average }}</td>
                            <td>{{ item.success }}</td>
                            <td>{{ item.failed }}</td>
                            <td>{{ item.success_rate }} %</td>
                            <td>{{ item.max_time }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# MODIF 2026-10-16 : KPI sur les 90 derniers jours (même période
                que le rapport PDF) — lecture locale, affiché même si
                SonarQube est injoignable. #}
            <h2 class="claire-hand h4 margin-top-2">Indicateurs clés (90 derniers jours)</h2>
            <ul class="stats-list">
                <li>
                    <span class="stats-kpi">{{ kpi_total_analyses|default(0) }}</span>
                    <span class="stats-list-label">Analyses totales</span>
                </li>
                <li>
                    <span class="stats-kpi">{{ kpi_total_projets|default(0) }}</span>
                    <span class="stats-list-label">Projets analysés</span>
                </li>
                <li>
                    <span class="stats-kpi">{{ kpi_moyenne_jour|default(0) }}</span>
                    <span class="stats-list-label">Moyenne / jour</span>
                </li>
                <li>
                    <span class="stats-kpi">{{ kpi_jour_pic.analyse|default(0) }}</span>
                    <span class="stats-list-label">Jour de pointe ({{ kpi_jour_pic.date|default('—') }})</span>
                </li>
            </ul>

            {# MODIF 2026-10-16 : un seul graphique (analyses + projets), plus
                de boutons redondants pour chaque métrique prise isolément —
                elles sont toutes les deux déjà dans cette vue combinée.
                Remplissage d'aire (meme pattern que les 2 graphiques de la
                page Statistique Utilisateur). Tracé automatiquement au
                chargement, pas besoin de clic. #}
            <h2 class="claire-hand h4 margin-top-2">Évolution annuelle</h2>
            <div class="chart-container-annuelle">
                <canvas id="graphique-langage" aria-label="Analyses et projets analysés par jour sur l'année."></canvas>
            </div>
            <div class="chart-empty-message js-chart-empty-message">Aucune donnée à tracer pour l'année en cours.</div>

            {# MODIF 2026-10-16 : tableaux semaine / mois / top10, même pattern
                que les tableaux OS/Navigateur/Appareil de la page Statistique
                Utilisateur (stats-card), rendu serveur, pas d'AJAX. #}
            <div class="grid-x grid-margin-x margin-bottom-4">
                <div class="cell small-12 medium-6">
                    <div class="stats-card">
                        <h3 class="h5 claire-hand">Cette semaine (lundi → aujourd'hui)</h3>
                        {% if semaine_table|default([])|length > 0 %}
                            <table class="stats-table">
                                <thead>
                                    <tr><th>Jour</th><th class="text-right">Analyses</th><th class="text-right">Projets</th><th>Part des projets</th></tr>
                                </thead>
                                <tbody>
                                    {% for j in semaine_table %}
                                        <tr>
                                            <td>{{ j.jour }}</td>
                                            <td class="text-right">{{ j.analyse }}</td>
                                            <td class="text-right">{{ j.projet }}</td>
                                            <td class="stats-percent-cell">
                                                <span class="open-sans stats-percent-value">{{ j.percent }}%</span>
                                                <span class="stats-percent-bar" aria-hidden="true" style="--percent: {{ j.percent }}"></span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="open-sans">Aucune analyse cette semaine.</p>
                        {% endif %}
                    </div>
                </div>
                <div class="cell small-12 medium-6">
                    <div class="stats-card">
                        <h3 class="h5 claire-hand">Ce mois (par semaine)</h3>
                        {% if mois_table|default([])|length > 0 %}
                            <table class="stats-table">
                                <thead>
                                    <tr><th>Semaine</th><th class="text-right">Analyses</th><th class="text-right">Projets (max/jour)</th><th>Part des projets</th></tr>
                                </thead>
                                <tbody>
                                    {% for s in mois_table %}
                                        <tr>
                                            <td>{{ s.semaine }}</td>
                                            <td class="text-right">{{ s.analyse }}</td>
                                            <td class="text-right">{{ s.projet_max }}</td>
                                            <td class="stats-percent-cell">
                                                <span class="open-sans stats-percent-value">{{ s.percent }}%</span>
                                                <span class="stats-percent-bar" aria-hidden="true" style="--percent: {{ s.percent }}"></span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="open-sans">Aucune analyse ce mois-ci.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="grid-x grid-margin-x margin-bottom-4">
                <div class="cell small-12 medium-4">
                    <div class="stats-card">
                        <h3 class="h5 claire-hand">Top 10 des pics d'analyse</h3>
                        {% if top10_pics|default([])|length > 0 %}
                            <table class="stats-table">
                                <thead>
                                    <tr><th>Date</th><th class="text-right">Analyses</th><th class="text-right">Projets</th></tr>
                                </thead>
                                <tbody>
                                    {% for p in top10_pics %}
                                        <tr><td>{{ p.date }}</td><td class="text-right">{{ p.analyse }}</td><td class="text-right">{{ p.projet }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="open-sans">Pas assez de données.</p>
                        {% endif %}
                    </div>
                </div>
                <div class="cell small-12 medium-4">
                    <div class="stats-card">
                        <h3 class="h5 claire-hand">Top 10 projets — semaine en cours</h3>
                        {% if top10_projets_semaine|default([])|length > 0 %}
                            <table class="stats-table">
                                <thead>
                                    <tr><th>Projet</th><th class="text-right">Analyses</th></tr>
                                </thead>
                                <tbody>
                                    {% for p in top10_projets_semaine %}
                                        <tr><td>{{ p.project_name }}</td><td class="text-right">{{ p.analyse }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="open-sans">Aucune analyse cette semaine.</p>
                        {% endif %}
                    </div>
                </div>
                <div class="cell small-12 medium-4">
                    <div class="stats-card">
                        <h3 class="h5 claire-hand">Top 10 projets — mois en cours</h3>
                        {% if top10_projets_mois|default([])|length > 0 %}
                            <table class="stats-table">
                                <thead>
                                    <tr><th>Projet</th><th class="text-right">Analyses</th></tr>
                                </thead>
                                <tbody>
                                    {% for p in top10_projets_mois %}
                                        <tr><td>{{ p.project_name }}</td><td class="text-right">{{ p.analyse }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="open-sans">Aucune analyse ce mois-ci.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

        </main>

        {# Chargement de la section footer #}
        {{ include('footer.html.twig') }}
    </body>
</html>

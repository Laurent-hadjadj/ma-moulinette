<html	lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('activity') }}{% endblock %}

  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}
    <br>
    <header class="grid-container margin-top-1">
      {# WCAG 2.4.8 : indication "vous êtes ici" portée par aria-label ; aria-current="page" sur l'élément courant #}
      <nav id="fil-ariane" aria-label="Fil d'Ariane, vous êtes ici">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li aria-current="page">Activité</li>
        </ol>
      </nav>
    </header>

    {# Message d'information php #}
    {{ include('_message.html.twig') }}

    {# WCAG 2.4.1 : ajout de id="main-content" (cible du skip link du header) #}
    <main id="main-content" class="grid-container">
      {# WCAG 1.3.1 / 2.4.6 : un seul <h1> par page (header "Ma-Moulinette") ; descente d'un niveau pour les titres de section #}
      <h2 class="h2 claire-hand">Suivi des analyses SonarQube</h2>
      <h3 class="claire-hand h4">Tableau de bord consolidé. </h3>

      <p id="js-date-enregistrement" class="h4 open-sans">
          <strong>Dernière date d'enregistrement : </strong> {{data[0]['date_enregistrement']}}
      </p>

      <div class="grid-x grid-padding-x">
        <div class="cell small-12 medium-6 large-6">
          <button class="button expanded float-center bouton-activity-refresh js-activity-refresh" aria-label="Met à jour la liste.">
            <span class="show-for-medium open-sans color-blanc">Mise à jour de la liste.</span>
            <span class="show-for-small-only open-sans color-blanc">Mise à jour.</span>
          </button>
          <div class="spinner js-spinner" style="display: none;"></div>
        </div>
        <div class="small-12 medium-6 large-6 cell">
          <button class="button expanded float-center bouton-activity-du-jour" aria-label="Affiche les données du jour.">
            <span class="show-for-medium open-sans color-blanc">Affiche les données du jour.</span>
            <span class="show-for-small-only open-sans color-blanc">Données du jour.</span>
          </button>
        </div>
      </div>
      <br>
      <table class="hover">
        <thead>
          <tr>
            <th class="text-center open-sans">
              <span class="tool-tip-activity"><span class="tool-tip-activity-text-top">L'année des analyses.</span>Année</span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity"><span class="tool-tip-activity-text-top">Le nombre de jours depuis la première analyse.</span>Jour</span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Analyse
              <span class="tool-tip-activity-text-top">Le nombre total d'analyses.</span></span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Moyenne
              <span class="tool-tip-activity-text-top">La moyenne des analyses par jour.</span></span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Succès
              <span class="tool-tip-activity-text-top">Le nombre d'analyse réussi.</span></span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Échec
              <span class="tool-tip-activity-text-top">Le nombre d'analyse échoué.</span></span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Taux de réussite
              <span class="tool-tip-activity-text-top">Le pourcentage de réussite.</span></span>
            </th>
            <th class="text-center open-sans">
              <span class="tool-tip-activity">Temp Max
              <span class="tool-tip-activity-text-top">Le temps maximum pour une analyse.</span></span>
            </th>
          </tr>
        </thead>
        <tbody id="js-tableau-stats" class="text-center open-sans">
          {% for item in data %}
            <tr>
              <td>{{ item.year }}</td>
              <td>{{ item.day }}</td>
              <td>{{ item.analyse }}</td>
              <td>{{ item.analyse_average }}</td>
              <td>{{ item.success }}</td>
              <td>{{ item.fail }}</td>
              <td>{{ item.success_rate }} %</td>
              <td>{{ item.max_time }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="grid-x grid-padding-x">
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph" data-type="line" data-source="analyse" id="courbe_analyse">Courbes des analyses</p>
        </div>
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph" data-type="line" data-source="projet" id="courbe_projet">Courbes des projets</p>
        </div>
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph open-sans" data-type="line" data-source="projet_analyse" id="courbe_analyse_projet">Courbe des analyses et des projets</p>
        </div>
      </div>

      <div class="float-center graphique-langage-container">
        <canvas id="graphique-langage" aria-label="Distribution des langages."></canvas>
      </div>

    </main>

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

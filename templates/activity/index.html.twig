<html	lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('activity') }}{% endblock %}

  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}
    <br>
    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><span class="show-for-sr">vous êtes ici :</span>Activité</li>
        </ol>
      </nav>
    </header>

    <main class="grid-container rid-x rid-padding-x">
      <h1 class="h2 claire-hand">Suivi des analyses SonarQube</h1>
      <div class="grid-container grid-x" role="alert" aria-label="messages d'information">
        {% for message in app.flashes('notice') %}
          <div class="callout alert-callout-border js-message {{message.type}}" role="alert">
            <span class="open-sans color-bleu">
              <strong>{{message.titre}}</strong>
              {{ message.message }}
            </span>
          </div>
        {% endfor %}
      </div>
      <h2 id="js-date-enregistrement" class="h4 open-sans">
          <strong>Dernière date d'enregistrement : </strong> {{data.0.date_enregistrement}}
      </h2>
      {# Message d'information javascript #}
      <div id="message" class="cell"></div>
      <div class="cell small-12 medium-6 large-6">
        <p class="button expanded float-center bouton-activity-refresh js-activity-refresh">
          <span class="show-for-medium open-sans color-blanc">Mise à jour de la liste</span>
          <span class="show-for-small-only open-sans color-blanc">Mise à jour</span>
        </p>
      </div>
      {#to.do faire le js et l'api pour le bouton#}
      <div class="cell small-12 medium-6 large-6">
        <p class="button expanded float-center bouton-activity-du-jour ">
          <span class="show-for-medium open-sans color-blanc">Affiche les données du jour.</span>
          <span class="show-for-small-only open-sans color-blanc">Données du jour.</span>
        </p>
      </div>
      <table class="hover">
        <thead>
          <tr>
            <th class="text-center open-sans">Année
              <span class="tooltip-icon" title="L'année de l'activité">?</span>
            </th>
            <th class="text-center open-sans">Jour
              <span class="tooltip-icon" title="Le nombre de jours depuis la première analyse">?</span>
            </th>
            <th class="text-center open-sans">Analyses
              <span class="tooltip-icon" title="Le nombre total d'analyses">?</span>
            </th>
            <th class="text-center open-sans">Moyenne
              <span class="tooltip-icon" title="La moyenne des analyses par jour">?</span>
            </th>
            <th class="text-center open-sans">Réussite
              <span class="tooltip-icon" title="Le nombre d'analyse réussites">?</span>
            </th>
            <th class="text-center open-sans">Échec
              <span class="tooltip-icon" title="Le nombre d'analyse échoué">?</span>
            </th>
            <th class="text-center open-sans">Taux de réussite
              <span class="tooltip-icon" title="Le pourcentage de réussite">?</span>
            </th>
            <th class="text-center open-sans">Temps Max
              <span class="tooltip-icon" title="Le temps maximum pour une analyse">?</span>
            </th>
          </tr>
        </thead>
        <tbody id="js-tableau-stats" class="text-center open-sans">
          {% for activite in data %}
            <tr>
              <td>{{ activite.year }}</td>
              <td>{{ activite.day }}</td>
              <td>{{ activite.analyse }}</td>
              <td>{{ activite.analyse_average }}</td>
              <td>{{ activite.success }}</td>
              <td>{{ activite.fail }}</td>
              <td>{{ activite.success_rate }}
                %</td>
              <td>{{ activite.max_time }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="grid-x grid-padding-x">
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph" data-type="line" data-source="analyse" id="courbe_analyse">Courbes des analyses</p>
        </div>
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph" data-type="line" data-source="projet" id="courbe_projet">Courbes des projets</p>
        </div>
        <div class="cell small-12 medium-4">
          <p class="button expanded bouton-activity-graph js-show-graph open-sans" data-type="line" data-source="projet_analyse" id="courbe_analyse_projet">Courbe des analyses et des projets</p>
        </div>
      </div>

      <div class="float-center graphique-langage-container">
        <canvas id="graphique-langage" aria-label="Distribution des langages."></canvas>
      </div>

    </main>

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

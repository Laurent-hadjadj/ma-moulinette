    {# Gestion des messages flash & JS #}
    <section>
      {% for message in app.flashes('notice') %}
      <div  class="callout alert-callout {{ message.type }} alert-callout-border callout-ombre js-flash-box"
            role="alert"
            data-closable>
        <p class="open-sans text-justify callout-message">{{ message.message }}</p>
        {% if app.environment == 'dev' and message.debug is defined %}
        <p class"open-sans">{{message.debug}}</p>
        {% endif %}

        <button class="close-button {{message.type}}"
                type="button"
                aria-label="Dismiss alert"
                data-close>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      {% endfor %}

      {# Message d'information JS#}
      <div  id="message-box"
            class="callout alert-callout alert-callout-border callout-ombre hide"
            role="alert" data-closable>
          <button id="message-button-close"
                  class="close-button" aria-label="Close alert" type="button" data-close>
            <span aria-hidden="true">&times;</span>
          </button>
          <p id="message-text"></p>
      </div>
    </section>

<div id="modal-liste-logger" class="reveal" data-reveal data-close-on-click="true" data-animation-in="fade-in" data-animation-out="fade-out" aria-modal="true">
      <h1 class="h2 claire-hand">Loggers.</h1>
      <h2 class="h4 claire-hand">
        <span id="js-logger-total">N.C</span>
        Logger Java trouvé(s).</h2>
      <table>
        <caption class="claire-hand">Répartition des Loggers par méthode.</caption>
        <thead>
          <tr>
            <th scope="col" class="open-sans text-center">Méthode</th>
            <th scope="col" class="open-sans text-center">Nombre</th>
          </tr>
        </thead>
        <tbody id="tableau-liste-logger" class="open-sans">
          <tr>
            <td><strong>info</strong></td>
            <td id="js-logger-info" class="text-right stat">--</td>
          </tr>
          <tr>
            <td><strong>warn</strong></td>
            <td id="js-logger-warn" class="text-right stat">--</td>
          </tr>
          <tr>
            <td><strong>error</strong></td>
            <td id="js-logger-error" class="text-right stat">--</td>
          </tr>
          <tr>
            <td><strong>debug</strong></td>
            <td id="js-logger-debug" class="text-right stat">--</td>
          </tr>
        </tbody>
      </table>
      <br><br>
      {# fermeture de la fenêtre modale #}
      <button id="fermer-liste-logger" class="expanded button open-sans" data-close aria-label="Close reveal" type="button">Fermer</button>
    </div>

<dialog id="modal-affiche-liste-logger"
        class="reveal small"
        data-close-on-click="true"
        data-animation-in="fade-in"
        data-animation-out="fade-out"
        data-reveal
        aria-modal="true"
        aria-labelledby="titre-affiche-liste-logger"
        aria-describedby="desc-affiche-liste-logger">

  <header>
    <h1 id="titre-affiche-liste-logger" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h1>
    <h2 id="desc-affiche-liste-logger" class="h4 claire-hand"><span aria-hidden="true">📋</span>Répartition des loggers JAVA</h2>
    <span class="show-for-sr">
      Cette page présente la répartition des loggers pour les applications JAVA.
    </span>
  </header>

    <p class="open-sans font-size-1">
      <span id="js-logger-total">--</span> Logger Java trouvé <span class="s"></span>
    </p>

  <table>
    <caption class="claire-hand">Répartition des Loggers JAVA par type.</caption>
    <thead>
      <tr>
        <th scope="col" class="open-sans text-center">Méthode</th>
        <th scope="col" class="open-sans text-center">Nombre</th>
      </tr>
    </thead>
    <tbody id="tableau-liste-logger" class="open-sans">
      <tr>
        <td><strong>info</strong></td>
        <td id="js-logger-info" class="text-right stat">--</td>
      </tr>
      <tr>
        <td><strong>warn</strong></td>
        <td id="js-logger-warn" class="text-right stat">--</td>
      </tr>
      <tr>
        <td><strong>error</strong></td>
        <td id="js-logger-error" class="text-right stat">--</td>
      </tr>
      <tr>
        <td><strong>debug</strong></td>
        <td id="js-logger-debug" class="text-right stat">--</td>
      </tr>
    </tbody>
  </table>
  <footer class="grid-x grid-margin-x align-right margin-top-2">
    <div class="cell shrink">
      <button id="bouton-fermer-liste-logger" data-close
              class="button open-sans focus-light"
              type="button"
              aria-label="Ferme modale">❌ Fermer
      </button>
  </footer>
</dialog>

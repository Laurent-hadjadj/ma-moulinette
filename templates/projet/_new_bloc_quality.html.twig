        <span class="ligne-label" title="Note de maintenabilité (SQALE) de A à E">Maintenabilité&nbsp;:</span>
        <span id="js-note-sqale"></span>
      </div>
    </div>
  </div>

  <div class="callout callout-information small-12 medium-6 large-3 cell">
    <div class="callout-body">
      <h2 class="h4 claire-hand container-information no-select"><span aria-hidden="true">🐞</span>&nbsp;Répartition</h2>
    </div>

    <div class="callout-footer open-sans">
      {# REPARTITION PAR SEVERITY #}
      <div class="container-ligne">
        <span class="ligne-gauche">
          <span class="ligne-label" title="Nombre de violations à corriger (bugs, vulnérabilités, mauvaises pratiques)">Violations&nbsp;:</span>

              </svg>
          </button>
        </span>
          <span id="js-violations" class="stat-projet color-noir" title="Nombre total de violations"></span>
      </div>

      <div class="container-ligne margin-top-07">
        <span class="ligne-label" title="Nombre de bugs (fiabilité)">Fiabilité&nbsp;:</span>
        <span class="ligne-droite">
          <span id="js-nombre-bug-real" class="stat-projet font-size-1"
            title="Nombre de bugs (critiques, majeures, mineures)"></span>
          <span id="js-separator-bug" class="stat-projet"></span>
          <span id="js-nombre-bug-total" class="stat-projet color-noir" title="Nombre de bugs total"></span>
        </span>
      </div>
      <div class="container-ligne">
        <span class="ligne-label" title="Nombre de vulnérabilités">Sécurité&nbsp;:</span>
        <span id="js-nombre-vulnerability" class="stat-projet color-noir" title="Nombre total de vulnérabilités"></span>
      </div>
      <div class="container-ligne">
        <span class="ligne-label" title="Nombre de mauvaises pratiques">Maintenabilité&nbsp;:</span>
        <span class="ligne-droite">
          <span id="js-nombre-mauvaise-pratique-real" class="stat-projet color-noir"
            title="Nombre de mauvaises pratiques (critiques, majeures, mineures)"></span>
          <span id="js-separator-code-smell" class="stat-projet"></span>
          <span id="js-nombre-mauvaise-pratique" class="stat-projet color-noir"
            title="Nombre de mauvaises pratiques total"></span>
        </span>
      </div>

    {# Domaine : Empreinte écologique #}
    <div class="callout callout-information small-12 medium-4 large-4 cell">
        <div class="callout-body">
            <h2 class="h4 claire-hand container-information no-select"><span aria-hidden="true">🪴</span>&nbsp;Empreinte</h2>
        </div>

        <div class="callout-footer open-sans">
            {# EcoConcept#}
            <div class="container-ligne open-sans margin-top-05">
                <span class="ligne-label" title="Nombre d'anomalies éco-conception (OPEN) détectées par les plugins SonarQube Creedengo (Java/JavaScript/PHP/Python)">EcoConcept&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-eco-anomalies" class="stat-projet color-noir" title="Nombre total d'anomalies éco-conception ouvertes"></span>
                    <span id="js-eco-rating"></span>
                </span>
            </div>
        </div>
    </div>

    {# MODIF 26/10/2026 : Domaine Accessibilité (tag SonarQube `accessibility`,
    css/web/javascript/typescript — pas de facette WCAG officielle). #}
    <div class="callout callout-information small-12 medium-4 large-4 cell">
        <div class="callout-body">
            <h2 class="h4 claire-hand container-information no-select"><span aria-hidden="true">♿</span>&nbsp;Accessibilité</h2>
        </div>

        <div class="callout-footer open-sans margin-bottom-07">
            <div class="container-ligne open-sans margin-top-05">
                <span class="ligne-label" title="Nombre d'anomalies accessibilité (OPEN) détectées par le tag SonarQube accessibility (CSS/Web/JavaScript/TypeScript)">Anomalies&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-accessibility-anomalies" class="stat-projet color-noir" title="Nombre total d'anomalies accessibilité ouvertes"></span>
                    <span id="js-accessibility-rating"></span>
                </span>
            </div>

            {# MODIF 27/10/2026 : détail par langage, affiché directement (pas de modale) — mêmes IDs que la présentation classique. #}
            <div class="container-ligne open-sans ligne-sous-detail margin-bottom-07">
                <span class="ligne-label" title="Nombre d'anomalies accessibilité (OPEN) pour le langage CSS">CSS&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-accessibility-css-anomalies" class="stat-projet color-noir" title="Nombre d'anomalies accessibilité ouvertes pour le langage CSS"></span>
                    <span id="js-accessibility-css-rating"></span>
                </span>
            </div>
            <div class="container-ligne open-sans ligne-sous-detail margin-bottom-07">
                <span class="ligne-label" title="Nombre d'anomalies accessibilité (OPEN) pour le langage Web (HTML)">HTML&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-accessibility-web-anomalies" class="stat-projet color-noir" title="Nombre d'anomalies accessibilité ouvertes pour le langage Web (HTML)"></span>
                    <span id="js-accessibility-web-rating"></span>
                </span>
            </div>
            <div class="container-ligne open-sans ligne-sous-detail margin-bottom-07">
                <span class="ligne-label" title="Nombre d'anomalies accessibilité (OPEN) pour le langage JavaScript">JavaScript&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-accessibility-javascript-anomalies" class="stat-projet color-noir" title="Nombre d'anomalies accessibilité ouvertes pour le langage JavaScript"></span>
                    <span id="js-accessibility-javascript-rating"></span>
                </span>
            </div>
            <div class="container-ligne open-sans ligne-sous-detail margin-bottom-07">
                <span class="ligne-label" title="Nombre d'anomalies accessibilité (OPEN) pour le langage TypeScript">TypeScript&nbsp;:</span>
                <span class="ligne-droite">
                    <span id="js-accessibility-typescript-anomalies" class="stat-projet color-noir" title="Nombre d'anomalies accessibilité ouvertes pour le langage TypeScript"></span>
                    <span id="js-accessibility-typescript-rating"></span>
                </span>
            </div>
        </div>
    </div>

</div>

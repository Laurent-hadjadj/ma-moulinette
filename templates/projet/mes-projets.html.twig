<html lang="fr">
    {# Chargement de la section HEAD #}
    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {# Chargement des assets JS et CSS #}
        {% block importmap %}
            {{ importmap('mes-projets') }}
        {% endblock %}
    </head>

    <body>
        {# Chargement de la section header #}
        {{ include('header.html.twig') }}
        {# On affiche les messages #}
        {{ include('_message.html.twig') }}

        <header class="grid-container margin-top-1">
            <nav aria-label="Fil d'Ariane, vous êtes ici">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li><a href="{{ path('projet', {}) }}">Projet</a></li>
                    <li aria-current="page">Mes-Projets</li>
                </ol>
            </nav>
        </header>

        <main id="main-content" class="margin-bottom-2">
            <div class="grid-container">
                <h2 class="h3 claire-hand"><span aria-hidden="true">🗂️</span>Mes Projets</h2>
                <h3 class="h4 claire-hand"><span aria-hidden="true">🚥</span>Suivi des principaux indicateurs.</h3>
            </div>

            <div class="table-scroll pleine-page">
                <table id="table-mes-projets" class="hover striped" aria-label="Métriques par projet">
                    <caption class="show-for-sr">Tableau récapitulatif des projets : application, version, lignes de code, notes SonarQube (fiabilité, sécurité, hotspots, maintenabilité), violations, composants, qualité du code, journalisation et tests.</caption>
                    <thead>
                        <tr
                        class="open-sans">
                        {# En-têtes avec les attributs scope #}
                        <th rowspan="1" scope="col" class="text-center">Application</th>
                        <th rowspan="1" scope="col" class="text-center">Version</th>
                        <th colspan="2" scope="colgroup" class="text-center">Lignes</th>
                        <th colspan="4" scope="colgroup" class="text-center">Notes</th>
                        <th colspan="4" scope="colgroup" class="text-center">Violations</th>
                        <th colspan="3" scope="colgroup" class="text-center">Composants</th>
                        <th colspan="3" scope="colgroup" class="text-center">Qualité du Code</th>
                        <th colspan="4" scope="colgroup" class="text-center">Loggers</th>
                        <th colspan="1" scope="col" class="text-center">Tests</th>
                        <th rowspan="1" scope="col" class="text-center">Application</th>
                    </tr>
                    <tr class="open-sans">
                        <th scope="col" class="text-center"></th>
                        <th scope="col" class="text-center"></th>
                        <th scope="col" class="text-center">Total</th>
                        <th scope="col" class="text-center">Code</th>
                        <th scope="col" class="text-center">Fiabilité</th>
                        <th scope="col" class="text-center">Sécurité</th>
                        <th scope="col" class="text-center">Hotspot</th>
                        <th scope="col" class="text-center">Maintenabilité</th>
                        <th scope="col" class="text-center">Fiabilité</th>
                        <th scope="col" class="text-center">Sécurité</th>
                        <th scope="col" class="text-center">Maintenabilité</th>
                        <th scope="col" class="text-center">Total</th>
                        <th scope="col" class="text-center">Front</th>
                        <th scope="col" class="text-center">Back</th>
                        <th scope="col" class="text-center">Autre</th>
                        <th scope="col" class="text-center">Supp. Warn.</th>
                        <th scope="col" class="text-center">NoSonar</th>
                        <th scope="col" class="text-center">Todo</th>
                        <th scope="col" class="text-center">Info</th>
                        <th scope="col" class="text-center">Warn</th>
                        <th scope="col" class="text-center">Error</th>
                        <th scope="col" class="text-center">Debug</th>
                        <th scope="col" class="text-center">Test</th>
                        <th scope="col" class="text-center"></th>
                    </tr>
                </thead>
                <tbody id="mon-bo-tableau" class="open-sans">
                    {% if liste_projet is not empty %}
                        {% for projet in liste_projet %}
                            <tr
                            class="open-sans">
                            {# Application et version #}
                            <td class="text-left">
                                <span>{{ projet['project_name'] }}</span>
                            </td>
                            <td class="text-left">
                                <span>{{ projet['version'] }}</span>
                            </td>

                            {# Lignes #}
                            <td class="text-right">
                                <span>{{ projet['nombre_ligne']|format_number(locale='fr') }}</span>
                            </td>
                            <td class="text-right">
                                <span>{{ projet['nombre_ligne_code']|format_number(locale='fr') }}</span>
                            </td>

                            {# Notes avec icônes et couleurs #}
                            <td class="text-center">
                                <span class="note note-{{ projet['note_reliability']|lower }}" aria-label="Fiabilité : note {{ note_labels[projet['note_reliability']] ?? projet['note_reliability'] }}">{{ projet['note_reliability'] }}</span>
                            </td>
                            <td class="text-center">
                                <span class="note note-{{ projet['note_security']|lower }}" aria-label="Sécurité : note {{ note_labels[projet['note_security']] ?? projet['note_security'] }}">{{ projet['note_security'] }}</span>
                            </td>
                            <td class="text-center">
                                <span class="note note-{{ projet['note_hotspot']|lower }}" aria-label="Hotspot : note {{ note_labels[projet['note_hotspot']] ?? projet['note_hotspot'] }}">{{ projet['note_hotspot'] }}</span>
                            </td>
                            <td class="text-center">
                                <span class="note note-{{ projet['note_sqale']|lower }}" aria-label="Maintenabilité : note {{ note_labels[projet['note_sqale']] ?? projet['note_sqale'] }}">{{ projet['note_sqale'] }}</span>
                            </td>

                            {# Violations avec formatage en fonction des valeurs #}
                            <td class="text-right">
                                <span class="{{ projet['nombre_bug'] > 0 ? 'label alert' : 'label success' }}" aria-label="{{ projet['nombre_bug'] > 0 ? projet['nombre_bug'] ~ ' bugs détectés' : 'Aucun bug' }}">{{ projet['nombre_bug']|format_number(locale='fr') }}</span>
                            </td>
                            <td class="text-right">
                                <span class="{{ projet['nombre_vulnerability'] > 0 ? 'label alert' : 'label success' }}" aria-label="{{ projet['nombre_vulnerability'] > 0 ? projet['nombre_vulnerability'] ~ ' vulnérabilités détectées' : 'Aucune vulnérabilité' }}">{{ projet['nombre_vulnerability']|format_number(locale='fr') }}</span>
                            </td>
                            <td class="text-right">
                                <span class="{{ projet['nombre_code_smell'] > 50 ? 'label warning' : 'label success' }}" aria-label="{{ projet['nombre_code_smell'] > 50 ? projet['nombre_code_smell'] ~ ' code smells (au-delà du seuil)' : projet['nombre_code_smell'] ~ ' code smells' }}">{{ projet['nombre_code_smell']|format_number(locale='fr') }}</span>
                            </td>
                            <td class="text-right">
                                <span>{{ projet['violations']|format_number(locale='fr') }}</span>
                            </td>

                            {# Composants #}
                            <td class="text-right">{{ projet['frontend']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['backend']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['autre']|format_number(locale='fr') }}</td>

                            {# Qualité du Code #}
                            <td class="text-right">{{ projet['suppress_warning']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['no_sonar']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['todo']|format_number(locale='fr') }}</td>

                            {# Loggers #}
                            <td class="text-right">{{ projet['logger_info']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['logger_warn']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['logger_error']|format_number(locale='fr') }}</td>
                            <td class="text-right">{{ projet['logger_debug']|format_number(locale='fr') }}</td>

                            {# Tests #}
                            <td class="text-right">{{ projet['tests']|format_number(locale='fr') }}</td>
                            {# Application et version #}
                            <td class="text-left">
                                <span>{{ projet['project_name'] }}</span>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</main>

{# Chargement de la section footer #}
{{ include('footer.html.twig') }}
</body>
</html>

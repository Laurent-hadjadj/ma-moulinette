{% set title = 'Mes projets' %}
{% set description = 'Ma liste de projets' %}
{% set bottom="footer-fixed" %}
{% set note_labels = {
    'A': 'A (excellent)',
    'B': 'B (bon)',
    'C': 'C (moyen)',
    'D': 'D (mauvais)',
    'E': 'E (critique)'
} %}
<!DOCTYPE html>

<dialog id="modal-affiche-violations-par-severity"
    class="reveal large" data-reveal
    aria-modal="true"
    data-close-on-click="true"
    data-animation-in="fade-in"
    data-animation-out="fade-out"
    aria-labelledby="titre-violation-severity"
    aria-describedby="desc-violation-severity">

    <h2 id="titre-violation-severity" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h2>
    <h3 id="desc-violation-severity" class="h4 claire-hand"><span aria-hidden="true">🎚️</span>Répartition des violations par sévérité</h3>
    <span class="show-for-sr">
        Cette page présente la liste des violations répartie par niveau de sévérité.
    </span>

    <table>
        <caption class="claire-hand">Répartition des violations par type et sévérité.</caption>
        <thead>
            <tr>
                <th scope="col" class="open-sans text-center">🟥Bloquant</th>
                <th scope="col" class="open-sans text-center">🟧Critique</th>
                <th scope="col" class="open-sans text-center">🟨Majeur</th>
                <th scope="col" class="open-sans text-center">🟩Mineur</th>
                <th scope="col" class="open-sans text-center">🟦Info</th>
            </tr>
        </thead>
        <tbody id="tableau-liste-violations" class="open-sans">
            <tr>
                <td id="js-nombre-violation-bloquant" class="text-center stat-projet color-noir">--</td>
                <td id="js-nombre-violation-critique" class="text-center stat-projet color-noir">--</td>
                <td id="js-nombre-violation-majeur" class="text-center stat-projet color-noir">--</td>
                <td id="js-nombre-violation-mineur" class="text-center stat-projet color-noir">--</td>
                <td id="js-nombre-violation-info" class="text-center stat-projet color-noir">--</td>
            </tr>
        </tbody>
    </table>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-liste-violations"
                class="button open-sans focus-dark-light"
                type="button"
                aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
                </button>
            </div>
        </footer>
    </dialog>

<div id="modal-liste-hotspot" class="reveal" data-reveal data-close-on-click="true" data-animation-in="fade-in" data-animation-out="fade-out" aria-modal="true">
      <h1 class="h2 claire-hand">Risques de vulnérabilité.</h1>
      <h2 class="h4 claire-hand">Hotspots à vérifier et déjà vérifiés.</h2>
      <p class="open-sans"><span id="hotspot-total"></span> trouvé<span id="s"></span> à vérifier.</p>
      <table>
        <caption class="claire-hand">Répartition des hotspots.</caption>
        <thead>
          <tr>
            <th scope="col" class="open-sans text-center note-rouge">HIGH</th>
            <th scope="col" class="open-sans text-center note-orange">MEDIUM</th>
            <th scope="col" class="open-sans text-center note-jaune">LOW</th>
          </tr>
        </thead>
        <tbody id="tableau-liste-hotspot" class="open-sans">
          <tr>
            <td>--</td>
            <td>--</td>
            <td>--</td>
          </tr>
        </tbody>
      </table>
      <br>
      {# fermeture de la fenêtre modale #}
      <button id="fermer-liste-hotspot" class="expanded button open-sans" data-close aria-label="Close reveal" type="button">Fermer</button>
    </div>

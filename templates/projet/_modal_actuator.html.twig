<dialog id="modal-affiche-actuator"
        class="reveal large" data-reveal
        aria-modal="true"
        data-close-on-click="true"
        data-animation-in="fade-in"
        data-animation-out="fade-out"
        aria-labelledby="titre-affiche-actuator"
        aria-describedby="desc-affiche-actuator">

  <header>
    <h2 id="titre-affiche-actuator" class="h3 claire-hand"><span aria-hidden="true">🌱</span>Actuator</h2>
    <h3 id="desc-affiche-actuator" class="h4 claire-hand"><span aria-hidden="true">📋</span>Informations collectées</h3>
    <span class="show-for-sr">
      Cette fenêtre présente les informations collectées depuis le point d'accès Actuator déclaré pour ce projet.
    </span>
  </header>

  <p id="js-actuator-message" class="open-sans font-size-1">--</p>

  <table>
    <caption class="claire-hand">Clés extraites de la réponse Actuator (actuator/info).</caption>
    <thead>
      <tr>
        <th scope="col" class="open-sans text-center">Clé</th>
        <th scope="col" class="open-sans text-center">Valeur</th>
      </tr>
    </thead>
    <tbody id="tableau-actuator" class="open-sans">
      <tr>
        <td colspan="2" class="text-center">Aucune donnée.</td>
      </tr>
    </tbody>
  </table>

  <footer class="grid-x grid-margin-x align-right margin-top-2">
    <div class="cell shrink">
      <a id="bouton-ouvrir-actuator-config"
          href="{{ path('actuator') }}"
          class="button open-sans focus-light"
          title="Gérer les points d'accès Actuator">
        <span aria-hidden="true">🛠️</span>Gérer
      </a>
    </div>
    <div class="cell shrink">
      <button id="bouton-fermer-actuator"
              class="button open-sans focus-light"
              type="button"
              aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
      </button>
    </div>
  </footer>
</dialog>

{% set title = 'Répartition par module' %}
{% set description = 'Ma Moulinette - Répartition des anomalies' %}
{% set type_content = "Application Ma-Moulinette, Répartition des anomalies par module." %}
{% set bottom = "footer-fixed" %}
<!DOCTYPE html>
<!--

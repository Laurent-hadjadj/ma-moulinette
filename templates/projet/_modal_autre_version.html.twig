<dialog id="modal-autre-version"
        class="reveal large"
        data-close-on-click="true"
        data-reveal
        aria-modal="true"
        aria-labelledby="titre-affiche-version-graphique"
        aria-describedby="desc-affiche-version-graphique">

      <h2 id="titre-affiche-version-graphique" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h2>
  <h3 id="desc-affiche-version-graphique" class="h4 claire-hand"><span aria-hidden="true">📊</span>Répartition du nombre de règles par langage</h3>
  <span class="show-for-sr">
    Ce graphique présente la répartition des versions selon leurs tags : release, snapshot ou autre.
  </span>

  {# affiche Graphique #}
  <div class="chart-container-donuts">
    <canvas id="graphique-autre-version" aria-label="Distribution des versions">
      Graphique non disponible sans JavaScript ou données manquantes.
    </canvas>
    <div class="chart-empty-message">Aucune donnée disponible pour ce graphique.</div>
  </div>

  <footer class="grid-x grid-margin-x align-right margin-top-2">
    <div class="cell shrink">
      <button id="bouton-fermer-autre-version-graphique"
              class="button open-sans focus-light"
              type="button"
              aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
      </button>
  </footer>
</dialog>

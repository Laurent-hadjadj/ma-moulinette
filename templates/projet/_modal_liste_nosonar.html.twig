        <td id="js-suppress-warning-modale" class="text-center stat-projet">--</td>
      </tr>
      <tr>
        <td><strong>//NOPMD (java:S1310)</strong></td>
        <td id="js-no-pmd-modale" class="text-center stat-projet">--</td>
      </tr>
      <tr>
        <td><strong>//Checkstyle:OFF (java:S1315)</strong></td>
        <td id="js-check-style-modale" class="text-center stat-projet">--</td>
      </tr>
      <tr>
        <td><strong>//NOSONAR Java (java:NoSonar)</strong></td>
        <td id="js-no-sonar-java-modale" class="text-center stat-projet">--</td>
      </tr>
      <tr>
        <td><strong>//NOSONAR Python (python:NoSonar)</strong></td>
        <td id="js-no-sonar-python-modale" class="text-center stat-projet">---</td>
      </tr>
      <tr>
        <td><strong>//NOSONAR PHP (php:NoSonar)</strong></td>

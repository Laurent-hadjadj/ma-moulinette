<html	lang="fr">

  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {% block stylesheets %}
      {{ encore_entry_link_tags('projet') }}
    {% endblock %}
  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}
    <br>

    <!-- Logger -->
    <label for="log" class="open-sans label-log">Journal d'activité.
      <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 31.666 31.666" class="gomme-svg">

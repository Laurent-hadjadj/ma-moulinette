{% set title = 'Suivi du projet' %}
{% set description = 'Ma Moulinette - Suivi du projet' %}
{% set type_content = "Application Ma-Moulinette, Suivi des indicateurs SonarQube pour mon projet." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>
<!--

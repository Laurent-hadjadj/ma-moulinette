        <path d="M2.904 23.686l7.828 6.019a3.302 3.302 0 001.993.692c.865 0 1.644-.366 2.136-1.008L29.814 9.926c-.003-.074-.006-.15-.012-.219-.07-.912-.47-2.623-1.652-3.533L21.199.832A3.981 3.981 0 0018.793 0c-.972 0-1.658.35-2.112.697L2.143 19.617c-.006.007-.009.016-.015.023-.262.606-.381 1.33-.196 2.207.11.604.14.764.177.973.209.326.474.619.795.866zM16.292 2.5c.641-.834 1.64-1.313 2.739-1.313.854 0 1.708.296 2.405.832l5.777 4.21c1.183.909 1.503 1.596 1.572 2.508.028.527-.125.99-.292 1.327l.007.005-.036.057a2.567 2.567 0 01-.201.326l-.428.685-.079.104a2.86 2.86 0 00.314-.563 1.083 1.083 0 01-.098.161l-.221.407L22.73 17.8l-.721-.552-.014.018-9.075-6.973-1.564-1.194L16.292 2.5z"/>
      </svg>
    </label>

    <div class="log-container" role="log">
      <textarea id="log" name="log" class="open-sans log" readonly="readonly" rows="6"></textarea>
    </div>

    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="/">Accueil</a></li>
          <li><span class="show-for-sr">vous êtes ici :</span>Mon projet</li>
        </ol>
      </nav>
    </header>

    <div class="grid-container">
      {# On récupère les droits de l'utilisateur #}
      <div class="js-user-rating" data-user="{{ app.user.roles|serialize(format = 'json') }}"></div>

      {# Message d'information #}
      <div id="callout-projet-message" class="callout alert-callout-border hide">
        <p class="open-sans text-justify js-message">
          <span id="js-reference-information"></span>
          <span id="js-message-information"></span>
        </p>
      </div>

      <h1 class="h4 grid-x cell claire-hand">Je choisis mon projet.
        <span id="j-aime">
          <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 512 512" class="favori-svg">
            <g transform="translate(0 512) scale(.1 -.1)">
              <path d="m1215 4984c-531-89-963-456-1139-966-52-151-69-268-70-463 0-144 4-203 22-297 99-527 412-1085 962-1713 365-418 941-950 1436-1326l134-102 134 102c495 376 1071 908 1436 1326 550 628 863 1186 962 1713 31 167 31 432-1 582-109 513-470 924-951 1084-162 54-239 67-420 73-139 4-183 2-280-16-310-55-567-188-782-403l-98-98-98 98c-213 213-472 347-777 402-128 24-346 25-470 4zm438-341c274-52 521-211 691-444 23-30 79-123 125-207 47-84 88-152 91-152s44 68 91 152c128 231 214 337 362 449 218 164 482 241 755 218 276-23 512-137 708-340 127-133 222-302 271-486 24-88 27-116 27-278 0-163-3-191-28-300-105-447-394-942-865-1480-326-373-749-775-1196-1135l-125-101-125 101c-325 262-717 620-952 868-633 668-987 1227-1109 1747-25 109-28 137-28 300 0 162 3 190 27 278 92 343 335 620 657 750 201 81 411 101 623 60z"/>
            </g>
          </svg>
        </span>
      </h1>
      <div class="grid-x cell">
        <div class="small-12 medium-12 large-12 cell">
          <label for="liste-projet">Liste des projets disponibles.</label>
          <select id="liste-projet" class="js-projet js-states form-control open-class" name="projet" title="Choisi un projet">
            <option value="TheID" selected="selected">--- Application ---</option>
          </select>
        </div>
      </div>
    </div>
    <br>

    <main class="grid-container">
      <p id="feedback" class="open-sans grid-x cell" data-bookmark="{{bookmark[0]}}">
        <span>La clé du projet est :&nbsp;</span>
        <span id="select-result">
          <strong>N.C</strong>
        </span>.
      </p>
      <div id="message"></div>
      <div class="grid-x cell">
        {# Analyse #}
        <div class="small-12 medium-4 large-4 bouton-analyse-right cell">
          <p class="button expanded float-center js-analyse lance-analyse-disabled">

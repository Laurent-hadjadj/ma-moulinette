<html lang="fr">

  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('projet') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><span class="show-for-sr">vous êtes ici :</span>Mon projet</li>
        </ol>
      </nav>
    </header>

    <header class="grid-container"
            aria-labelledby="titre-sonarqube">
      <h1 id="titre-sonarqube" class="h3 claire-hand" aria-label="Collecte et analyse des indicateurs SonarQube" aria-describedby="titre-sonarqube"><span aria-hidden="true">📊</span>Collecte et analyse des indicateurs SonarQube</h1>
      <div class="show-for-sr">Sur cette page, vous pouvez collecter et visualiser les métriques clés de vos projets SonarQube.</div>
    </header>

    <!-- Logger -->
    <section>
      <label for="log" class="open-sans label-log">Journal d'activité.
        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 32 32" class="gomme-svg">
          <title>Icône pour le bouton Effacer la log</title>
          <desc>Efface la log.</desc>
          <path d="M28.118 10.573c-.014.035-.03.067-.046.103l.056-.091c-.003-.004-.008-.008-.01-.012zM15.081 29.559c-.546.709-1.404 1.115-2.356 1.115a3.582 3.582 0 01-2.164-.75l-7.827-6.018a3.788 3.788 0 01-.465-.428 3.945 3.945 0 001.379 2.014l6.951 5.342a3.98 3.98 0 002.407.832c1.101 0 2.1-.479 2.74-1.312l13.382-17.417c.543-.705.689-1.721.696-2.567L15.081 29.559z"/>
          <path d="M2.904 23.686l7.828 6.019a3.302 3.302 0 001.993.692c.865 0 1.644-.366 2.136-1.008L29.814 9.926c-.003-.074-.006-.15-.012-.219-.07-.912-.47-2.623-1.652-3.533L21.199.832A3.981 3.981 0 0018.793 0c-.972 0-1.658.35-2.112.697L2.143 19.617c-.006.007-.009.016-.015.023-.262.606-.381 1.33-.196 2.207.11.604.14.764.177.973.209.326.474.619.795.866zM16.292 2.5c.641-.834 1.64-1.313 2.739-1.313.854 0 1.708.296 2.405.832l5.777 4.21c1.183.909 1.503 1.596 1.572 2.508.028.527-.125.99-.292 1.327l.007.005-.036.057a2.567 2.567 0 01-.201.326l-.428.685-.079.104a2.86 2.86 0 00.314-.563 1.083 1.083 0 01-.098.161l-.221.407L22.73 17.8l-.721-.552-.014.018-9.075-6.973-1.564-1.194L16.292 2.5z"/>
        </svg>
      </label>

      <div class="log-container" role="log">
        <textarea id="log" name="log" class="open-sans log" readonly="readonly" rows="6"></textarea>
      </div>
    </section>

    {# Gestion des messages flash & JS #}
    <section>
      {% for message in app.flashes('notice') %}
      <div class="callout {{ message.type }} alert-callout-border callout-ombre js-flash-box" role="alert" data-closable>
        <p class="open-sans text-justify callout-message">
            <strong>{{ message.titre }}</strong> {{ message.message }}
        </p>
        <button class="close-button {{message.type}}"
                type="button"
                aria-label="Dismiss alert" data-close><span aria-hidden="true">&times;</span>
        </button>
      </div>
      {% endfor %}

      {# Message d'information JS#}
      <div id="message-box" class="callout alert-callout-border callout-ombre hide" role="alert" data-closable>
          <button id="message-button-close" class="close-button" aria-label="Close alert" type="button" data-close>
          <span aria-hidden="true">&times;</span>
          </button>
          <p id="message-text"></p>
      </div>
    </section>

    <section class="grid-container">
      {# On récupère les droits de l'utilisateur #}
      <div class="js-user-rating" data-user="{{ app.user.roles|serialize(format = 'json') }}"></div>

      <h2 class="h4 grid-x cell claire-hand" aria-label="Choix du projet à analyser"><span aria-hidden="true">🧩</span>Je choisis mon projet
        <span id="j-aime" class="margin-left-05 padding-top-03">
          <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 28 28" class="favori-svg">
            <title>Icône pour le bouton Favori</title>
            <desc>Indique si le projet est un favori.</desc>
            <path d="M6.956.34C4.049.85 1.685 2.957.722 5.886c-.285.867-.378 1.54-.383 2.66 0 .826.022 1.165.12 1.705.542 3.027 2.255 6.231 5.265 9.838 1.998 2.4 5.15 5.456 7.86 7.616l.733.586.734-.586c2.709-2.16 5.861-5.215 7.859-7.616 3.01-3.607 4.723-6.811 5.265-9.838.17-.96.17-2.481-.005-3.342-.597-2.947-2.573-5.307-5.205-6.226-.887-.31-1.308-.385-2.299-.42-.76-.022-1.002-.01-1.532.092-1.697.316-3.104 1.08-4.28 2.315l-.537.563-.536-.563A7.716 7.716 0 009.528.362C8.828.224 7.634.22 6.956.34zm2.397 1.958c1.5.298 2.851 1.212 3.782 2.55.126.172.432.706.684 1.189.257.482.482.873.498.873.017 0 .24-.391.498-.873.7-1.327 1.171-1.936 1.981-2.58 1.194-.941 2.639-1.383 4.133-1.251 1.51.132 2.802.787 3.875 1.953a6.569 6.569 0 011.483 2.79c.131.506.148.667.148 1.597 0 .936-.017 1.097-.154 1.723-.574 2.568-2.156 5.41-4.734 8.5-1.784 2.142-4.1 4.451-6.546 6.519l-.684.58-.684-.58c-1.779-1.505-3.924-3.561-5.21-4.985-3.465-3.837-5.403-7.047-6.07-10.034-.137-.626-.153-.787-.153-1.723 0-.93.016-1.09.147-1.596.504-1.97 1.834-3.561 3.596-4.308a5.7 5.7 0 013.41-.344z"/></svg>
        </span>
      </h2>

      <div class="grid-x cell">
        <div class="small-12 medium-12 large-12 cell">
          <label for="liste-projet">Liste des projets disponibles.</label>
          <select id="liste-projet"
                  class="js-projet form-control open-class"
                  name="projet"
                  title="Choisi un projet">
            <option value="TheID" selected="selected">--- Application ---</option>
          </select>
        </div>
      </div>
    </section>

    <main class="grid-container margin-top-1 margin-bottom-2">
      <p id="feedback" class="open-sans grid-x cell" data-bookmark="{{bookmark[0]}}" data-session-bookmark="null">
        <span>La clé du projet est :&nbsp;</span>
        <output id="select-result" aria-live="polite"><strong>N.C</strong></output>
      </p>
      <div class="grid-x grid-margin-x">
        {# Analyse #}
        <div class="small-12 medium-4 large-4 cell">
          <div class="js-wrapper-collecte disabled-wrapper">
            <button id="bouton-collecte-indicateur"
                    class="button expanded js-analyse disabled-bouton focus-light"
                    type="button"
                    aria-label="Lancer la collecte des indicateurs SonarQube"
                    aria-disabled="true">
              <div class="container-analyse">

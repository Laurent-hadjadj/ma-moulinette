<dialog id="modal-affiche-scope" class="reveal large" data-reveal aria-modal="true" data-close-on-click="true"
    data-animation-in="fade-in" data-animation-out="fade-out" aria-labelledby="titre-scope"
    aria-describedby="desc-scope">

    <header>
        <h2 id="titre-scope" class="h3 claire-hand"><span aria-hidden="true">🧪</span>Scopes</h2>
        <h3 id="desc-scope" class="h4 claire-hand"><span aria-hidden="true">📋</span>Répartition MAIN/TEST</h3>
        <span class="show-for-sr">
            Cette fenêtre présente le nombre d'anomalies situées dans le code source (scope MAIN) et dans le code de
            test (scope TEST), globalement et par catégorie (bug, vulnérabilité, mauvaise pratique).
        </span>
    </header>

    <table id="tableau-repartition-scope">
        <caption class="claire-hand">Nombre d'anomalies dans le code source (Main) et le code de test (Test), et
            part du scope Test — global et par catégorie.</caption>
        <thead>
            <tr>
                <th scope="col" class="open-sans text-center">&nbsp;</th>
                <th scope="col" class="open-sans text-center">Global</th>
                <th scope="col" class="open-sans text-center">Bug</th>
                <th scope="col" class="open-sans text-center">Vulnérabilité</th>
                <th scope="col" class="open-sans text-center">Mauvaise pratique</th>
            </tr>
        </thead>
        <tbody class="open-sans">
            <tr>
                <th scope="row" class="open-sans">Main</th>
                <td id="js-scope-global-main" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-bug-main" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-vulnerability-main" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-code-smell-main" class="text-center stat-projet color-noir">--</td>
            </tr>
            <tr>
                <th scope="row" class="open-sans">Test</th>
                <td id="js-scope-global-test" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-bug-test" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-vulnerability-test" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-code-smell-test" class="text-center stat-projet color-noir">--</td>
            </tr>
            <tr>
                <th scope="row" class="open-sans">% Test</th>
                <td id="js-scope-global-test-percent" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-bug-test-percent" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-vulnerability-test-percent" class="text-center stat-projet color-noir">--</td>
                <td id="js-scope-code-smell-test-percent" class="text-center stat-projet color-noir">--</td>
            </tr>
        </tbody>
    </table>

    <div class="chart-container-scope">
        <canvas id="scope-bar-chart" aria-label="Graphique de la répartition MAIN/TEST, globale et par catégorie"></canvas>
    </div>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-scope" class="button open-sans focus-dark-light" type="button"
                aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
            </button>
        </div>
    </footer>
</dialog>

<html lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('cosui') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container">
      <nav aria-label="vous êtes ici :">
        <ul class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('projet', {}) }}">Projet</a></li>
          <li><span class="show-for-sr">vous êtes ici :</span>COSUI</li>
        </ul>
      </nav>
    </header>

    <header class="grid-container"
            aria-labelledby="titre-cosui"
            aria-describedby="desc-cosui">
      <h1 id="titre-cosui" class="h3 claire-hand" aria-label="Collecte et analyse des indicateurs SonarQube" aria-describedby="titre-cosui"><span aria-hidden="true">📈</span>COmité de SUIvi</h1>
      <h2 id="desc-cosui" class="h4 claire-hand"><span aria-hidden="true">📌</span>Suivi des indicateurs clés</h2>
      <div class="show-for-sr">Cette page affiche pour le projet les indicateurs de suivi clés entre une version de référence et la version courante.</div>
    </header>

    <main class="grid-container">
      <p class="open-sans">
        <span class="open-sans">Setup :</span>
        <span id="js-setup" class="open-sans color-noir">{{setup}}</span>
      </p>

      {# Gestion des messages flash & JS #}
      <section>
        {% for message in app.flashes('notice') %}
        <div class="callout {{ message.type }} alert-callout-border callout-ombre js-flash-box" role="alert" data-closable>
          <p class="open-sans text-justify callout-message">
              <strong>{{ message.titre }}</strong> {{ message.message }}
          </p>
          {% if message.trace %}
            <p class="open-sans text-justify callout-message">
              {{ message.trace }}
            </p>
          {% endif %}
          <button class="close-button {{message.type}}"
                  type="button"
                  aria-label="Dismiss alert" data-close><span aria-hidden="true">&times;</span>
          </button>
        </div>
        {% endfor %}

        {# Message d'information JS#}
        <div id="message-box" class="callout alert-callout-border callout-ombre hide" role="alert" data-closable>
            <button id="message-button-close" class="close-button" aria-label="Close alert" type="button" data-close>
            <span aria-hidden="true">&times;</span>
            </button>
            <p id="message-text"></p>
        </div>
      </section>

      <div class="grid-x">
        <p class="open-sans">Afficher les variations ?</p>
        <div class="switch switch-cosui small">
          <input id="js-oui-non" class="switch-input"  type="checkbox" name="variation-switch">
          <label class="switch-paddle switch-paddle-cosui" for="js-oui-non">
            <span class="show-for-sr">Afficher les variations ?</span>
            <span class="switch-active switch-active-cosui" aria-hidden="true">Oui</span>
            <span class="switch-inactive switch-inactive-cosui" aria-hidden="true">Non</span>
          </label>
        </div>
      </div>
      <br>
      <div id="tableau-notes" class="table-scroll">
        <table>
          <caption id="js-series" class="no-caption" aria-hidden="true" data-initial="{{dataset1}}" data-actuel="{{dataset2}}" data-labela="{{label1}}" data-labelb="{{label2}}"></caption>
          <thead>
            <tr class="open-sans">
              <th colspan="1" scope="col" class="text-center">Application référence</th>
              <th colspan="1" scope="col" class="text-center">Critère</th>
              <th colspan="1" scope="col" class="text-center">Version actuelle</th>
              <th colspan="1" scope="col" class="text-center">Bloquant</th>
              <th colspan="1" scope="col" class="text-center">Critique</th>
              <th colspan="1" scope="col" class="text-center">Majeur</th>
              <th colspan="1" scope="col" class="text-center">Note</th>
            </tr>
          </thead>
          <tbody id="mon-bo-tableau01" class="open-sans">
            <tr>
              <td id="application-reference-01" rowspan="4" class="text-center">
                <div class="container-application-version">
                  <p class="">{{monApplication}}</p>
                  <p class="version-initiale">{{initial_version_application}}</p>
                  <button id="js-affiche-projet-reference" class="no-select"
                          aria-label="Affiche la version initiale.">
                    <div class="container-information">
                      <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 28 28" class="information-svg">
                        <path d="M8.783.08C7.888.312 7.05 1.15 6.795 2.07l-.078.293H5.77c-.797 0-.969.017-1.073.088-.166.127-.265.408-.265.767v.303h-.973c-1.453 0-1.947.17-2.618.882-.386.408-.64.871-.755 1.384-.115.535-.115 16.107 0 16.642.182.816.77 1.593 1.483 1.946.214.11.516.226.666.26.188.038 1.598.06 4.362.06 3.722 0 4.102-.006 4.237-.094.286-.176.349-.617.135-.882l-.125-.154-4.21-.028-4.206-.028-.349-.182c-.395-.204-.624-.452-.817-.893l-.135-.303V6.085l.172-.37c.192-.419.426-.661.843-.865.27-.138.338-.144 1.29-.16l1-.022v.336c0 .712.177 1.186.583 1.588.463.452.265.43 4.466.43h3.721l.297-.154c.322-.171.603-.463.775-.822.089-.182.125-.37.146-.788l.031-.552h1.015c.99 0 1.02.006 1.307.144.359.182.66.49.832.855.125.27.125.286.151 2.365.026 2.26.031 2.272.313 2.426.192.105.327.105.525-.005.292-.155.307-.276.307-2.267 0-2.117-.03-2.42-.307-3.021-.333-.74-.822-1.213-1.546-1.506-.338-.132-.426-.143-1.488-.165l-1.135-.022v-.403c0-.353-.015-.43-.125-.562l-.125-.154-1.004-.028-1-.028-.062-.226C11.698.626 10.204-.284 8.783.08zm1.353 1.257c.531.26.88.783.958 1.434.083.706.161.75 1.353.75h.885v.937c0 1.065-.041 1.224-.338 1.357-.26.116-6.813.116-7.074 0-.322-.144-.343-.22-.343-1.313v-.981h.89c1.16 0 1.239-.044 1.322-.744.068-.563.375-1.076.796-1.335.51-.32 1.036-.353 1.551-.105z"/><path d="M3.374 9.247c-.296.154-.348.672-.088.932l.135.132 5.72.016c6.366.017 5.96.039 6.116-.358a.592.592 0 00-.172-.678c-.13-.11-.192-.11-5.866-.105-3.856 0-5.767.022-5.845.06zm0 3.529c-.296.154-.348.672-.088.932l.135.132 4.055.016c4.517.017 4.299.034 4.45-.358a.592.592 0 00-.172-.678c-.13-.11-.198-.11-4.2-.105-2.702 0-4.102.022-4.18.06zm14.662.01c-3.16.596-5.543 3.199-5.99 6.535-.079.584-.037 1.99.078 2.542.301 1.461.931 2.713 1.91 3.777 1.046 1.141 2.243 1.842 3.732 2.19.754.176 2.118.176 2.867 0 1.484-.354 2.613-1.004 3.654-2.102 1.036-1.103 1.65-2.3 1.983-3.87.167-.795.167-2.24 0-3.039a7.78 7.78 0 00-.66-1.963 7.191 7.191 0 00-1.406-1.99 7.074 7.074 0 00-3.54-2.019c-.504-.12-2.107-.16-2.628-.06zm2.499 1.241c2.232.54 4.013 2.377 4.58 4.726.53 2.184-.089 4.533-1.608 6.148-2.098 2.222-5.299 2.526-7.787.745-.734-.524-1.572-1.55-1.999-2.443-.5-1.059-.723-2.437-.577-3.634.338-2.867 2.41-5.156 5.09-5.619.599-.105 1.707-.066 2.3.077z"/><path d="M18.812 16.398a.597.597 0 00.135.916c.328.193.729-.022.791-.43.078-.535-.562-.872-.926-.486zm.182 2.234c-.344.16-.333.071-.333 2.856 0 1.737.015 2.564.057 2.658.146.33.635.391.885.11l.125-.143.015-2.531c.016-2.818.016-2.796-.327-2.95-.214-.094-.219-.094-.422 0zm-15.62-2.327c-.296.154-.348.672-.088.932l.135.132h6.017l.135-.132c.266-.265.208-.783-.104-.938-.172-.083-5.928-.077-6.095.006z"/>
                      </svg>
                    </div>
                    {{ initial_date_application|date("d/m/Y") }}
                  </button>
                </div>
              </td>
              <td id="indicateur-01" class="text-left couleur-niveau-01">Maintenabilité</td>
              <td id="version-01" rowspan="4" class="text-center">
                {{version_application}}<br>
                {{type_application}}<br>
                {{date_application|date("d/m/Y")}}
              </td>
              <td id="blocker-01" class="text-right">
                {{code_smell_blocker|number_format(0, '.', ' ') }}
                <span class="{{evolution_code_smell_blocker}} hide"></span>
              </td>
              <td id="critical-01" class="text-right">
                {{code_smell_critical|number_format(0, '.', ' ')}}
                <span class="{{evolution_code_smell_critical}} hide"></span>
              </td>
              <td id="major-01" class="text-right">
                {{code_smell_major|number_format(0, '.', ' ')}}
                <span class="{{evolution_code_smell_major}} hide"></span>
              </td>
              <td id="note-01" class="text-center note-{{note_code_smell|lower}} bordure-top bordure-bottom">{{note_code_smell}}
              </td>
            </tr>
            <tr>
              <td id="indicateur-02" class="text-left couleur-niveau-02">Fiabilité</td>
              <td id="blocker-02" class="text-right">
                {{bug_blocker|number_format(0, '.', ' ')}}
                <span class="{{evolution_bug_blocker}} hide"></span>
              </td>
              <td id="critical-02" class="text-right">
                {{bug_critical|number_format(0, '.', ' ')}}
                <span class="{{evolution_bug_critical}} hide"></span>
              </td>
              <td id="major-02" class="text-right">
                {{bug_major|number_format(0, '.', ' ')}}
                <span class="{{evolution_bug_major}} hide"></span>
              </td>
              <td id="note-02" class="text-center note-{{note_reliability|lower}} bordure-top bordure-bottom">
                {{note_reliability}}
              </td>
            </tr>
            <tr>
              <td id="indicateur-03" class="text-left couleur-niveau-03">Sécurité</td>
              <td id="blocker-03" class="text-right">
                {{vulnerability_blocker|number_format(0, '.', ' ')}}
                <span class="{{evolution_vulnerability_blocker}} hide"></span>
              </td>
              <td id="critical-03" class="text-right">
                {{vulnerability_critical|number_format(0, '.', ' ')}}
                <span class="{{evolution_vulnerability_blocker}} hide"></span>
              </td>
              <td id="major-03" class="text-right">
                {{vulnerability_major|number_format(0, '.', ' ')}}
                <span class="{{evolution_vulnerability_blocker}} hide"></span>
              </td>
              <td id="note-03" class="text-center note-{{note_security|lower}} bordure-top bordure-bottom">
                {{note_security}}
              </td>
            </tr>
            <tr>
              <td id="indicateur-04" class="text-left couleur-niveau-04">Hotspot</td>
              <td id="hotspot-01" class="text-center" colspan="3">
                {{hotspot|number_format(0, '.', ' ')}}
                <span class="{{evolution_hotspot}} hide"></span>
              </td>
              <td id="note-04" class="text-center note-{{note_hotspot|lower}} bordure-top bordure-bottom">
                {{note_hotspot}}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <br>
      <div id="tableau-repartition" class="table-scroll">
        <h2 class="h3 claire-hand">Répartition des défauts.</h2>
        <table class="hover">
          <caption class="no-caption" aria-hidden="true"></caption>
          <thead>
            <tr class="open-sans">
              <th colspan="1" scope="col" class="text-center">Application référence</th>
              <th colspan="1" scope="col" class="text-center">Critère</th>
              <th colspan="1" scope="col" class="text-center">Version actuelle</th>
              <th colspan="3" scope="col" class="text-center">Métier</th>
              <th colspan="3" scope="col" class="text-center">Présentation</th>
            </tr>
            <tr class="open-sans">
              <th colspan="3" scope="col"></th>
              <th colspan="1" scope="col" class="text-center">Bloquant</th>
              <th colspan="1" scope="col" class="text-center">Critique</th>
              <th colspan="1" scope="col" class="text-center">Majeur</th>
              <th colspan="1" scope="col" class="text-center">Bloquant</th>
              <th colspan="1" scope="col" class="text-center">Critique</th>
              <th colspan="1" scope="col" class="text-center">Majeur</th>
            </tr>
          </thead>
          <tbody id="mon-bo-tableau02" class="open-sans">
            <tr>
              <td id="application-reference-02" rowspan="3" class="text-center blanc">
                <p class="open-sans">{{monApplication}}</p>
                Date<br>
                {{initial_date_application|date("d/m/Y")}}
              </td>
              <td id="code-smell" class="text-left couleur-niveau-01">Maintenabilité</td>
              <td id="version-02" rowspan="3" class="text-center blanc">
                {{version_application}}<br>
                {{type_application}}<br>
                {{date_application|date("d/m/Y")}}
              </td>
              <td id="metier-codes-smell-01" class="text-center">
                {{nombre_metier_code_smell_blocker|number_format(0, '.', ' ')}}
              </td>
              <td id="metier-code-smell-02" class="text-center">
                {{nombre_metier_code_smell_critical|number_format(0, '.', ' ')}}
              </td>
              <td id="metier-code_smell-03" class="text-center">
                {{nombre_metier_code_smell_major|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-code_smell-04" class="text-center">
                {{nombre_presentation_code_smell_blocker|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-code_smell-05" class="text-center">
                {{nombre_presentation_code_smell_critical|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-code_smell-06" class="text-center">
                {{nombre_presentation_code_smell_major|number_format(0, '.', ' ')}}
              </td>
            </tr>
            <tr>
              <td id="reliability" class="text-left couleur-niveau-02">Fiabilité</td>
              <td id="metier-reliability-01" class="text-center">
                {{nombre_metier_bug_blocker|number_format(0, '.', ' ')}}</td>
              <td id="metier-reliability-02" class="text-center">
                {{nombre_metier_bug_critical|number_format(0, '.', ' ')}}</td>
              <td id="metier-reliability-03" class="text-center">
                {{nombre_metier_bug_major|number_format(0, '.', ' ')}}</td>
              <td id="presentation-reliability-04" class="text-center">
                {{nombre_presentation_bug_blocker|number_format(0, '.', ' ')}}</td>
              <td id="presentation-reliability-05" class="text-center">
                {{nombre_presentation_bug_critical|number_format(0, '.', ' ')}}</td>
              <td id="presentation-reliability-06" class="text-center">
                {{nombre_presentation_bug_major|number_format(0, '.', ' ')}}</td>
            </tr>
            <tr>
              <td id="security" class="text-left couleur-niveau-03">Vulnérabilité</td>
              <td id="metier-vulnerability-01" class="text-center">
                {{nombre_metier_vulnerability_blocker|number_format(0, '.', ' ')}}
              </td>
              <td id="metier-vulnerability-02" class="text-center">
                {{nombre_metier_vulnerability_critical|number_format(0, '.', ' ')}}
              </td>
              <td id="metier-vulnerability-03" class="text-center">
                {{nombre_metier_vulnerability_major|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-vulnerability-04" class="text-center">
                {{nombre_presentation_vulnerability_blocker|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-vulnerability-05" class="text-center">
                {{nombre_presentation_vulnerability_critical|number_format(0, '.', ' ')}}
              </td>
              <td id="presentation-vulnerability-06" class="text-center">
                {{nombre_presentation_vulnerability_major|number_format(0, '.', ' ')}}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <br>
      <div>
        <h2 class="h3 claire-hand">Notes SonarQube</h2>
        <div class="float-center graphique-note-container">
          <canvas id="graphique-note" aria-label="Distribution des notes."></canvas>
        </div>
      </div>
    </main>

    {# Affichage du tableau des projets #}
    <div id="modal-projet-reference" class="reveal" data-reveal data-close-on-click="true" data-animation-in="fade-in" data-animation-out="fade-out" aria-modal="true">
      <h1 class="h2 claire-hand">Projet de référence.</h1>
      <h2 class="h4 claire-hand">{{monApplication}}</h2>
      <h3 class="h4 open-sans">
        {{initial_date_application|format_datetime('full', 'short', locale='fr') }}
      </h3>
      <table>
        <caption class="claire-hand"></caption>
        <thead>
          <tr class="open-sans">
            <th colspan="1" scope="col" class="text-center">Critère</th>
            <th colspan="1" scope="col" class="text-center">Bloquant</th>
            <th colspan="1" scope="col" class="text-center">Critique</th>
            <th colspan="1" scope="col" class="text-center">Majeur</th>
            <th colspan="1" scope="col" class="text-center">Note</th>
          </tr>
        </thead>
        <tbody id="mon-bo-tableau03" class="open-sans">
          <tr>
            <th scope="row" id="initial-indicateur-01" class="text-left couleur-niveau-01">Maintenabilité</th>
            <td id="initial-blocker-01" class="text-center">
              {{modal_initial_code_smell_blocker|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-critical-01" class="text-center">
              {{modal_initial_code_smell_critical|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-major-01" class="text-center">
              {{modal_initial_code_smell_major|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-note-01" class="text-center note-{{initial_note_code_smell|lower}}">
              {{initial_note_code_smell}}
            </td>
          </tr>
          <tr>
            <th scope="row" id="initial-indicateur-02" class="text-left couleur-niveau-02">Fiabilité</th>
            <td id="initial-blocker-02" class="text-center">
              {{modal_initial_bug_blocker|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-critical-02" class="text-center">
              {{modal_initial_bug_critical|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-major-02" class="text-center">
              {{modal_initial_bug_major|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-note-02" class="text-center note-{{initial_note_reliability|lower}}">
              {{initial_note_reliability}}
            </td>
          </tr>
          <tr>
            <th scope="row" id="initial-indicateur-03" class="text-left couleur-niveau-03">Sécurité</th>
            <td id="initial-blocker-03" class="text-center">
              {{modal_initial_vulnerability_blocker|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-critical-03" class="text-center">
              {{modal_initial_vulnerability_critical|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-major-03" class="text-center">
              {{modal_initial_vulnerability_major|number_format(0, '.', ' ')}}
            </td>
            <td id="initial-note-03" class="text-center note-{{initial_note_security|lower}}">
              {{initial_note_security}}
            </td>
          </tr>
          <tr>
            <td id="initial-indicateur-04" class="text-left couleur-niveau-04">Hotspot</td>
            <td id="initial_hotspot-01" class="text-center" colspan="3">
              {{modal_initial_hotspot|number_format(0, '.', ' ')}}
            </td>
            <td id="initial_note-04" class="text-center note-{{initial_note_hotspot|lower}}">
              {{initial_note_hotspot}}
            </td>
          </tr>
        </tbody>
      </table>

      <button id="fermer-projet-reference" class="expanded button open-sans" data-close aria-label="Close reveal" type="button">Fermer
      </button>
    </div>

    <br><br>
    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

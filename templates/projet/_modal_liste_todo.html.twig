<dialog id="modal-affiche-liste-todo"
    class="reveal large" data-reveal
    aria-modal="true"
    data-close-on-click="true"
    data-animation-in="fade-in"
    data-animation-out="fade-out"
    aria-labelledby="titre-affiche-liste-todo"
    aria-describedby="desc-affiche-liste-todo">

    <header>
        <h2 id="titre-affiche-liste-todo" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h2>
        <h3 id="desc-affiche-liste-todo" class="h4 claire-hand"><span aria-hidden="true">📋</span>Détails des Tags Todo.</h3>
        <span class="show-for-sr">
            Cette page présente la répartition des todos en fonction du langage et les 10 premiers todo de la liste.
        </span>
    </header>

    <table>
        <caption class="claire-hand">Répartition des tags Todo par langage.</caption>
        <thead>
            <tr>
                <th scope="col" class="open-sans text-left">Langage</th>
                <th scope="col" class="open-sans text-right">Total</th>
            </tr>
        </thead>
        {# MODIF 2026-05-06 : ajout PHP/Python/Ruby +
        clarification "HTML / Web" (rule SonarQube Web:S1135 = templates HTML/JSP). #}
        <tbody id="tableau-liste-todo" class="open-sans">
            <tr>
                <td><strong>Java</strong></td>
                <td id="js-java" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>JavaScript</strong></td>
                <td id="js-javascript" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>TypeScript</strong></td>
                <td id="js-typescript" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>PHP</strong></td>
                <td id="js-php" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>Python</strong></td>
                <td id="js-python" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>Ruby</strong></td>
                <td id="js-ruby" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>HTML / Web</strong></td>
                <td id="js-html" class="text-center stat-projet"></td>
            </tr>
            <tr>
                <td><strong>XML</strong></td>
                <td id="js-xml" class="text-center stat-projet"></td>
            </tr>
        </tbody>
    </table>
    <br>

    <table>
        <caption class="claire-hand">Liste des fichiers par langage.</caption>
        <thead>
            <tr>
                <th scope="col" class="open-sans text-left">Langage</th>
                <th scope="col" class="open-sans text-center">Fichier</th>
                <th scope="col" class="open-sans text-center">Ligne</th>
            </tr>
        </thead>
        <tbody id="tableau-liste-detail" class="open-sans">
            <tr>
                <td class="text-center">--</td>
                <td class="text-center">--</td>
                <td class="text-center">--</td>
            </tr>
        </tbody>
    </table>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-liste-todo"
                class="button open-sans focus-dark-light"
                type="button"
                aria-label="Ferme modale"><span aria-hidden="true">❌</span> Fermer
                </button>
            +    </div>
        </footer>
    </dialog>

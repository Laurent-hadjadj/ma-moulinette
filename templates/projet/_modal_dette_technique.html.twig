<dialog id="modal-dette-technique"
        class="reveal"
        data-close-on-click="true"
        data-reveal
        aria-modal="true"
        aria-labelledby="titre-affiche-dette-technique"
        aria-describedby="desc-affiche-dette-technique">

    {# WCAG 1.3.1 / 2.4.6 : un seul <h1> par page (header "Ma-Moulinette"), le titre de la modale devient <h2> ; descente de toute la hiérarchie d'un niveau #}
      <h2 id="titre-affiche-dette-technique" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h2>
    <h3 id="desc-affiche-dette-technique" class="h4 claire-hand"><span aria-hidden="true">📉</span>Dette technique</h3>
    <span class="show-for-sr">
      Cette page présente la répartition de la dette technique cumulée.
    </span>
    <table>
      <caption class="claire-hand">Répartition de la dette technique.</caption>
      <thead>
        <tr>
          <th scope="col">Type</th>
          <th scope="col">Dette</th>
        </tr>
      </thead>
      <tbody class="open-sans">
        <tr>
          <td>Fiabilité</td>
          <td id="js-dette-reliability"></td>
        </tr>
        <tr>
          <td>Sécurité</td>
          <td id="js-dette-vulnerability"></td>
        </tr>
        <tr>
          <td>Maintenabilité</td>
          <td id="js-dette-code-smell"></td>
        </tr>
      </tbody>
    </table>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
      <div class="cell shrink">
        <button id="bouton-fermer-dette-technique" data-close
                class="button open-sans focus-light"
                type="button"
                aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span> Fermer
        </button>
    </footer>
  </dialog>

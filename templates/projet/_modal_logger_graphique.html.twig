{# MODIF 2026-05-15 :
Modale Graphique des Loggers JAVA (Chart.js bar empilé level x framework).
Source : dataset.loggerBreakdown sur #js-affiche-logger-detail.
Le canvas est ré-instancié à chaque ouverture (destroy puis new Chart) pour
éviter les fuites Chart.js. #}
<dialog id="modal-affiche-logger-graphique"
    class="reveal large"
    class="reveal large" data-reveal
    aria-modal="true"
    data-close-on-click="true"
    data-animation-in="fade-in"
    data-animation-out="fade-out"
    aria-labelledby="titre-affiche-logger-graphique"
    aria-describedby="desc-affiche-logger-graphique">

    <header>
        <h2 id="titre-affiche-logger-graphique" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information</h2>
        <h3 id="desc-affiche-logger-graphique" class="h4 claire-hand"><span aria-hidden="true">📊</span>Répartition graphique des loggers JAVA.</h3>
        <span class="show-for-sr">
            Graphique en barres empilées présentant la répartition des loggers JAVA par
            niveau (info, warn, error, debug) et par framework de logging.
        </span>
    </header>

    <div class="grid-x">
        <div class="cell">
            <canvas id="logger-bar-chart" aria-label="Graphique des loggers JAVA par niveau et framework"></canvas>
        </div>
    </div>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-logger-graphique"
                class="button open-sans focus-dark-light"
                type="button"
                aria-label="Ferme modale"><span aria-hidden="true">❌</span> Fermer
                </button>
            </div>
        </footer>
    </dialog>

    {# Affichage du tableau des projets #}
    <dialog id="modal-liste-projet" class="reveal" data-reveal data-close-on-click="true" data-animation-in="fade-in" data-animation-out="fade-out" aria-modal="true">
      <h1 class="h2 claire-hand">Mes projets.</h1>
      <h2 class="h4 claire-hand">
        <span id="affiche-total-projet"></span>
        trouvé(s).</h2>
      <table>
        <caption class="claire-hand">Liste des projets.</caption>
        <thead>
          <tr>
            <th scope="col" class="open-sans text-center">Projet</th>
            <th scope="col" class="open-sans text-center">Favori</th>
            <th scope="col" class="open-sans text-center" colspan="6">Actions</th>
          </tr>
        </thead>
        <tbody
          id="tableau-liste-projet" class="open-sans">
          {# On crée une pseudo ligne pour éviter une erreur HTML sur le tbody vide ! #}
          <tr>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
          </tr>
        </tbody>
      </table>

      <p class="open-sans-bold information-statut" role="alert">Statut :
        <span id="information-texte" class="information-texte"></span>
      </p>

      <button id="js-modifier-liste-projet" class="modifier-liste-projet">
        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 32 32" class="modifier-liste-projet-svg" aria-hidden="true">

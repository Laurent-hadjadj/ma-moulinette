<style>
  body {
    font-family: 'DejaVu Sans', Arial, sans-serif;
    font-size: 11px;
    color: #00445b;
    margin: 0;
  }

  @page {
    margin: 30px 25px 60px 25px;
  }

  h1 {
    font-size: 22px;
    margin: 0 0 6px 0;
  }

  h2 {
    font-size: 14px;
    margin: 18px 0 8px 0;
    padding-bottom: 4px;
    border-bottom: 2px solid #00445b;
  }

  h3 {
    font-size: 12px;
    margin: 12px 0 6px 0;
  }

  /* === Page de garde === */
  .cover {
    text-align: center;
    padding-top: 80px;
  }

  .cover .logo-cover {
    max-height: 70px;
    margin-bottom: 30px;
  }

  .cover h1 {
    font-size: 28px;
    margin: 12px 0;
  }

  .cover .subtitle {
    font-size: 14px;
    color: #666;
    margin-bottom: 60px;
  }

  .cover .project-block {
    display: inline-block;
    border: 2px solid #00445b;
    padding: 18px 40px;
    border-radius: 4px;
    margin-top: 20px;
  }

  .cover .project-block .pname {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .cover .project-block .pgroup {
    font-size: 12px;
    color: #666;
    margin-bottom: 10px;
  }

  .cover .project-block .pversion {
    font-size: 14px;
    font-weight: bold;
    color: #d4333f;
  }

  .cover .meta {
    margin-top: 50px;
    font-size: 11px;
    color: #888;
  }

  /* === Header standard === */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    border-bottom: 2px solid #00445b;
    padding-bottom: 10px;
  }

  .logo { max-height: 35px; }
  .header-title { text-align: right; }
  .header-title h2 { font-size: 14px; margin: 0; border: none; padding: 0; }
  .header-title .subtitle { font-size: 10px; color: #666; }

  .warning-box {
    background: #fdf3e0;
    border: 1px solid #e0a800;
    border-radius: 4px;
    padding: 8px 12px;
    margin-bottom: 14px;
    font-size: 10px;
    color: #6b5100;
  }
  .warning-box strong { color: #e0a800; }

  .callout-info {
    background: #eef4f8;
    border-left: 3px solid #1779ba;
    padding: 6px 10px;
    font-size: 9px;
    color: #444;
    margin-top: 6px;
    margin-bottom: 12px;
  }

  /* === Tableaux info & synthèse === */
  .info-grid,
  .synthese {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
  }

  .info-grid td,
  .synthese td,
  .synthese th {
    padding: 5px 8px;
    border: 1px solid #ddd;
    vertical-align: middle;
  }

  .info-grid td.label,
  .synthese td.label {
    background: #f0f4f7;
    font-weight: bold;
    width: 35%;
  }

  .synthese th {
    background: #00445b;
    color: #fff;
    text-align: left;
    font-size: 11px;
  }

  .synthese .stat-value {
    text-align: center;
    font-weight: bold;
    width: 100px;
  }

  /* === Tuiles (page résumé) === */
  .tiles { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
  .tiles td {
    width: 33.33%;
    padding: 10px 8px;
    text-align: center;
    border: 1px solid #ddd;
  }
  .tiles .tile-title { display: block; font-size: 9px; text-transform: uppercase; color: #666; margin-bottom: 4px; }
  .tiles .tile-value { display: block; font-size: 20px; font-weight: bold; color: #00445b; }

  /* === Badges de sévérité — 5 niveaux npm natifs (moderate, pas medium) === */
  .sev {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 3px;
    font-weight: bold;
    font-size: 10px;
    color: #fff;
  }
  .sev-critical { background: #cc4b37; }
  .sev-high     { background: #f08a24; }
  .sev-moderate { background: #ffd200; color: #333; }
  .sev-low      { background: #1779ba; }
  .sev-info     { background: #9aa3ad; }

  /* === Badges d'origine (prod/dev/indéterminé) === */
  .origin { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 10px; }
  .origin-prod    { background: #00445b; color: #fff; font-weight: bold; }
  .origin-dev     { background: #e8eaed; color: #333; }
  .origin-unknown { border: 1px dashed #999; color: #888; font-style: italic; }

  /* === Badge Direct/Transitif === */
  .badge-neutre { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 10px; background: #e8eaed; color: #333; }

  /* === Page Tendance : histogramme vertical + delta === */
  .histogram { width: 100%; border-collapse: collapse; margin-top: 8px; table-layout: fixed; }
  .histogram .bar-cell { vertical-align: bottom; text-align: center; height: 110px; padding: 0 3px; border-bottom: 1px solid #00445b; }
  .histogram .bar { display: block; background: #00445b; margin: 0 auto; width: 60%; min-height: 1px; }
  .histogram .bar-value { display: block; font-size: 8px; font-weight: bold; margin-bottom: 2px; }
  .histogram .bar-label { text-align: center; font-size: 8px; font-weight: bold; padding: 3px 0; }

  .trend-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 10px; }
  .trend-table th, .trend-table td { padding: 4px 6px; border: 1px solid #ddd; text-align: center; }
  .trend-table th { background: #f0f4f7; font-weight: bold; }
  .trend-table td.date-col { text-align: left; font-weight: bold; }
  .delta { font-weight: bold; }
  .delta-up   { color: #cc4b37; }   /* dégradation */
  .delta-down { color: #2e7d32; }   /* rémédiation */
  .delta-flat { color: #888; }

  /* === Tableaux croisés (page focus stratégique) === */
  .cross-table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 14px; }
  .cross-table th, .cross-table td { padding: 5px 8px; border: 1px solid #ddd; text-align: center; }
  .cross-table th { background: #f0f4f7; font-weight: bold; }
  .cross-table td.sev-col { text-align: left; }

  /* === Top paquets : barre horizontale intégrée au tableau === */
  .top-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
  .top-table th, .top-table td { padding: 5px 8px; border: 1px solid #ddd; vertical-align: middle; }
  .top-table th { background: #f0f4f7; font-weight: bold; text-align: left; }
  .top-table .num { text-align: center; width: 30px; font-weight: bold; }
  .top-table .nb { text-align: center; width: 50px; font-weight: bold; }
  .top-table .bar-col { width: 160px; }
  .top-table .hbar-track { background: #eee; height: 10px; border-radius: 2px; }
  .top-table .hbar-fill { background: #00445b; height: 10px; border-radius: 2px; }

  /* === Findings (paysage) === */
  .findings { width: 100%; border-collapse: collapse; font-size: 9.5px; }
  .findings th, .findings td { padding: 4px 6px; border: 1px solid #ddd; vertical-align: middle; }
  .findings th { background: #f0f4f7; font-weight: bold; }
  .findings .num { text-align: center; width: 25px; }
  .findings .cvss { text-align: center; width: 40px; }
  .findings .dep { width: 110px; }
  .findings .type-col { text-align: center; width: 60px; }
  .findings .origin-col { text-align: center; width: 70px; }
  .findings .ver { width: 110px; }
  .findings .fix-col { text-align: center; width: 45px; }
  .findings .cwe { width: 80px; font-family: monospace; }
  .findings .desc { font-size: 9px; color: #555; }

  .sev-section-title {
    margin: 18px 0 6px 0;
    font-size: 13px;
    padding: 4px 8px;
    color: #fff;
    border-radius: 3px;
  }
  .sev-section-title.sev-critical { background: #cc4b37; }
  .sev-section-title.sev-high     { background: #f08a24; }
  .sev-section-title.sev-moderate { background: #ffd200; color: #333; }
  .sev-section-title.sev-low      { background: #1779ba; }
  .sev-section-title.sev-info     { background: #9aa3ad; }

  .page-break-before { page-break-before: always; }
  .footnote { font-size: 10px; color: #666; }
  .empty { text-align: center; color: #888; padding: 12px; font-style: italic; }
</style>

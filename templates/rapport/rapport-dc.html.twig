{% set scan = data.scan %}
{% set findings = data.findings %}
{% set top_deps = data.top_deps ?? [] %}
{% set top_cwes = data.top_cwes ?? [] %}
{% set project_label = data.project_group ~ ':' ~ data.project_artifact ~ ':' ~ data.project_version %}

<!DOCTYPE html>
{#

{% set title = "Admin-Log" %}
{% set description = "Consultation des journaux de traces" %}
{% set type_content = "Application Ma-Moulinette, consultation des traces." %}
{% set bottom="footer-fixed footer-fixed-small" %}
<!DOCTYPE html>

{% set title = 'Bienvenue' %}
{% set description = 'Ma-Moulinette - Inscription réalisée avec succès.' %}
{% set type_content = "Application Ma-Moulinette, inscription réalisée avec succès." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>

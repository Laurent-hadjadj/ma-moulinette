<html lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement du code javascript #}
    {% block importmap %}{{ importmap('welcome') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    {# Fil d’Ariane #}
    <header class="grid-container margin-top-1">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><span class="show-for-sr">Vous êtes sur la page de bienvenue:</span>Bienvenue</li>
        </ol>
      </nav>
    </header>

    {# Message d'information php #}
    {{ include('_message.html.twig') }}

    <header class="grid-container" aria-labelledby="titre-principal">
      <h1 id="titre-principal" class="h3 claire-hand" aria-label="Bienvenue, vous êtes inscrit."><span aria-hidden="true">🛠️</span>Bienvenue sur Ma-Moulinette</h1>
    </header>

    <main class="grid-container" role="main">
      <div class="small-12 medium-12 large-12 cell">
        <h1 class="h2 claire-hand">Bienvenue.</h1>
        <p class="open-sans text-justify">
          Vous venez de réaliser votre inscription à l'application ma-moulinette. Bravo !!!
        </p>
        <p class="open-sans text-justify">
          Toutefois, il vous reste encore une étape importante.
          Vous devez contacter le gestionnaire en charge de valider votre inscription
          afin qu'il active manuellement votre compte.
        </p>
      </div>

      <div class="fieldset information-inscription">
        <div class="callout open-sans small">
          <span class="lead"><strong>Nom :</strong></span><span>🪪</span>{{nom}}</div>
        <div class="callout open-sans small">
          <span class="lead"><strong>Prénom : </strong></span><span>🪪</span>{{prenom}}
        </div>
        <div class="callout open-sans small">
          <span class="lead"><strong>Mel :</strong></span><span>📧</span>{{courriel}}</div>
      </div>
    </main>

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

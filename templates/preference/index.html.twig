                    </div>
                    <div class="small-12 medium-11 large-11 cell">
                        <p class="open-sans mon-groupe">
                            {% if groupesFonctionnel[0]=="null" %}
                                <span class="color-rouge">Aucun</span>
                            {% else %}
                                {% set i,nombreGroupe = 1, groupesFonctionnel|length %}
                                {% for groupe in groupesFonctionnel %}
                                    <span>{{groupe}}</span>
                                    {% if i < nombreGroupe %}
                                        <span>
                                            -
                                        </span>
                                    {% endif %}
                                    {% set i = i + 1 %}
                                {% endfor %}
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

            {% if peut_voir_actuator %}
                <div class="grid-x grid-margin-x align-right margin-top-2">
                    <div class="cell shrink">
                        <a  id="bouton-ouvrir-actuator"
                            href="{{ path('actuator', {}) }}"
                            class="button open-sans focus-dark-light"
                            type="button"
                            aria-label="Accéder à Actuator"><span aria-hidden="true">🪴</span>Accéder à Actuator</a>
                    </div>
                </div>
            {% endif %}

            {# Mes préférences #}
            <h3 class="h4 claire-hand margin-top-01">Mes préférences.</h3>
            <table class="hover">
                <caption class="claire-hand">Liste des préférences de l'utilisateur.</caption>
                <thead>
                    <tr>
                        <th scope="col" class="open-sans text-center"></th>
                        <th scope="col" class="open-sans text-center">Option</th>
                        <th scope="col" class="open-sans text-center">Description</th>
                        <th scope="col" class="open-sans text-center">Utilisation</th>
                    </tr>
                </thead>
                <tbody id="tableau-liste-preferences" class="open-sans">
                    {% for preference in preferences %}
                        {% set option = preference['option']|lower %}
                        <tr class="open-sans">
                            <td id="js-{{option}}" class="js-preference-information">

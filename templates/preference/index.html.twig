                        </svg>
                    </div>
                    <div class="small-12 medium-11 large-11 cell">
                        <p class="open-sans mon-groupe">
                            {% if groupeUtilisateur == "Aucun" %}
                                <span class="color-rouge">Aucun</span>
                            {% else %}
                                <span>{{groupeUtilisateur}}</span>
                            {% endif %}
                        </p>
                    </div>
                </div>


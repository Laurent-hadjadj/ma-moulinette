                        </svg>
                    </div>
                    <div class="small-12 medium-11 large-11 cell">
                        <p class="open-sans privilege-titre">Mes privilèges :</p>
                    </div>
                </div>
                <div class="grid-x">
                    <ul class="open-sans">
                        {% for role in roles %}
                            <li class="privilege-liste">{{role}}</li>
                        {% endfor %}
                    </ul>
                </div>

                {# Mon groupe_utilisateur #}
                <div class="grid-x display-flex flex-align-items-center">
                    <div class="small-12 medium-1 large-1 cell">
                        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="mon-groupe-svg" width="100%" height="100%"

<html lang="fr">

    {# Chargement de la section HEAD #}
    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {# Chargement des assets JS et CSS #}
        {% block importmap %}
            {{ importmap('preference') }}
        {% endblock %}
    </head>

    <body>
        {# Chargement de la section header #}
        {{ include('header.html.twig') }}

        <header class="grid-container margin-top-1">
            <nav aria-label="Fil d'Ariane, vous êtes ici">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li aria-current="page">Mes préférences</li>
                </ol>
            </nav>
        </header>

        {# Message d'information php #}
        {{ include('_message.html.twig') }}

        <main id="main-content" class="grid-container margin-bottom-3">
            <h2 class="h4 claire-hand"><span aria-hidden="true">🎛️</span>Mes Informations personnelles.</h2>
            <div class="callout alert-callout-border info">
                <p class="opens-sans text-justify">ℹ️ Cette page affiche les informations et préférences personnelles de l'utilisateur.</p>
            </div>

            <div class="fieldset fieldset-information">
                <div class="grid-x display-flex flex-align-items-center">
                    {# Prénom + Nom #}
                    <div class="small-12 medium-1 large-1 cell">
                        <img id="ma-tronche" class="margin-left-06" src="{{ asset('avatar/' ~ avatar) }}" alt="Mon avatar"/>
                    </div>
                    <div class="small-12 medium-11 large-11 cell">
                        <p class="open-sans prenom-nom">{{prenom}} {{nom}}</p>
                    </div>
                </div>
                {# Adresse Mel #}
                <div class="grid-x display-flex flex-align-items-center">
                    <div class="small-12 medium-1 large-1 cell">
                        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="courriel-svg" width="100%" height="100%"
                            viewbox="0 0 32 32" aria-hidden="true" focusable="false">
                            <title>Adresse de courriel de l'utilisateur</title>
                            <desc>Affiche l'adresse de courriel de l'utilisateur.</desc>
                            <path d="M2.38 10.1C.79 10.46-.2 11.95.2 13.37c.12.43.35.82.67 1.12.28.26 13.52 8.44 14.01 8.64.74.31 1.62.3 2.38-.03.59-.26 13.57-8.28 13.9-8.59 1.55-1.46.7-3.94-1.51-4.42-.58-.13-26.68-.12-27.25.01z"/><path d="M.1 22.88c0 4.65.02 6.78.07 6.99.23 1.01 1.11 1.84 2.24 2.08.58.13 26.53.13 27.18 0 1.13-.22 2.05-1.06 2.28-2.08.08-.35.1-13.69.02-13.66-.02.01-3.03 1.85-6.68 4.1s-6.83 4.18-7.08 4.29c-.68.32-1.27.44-2.11.44s-1.42-.12-2.11-.44c-.25-.11-3.43-2.04-7.08-4.29s-6.65-4.1-6.68-4.1C.12 16.2.1 19.2.1 22.88z"/>
                        </svg>
                    </div>
                    <div class="small-12 medium-11 large-11 cell">
                        <p class="open-sans adresse-mel">{{courriel}}</p>
                    </div>
                </div>

                {# Mes privileges #}
                <div class="grid-x display-flex flex-align-items-center">
                    <div class="small-12 medium-1 large-1 cell">
                        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="role-svg" width="100%" height="100%"
                            viewbox="0 0 32 32" aria-hidden="true" focusable="false">
                            <title>Rôle utilisateur</title>
                            <desc>Affiche les rôles applicatifs de l'utilisateur.</desc>

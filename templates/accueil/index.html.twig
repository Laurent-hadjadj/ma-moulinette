<html lang="fr">

  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('accueil') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><span class="show-for-sr">Vous êtes sur la page :</span>Accueil</li>
        </ol>
      </nav>
    </header>

    {# Gestion des messages flash & JS #}
    <header>
      {% set unique_messages = [] %}
      {% for message in app.flashes('notice') %}
        {% set already_added = false %}

        {% for unique_message in unique_messages %}
            {% if unique_message.titre == message.titre and unique_message.message == message.message %}
                {% set already_added = true %}
            {% endif %}
        {% endfor %}

        {% if not already_added %}
          {% set unique_messages = unique_messages|merge([message]) %}
      <div class="callout {{ message.type }} alert-callout-border callout-ombre js-flash-box" role="alert" data-closable>
        <p class="open-sans text-justify callout-message">
            <strong>{{ message.titre }}</strong> {{ message.message }}
        </p>
        <button class="close-button {{message.type}}"
                type="button"
                aria-label="Dismiss alert" data-close><span aria-hidden="true">&times;</span>
        </button>
      </div>
        {% endif %}
      {% endfor %}

      {# Message d'information JS#}
      <div id="message-box" class="callout alert-callout-border callout-ombre hide" role="alert" data-closable>
          <button id="message-button-close" class="close-button" aria-label="Close alert" type="button" data-close>
          <span aria-hidden="true">&times;</span>
          </button>
          <p id="message-text"></p>
      </div>
    </header>

    <main class="grid-container margin-bottom-1" role="main">
      <h1 class="h3 claire-hand" aria-label="Informations et outils">
        <span aria-hidden="true" class="emoji">🏠</span> Informations et outils
      </h1>

      <div id="container-information" class="grid-x cell">
        {# Information référentiel #}
        <section class="small-12 medium-6 large-6 cell">
          <div id="container-information-referential">
            <fieldset class="fieldset fieldset-projet cell">
              <legend class="open-sans">Référentiel local.</legend>
              <div class="referential-container">
                <!-- Mise à jour de référentiel des projets SonarQube -->
                  {% if refresh_bd is same as(true) %}
                    {% set statut="" %}
                  {% else %}
                    {% set statut="bouton-disabled" %}
                  {% endif %}
                  <button id="bouton-mise-a-jour-referential"
                          class="button open-sans {{ statut }} focus-dark-light"
                          aria-label="Mise à jour du référentiel">
                      <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="refresh-bd-svg"
                            width="100%" height="100%" viewbox="0 0 32 32" aria-hidden="true">
                        <path d="M14.725-.216C9.381.261 4.701 2.934 1.767 7.19 1.217 7.99.33 9.654.23 10.073c-.296 1.213.349 2.464 1.537 2.979 1.088.476 2.29.26 3.109-.56.268-.266.47-.57.799-1.212 1.134-2.198 2.76-3.836 4.935-4.973 3.384-1.766 7.593-1.804 10.964-.095.597.298 1.611.927 1.611.997 0 .025-.336.095-.752.152-1.215.172-1.598.432-1.652 1.13-.033.433.108.756.417.972.342.242 8.768 3.798 9.084 3.837.524.057 1.074-.312 1.229-.82.033-.108.067-2.267.074-4.795l.006-4.592-.161-.273c-.349-.603-1.255-.75-1.793-.286-.087.077-.423.521-.752.978-.329.464-.617.845-.637.845-.02 0-.242-.178-.484-.387C25.61 2.096 22.796.712 19.895.102c-1.457-.305-3.72-.445-5.17-.318zM1.512 18.781a1.139 1.139 0 00-.618.698c-.033.108-.067 2.267-.074 4.795l-.006 4.592.16.273c.35.604 1.256.75 1.793.286.088-.076.423-.52.752-.978.33-.464.618-.845.638-.845.02 0 .242.178.484.388 1.826 1.587 4.236 2.883 6.606 3.55a18.071 18.071 0 0012.341-.896c3.485-1.568 6.284-4.191 8.023-7.52.524-1.003.638-1.32.638-1.841 0-1.626-1.638-2.915-3.283-2.579-1.014.204-1.591.718-2.236 1.975-1.134 2.198-2.76 3.837-4.935 4.973-3.384 1.766-7.593 1.804-10.964.096-.597-.299-1.611-.928-1.611-.997 0-.026.335-.096.752-.153 1.215-.171 1.598-.432 1.651-1.13.034-.432-.107-.756-.416-.972-.114-.083-2.142-.972-4.505-1.975-3.008-1.283-4.384-1.836-4.6-1.855a1.02 1.02 0 00-.59.115z"/>
                      </svg>
                      <span class="show-for-small-only open-sans color-blanc">Projets</span>
                      <span class="show-for-medium-only open-sans color-blanc">Projets</span>
                      <span class="show-for-large open-sans color-blanc">Mise à jour des projets</span>
                  </button>
                  <div class="result-projet">
                    <span id="js-nombre-projet" class="stat-projet">{{projet_bd|format_number}}</span>
                    {# Plus de projet en local que sur le serveur #}
                    {% set difference = projet_bd - projet_sonar %}
                    {% if difference > 0 %}
                      <span id="js-plus" class="plus">
                        <strong>-{{difference}}</strong>
                      </span>
                    {% endif %}
                    {# Moins de projet en local que sur le serveur #}
                    {% if difference < 0 %}
                      <span id="js-moins" class="moins">
                        <strong>+{{difference|abs}}</strong>
                      </span>
                    {% endif %}
                  </div>
              </div>

              {# Profil qualité #}
              <div class="referential-container">
                <a id="bouton-profil-quality"
                  href="{{ path('profil', {}) }}"
                  class="button open-sans focus-dark-light"
                  aria-label="Accéder à la page des profils qualité SonarQube.">
                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"
                          viewbox="0 0 32 32" class="profil-quality-svg" aria-hidden="true">
                      <path d="M16.351.627C7.494.627.556 3.415.556 6.973c0 3.559 6.938 6.346 15.795 6.346s15.795-2.787 15.795-6.346c0-3.558-6.938-6.346-15.795-6.346zm0 11.635c-7.848 0-14.479-2.423-14.479-5.289 0-2.866 6.63-5.288 14.479-5.288 7.848 0 14.479 2.422 14.479 5.288 0 2.867-6.63 5.289-14.479 5.289z"/><path d="M30.83 6.973v4.76c0 2.866-6.63 5.288-14.479 5.288-7.848 0-14.479-2.422-14.479-5.288v-4.76H.556v4.76c0 3.558 6.938 6.346 15.795 6.346s15.795-2.788 15.795-6.346v-4.76z"/><path d="M30.83 11.733v4.76c0 2.866-6.63 5.288-14.479 5.288-7.848 0-14.479-2.422-14.479-5.289v-4.76H.556v4.76c0 3.56 6.938 6.347 15.795 6.347s15.795-2.788 15.795-6.347v-4.76z"/><path d="M30.83 16.492v4.76c0 2.867-6.63 5.289-14.479 5.289-7.848 0-14.479-2.422-14.479-5.289v-4.76H.556v4.76c0 3.559 6.938 6.346 15.795 6.346s15.795-2.787 15.795-6.346v-4.76z"/><path d="M30.83 21.252v4.76c0 2.867-6.63 5.288-14.479 5.288-7.848 0-14.479-2.421-14.479-5.288v-4.76H.556v4.76c0 3.558 6.938 6.346 15.795 6.346s15.795-2.788 15.795-6.346v-4.76z"/>
                    </svg>
                    <span class="show-for-small-only open-sans color-blanc">Profils qualités</span>
                    <span class="show-for-medium-only open-sans color-blanc">Profils qualités</span>
                    <span class="show-for-large open-sans color-blanc">Profils qualités SonarQube</span>
                </a>
                <div class="result-profil">
                    <span id="js-nombre-profil" class="stat-profil">{{profil_bd|format_number}}</span>
                    {% set difference = profil_bd - profil_sonar %}
                    {% if difference > 0 %}
                      <span id="profil-en-plus" class="plus">
                        <strong>-{{difference}}</strong>
                      </span>
                    {% endif %}
                    {% if difference < 0 %}
                      <span id="profil-en-moins" class="moins">
                        <strong>+{{difference|abs}}</strong>
                      </span>
                    {% endif %}
                </div>
              </div>
            </fieldset>
            <div class="referential-filler"><span class="color-noir font-size-09">Note : Mise à jour des projets et des profils qualités SonarQube.</div>
          </div>

        </section>

        {# Information projet #}
        <section class="small-12 medium-6 large-6 cell">
          <div id="container-information-projet">
            {# Nombre de projet | tags #}
            <fieldset class="fieldset fieldset-tag cell">
              <legend class="open-sans fieldset-legend-custom">Tags.
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="bulle-information-svg" width="100%" height="100%" viewbox="0 0 32 32" data-open="modal-information-tag">
                  <title>Icône pour le bouton Information Tags</title>
                  <desc>Affiche une une fenêtre d'information sur les TAGS.</desc>
                  <path d="M13.987.084C7.44.943 2.136 5.614.482 11.974.056 13.599 0 14.098 0 16.089s.056 2.49.482 4.116c.293 1.14.614 1.998 1.172 3.13.614 1.246.607 1.323-.125 3.272L.97 28.084v.704c0 .668.014.724.237 1.147.287.527.72.95 1.25 1.195.349.17.481.19 1.06.183.629 0 .748-.028 2.269-.52 2.087-.683 2.17-.683 3.35-.127a16.5 16.5 0 004.293 1.358c1.033.183 3.315.218 4.487.077 4.614-.57 8.76-3.144 11.37-7.077.635-.95 1.508-2.758 1.864-3.848.551-1.696.795-3.25.795-5.087-.007-1.878-.244-3.362-.83-5.135-1.34-4.06-4.32-7.486-8.16-9.357C21.49.879 20.256.478 18.594.176c-1.04-.183-3.517-.24-4.606-.092zm3.56 2.216c2.575.324 5.116 1.407 7.063 3.004 5.856 4.812 6.784 13.508 2.08 19.432-2.625 3.306-6.561 5.213-10.749 5.213-2.108 0-3.964-.437-6.114-1.429-1.528-.71-2.066-.71-4.3-.007-1.856.591-2.1.648-2.247.528a.387.387 0 01-.111-.26c0-.092.23-.788.516-1.555.552-1.506.67-1.935.67-2.512 0-.696-.14-1.181-.663-2.293-.726-1.555-1.103-2.702-1.375-4.221-.125-.71-.125-3.51 0-4.221.265-1.492.621-2.617 1.236-3.905a13.795 13.795 0 0110.685-7.767c.691-.084 2.618-.091 3.309-.007z"/><path d="M15.439 8.653c-1.2.345-1.745 1.857-1.026 2.856.684.957 1.92 1.098 2.778.317a1.85 1.85 0 00-.007-2.737 1.827 1.827 0 00-1.745-.436zm.049 5.284a1.19 1.19 0 00-.587.626c-.049.133-.076 1.695-.076 4.734 0 4.376.007 4.545.14 4.805.397.795 1.556.788 1.96 0 .133-.267.133-.4.119-4.91-.02-4.559-.02-4.643-.167-4.833a1.798 1.798 0 00-.322-.331c-.237-.176-.788-.225-1.067-.091z"/>
                </svg>
              </legend>
              <div class="grid-x cell">
                <div class="small-12 medium-6 large-6 cell">
                  <div class="container-stat visibility-box tag-box-projet">
                    <span class="titre-stat">Projet</span>
                    <span id="js-tag-projet" class="stat-projet">{{nombre_projet_local}}</span>
                  </div>
                </div>
                <div class="small-12 medium-6 large-6 cell">
                  {# si le nombre de tags est plus petit que le nombre de projet, alors
                  cela veut dire qu'il y a des projets qui ne seront pas rattachés à une équipe et ils ne seront pas visible pour les utilisateurs #}
                  {% if nombre_tag < nombre_projet_local %}
                    {% set statut_tag='couleur-rouge' %}
                  {% else %}
                    {% set statut_tag='couleur-vert' %}
                  {% endif %}
                  <div class="container-stat visibility-box tag-box-tag">
                    <span class="titre-stat">Tags</span>
                    <span id="js-tag-nombre" class="stat-tag {{statut_tag}}">{{nombre_tag}}</span>
                  </div>
                </div>
              </div>
            </fieldset>

            {# Nombre de projet PUBLIC | PRIVATE #}
            <fieldset class="fieldset fieldset-visibility cell">
              <legend class="open-sans">Visibilité.</legend>
              <div class="grid-x cell">
                <div class="small-12 medium-6 large-6 cell">
                  <div class="container-stat visibility-box visibility-box-public">
                    <span class="titre-stat">Public</span>
                    <span id="js-public" class="stat-visibility">{{public}}</span>
                  </div>
                </div>

                <div class="small-12 medium-6 large-6 cell">
                  <div class="container-stat visibility-box visibility-box-private">
                    <span class="titre-stat">Privé</span>
                    <span id="js-private" class="stat-visibility">{{ private }}</span>
                  </div>
                </div>
              </div>
            </fieldset>
          </div>
        </section>
      </div>
      <div class="cell">
      {% for message in app.flashes('info') %}
        <div class="callout alert-callout-border {{message.type}} callout-ombre cell"
              role="alert" data-closable>
          <p class="open-sans text-justify callout-message">
            <strong>{{message.titre}}</strong>{{ message.message }}<strong>{{message.ref}}</strong>.</p>
          <button class="close-button {{message.type}}"
                  type="button"
                  aria-label="Dismiss alert"
                  data-close><span aria-hidden="true">&times;</span>
          </button>
        </div>
      {% endfor %}
      </div>
    </main>


    {# On choisi le composant en fonction des préférences #}
    {% if composant == 'projet' and favori|length > 0 %}
      {{ include('/accueil/_projet.html.twig') }}
    {% elseif composant == 'version' and favori|length > 0 %}
      {{ include('/accueil/_version.html.twig') }}
    {% else %}
      {{ include('/accueil/_vide.html.twig') }}
    {% endif %}

    <footer class="grid-x grid-margin-x align-right margin-top-2">
      <div class="cell shrink">
        <a href="{{ path('projet') }}"
            id="bouton-ouvrir-projet"
            class="button focus-light"
            title="Accéder à la page du projet"
            aria-label="Accéder à la page Mon projet">
              <svg version="1.1" xmlns="http://www.w3.org/2000/svg" class="mon-projet-svg" width="100%" height="100%" viewbox="0 0 32 32" aria-hidden="true">
                <path d="M30.764 12.214H18.271a.986.986 0 010-1.973h12.493a.986.986 0 010 1.973zm0 3.945H18.271a.986.986 0 010-1.973h12.493a.986.986 0 010 1.973zm0 3.945H18.271a.986.986 0 010-1.973h12.493a.986.986 0 010 1.973zm0 3.945H18.271a.986.986 0 010-1.972h12.493a.986.986 0 010 1.972zm0 3.945H18.271a.986.986 0 010-1.972h12.493a.986.986 0 010 1.972zm-18.41-7.89H2.49A2.304 2.304 0 01.19 17.803v-5.26A2.304 2.304 0 012.49 10.24h9.863a2.304 2.304 0 012.302 2.301v5.26a2.304 2.304 0 01-2.302 2.302zm-9.864-7.89a.329.329 0 00-.328.328v5.26c0 .182.147.33.328.33h9.863a.329.329 0 00.33-.33v-5.26a.329.329 0 00-.33-.328zm9.863 19.726H2.49A2.304 2.304 0 01.19 29.638v-5.26a2.304 2.304 0 012.301-2.301h9.863a2.304 2.304 0 012.302 2.3v5.261a2.304 2.304 0 01-2.302 2.302zM2.49 24.05a.329.329 0 00-.328.328v5.26c0 .182.147.329.328.329h9.863a.329.329 0 00.33-.329v-5.26a.329.329 0 00-.33-.329zm28.274 7.89H18.271a.986.986 0 010-1.973h12.493a.986.986 0 010 1.973zM29.45 8.268H13.011a2.304 2.304 0 01-2.301-2.3V2.678a2.304 2.304 0 012.3-2.3h16.44a2.304 2.304 0 012.3 2.3v3.288a2.304 2.304 0 01-2.3 2.301zM13.011 2.351a.329.329 0 00-.329.328v3.288c0 .182.147.329.329.329h16.438a.329.329 0 00.329-.329V2.68a.329.329 0 00-.329-.328zM4.134 8.268A3.95 3.95 0 01.19 4.323 3.95 3.95 0 014.134.378 3.95 3.95 0 018.08 4.323a3.95 3.95 0 01-3.945 3.945zm0-5.917a1.975 1.975 0 00-1.972 1.972c0 1.088.885 1.973 1.972 1.973a1.975 1.975 0 001.973-1.973 1.975 1.975 0 00-1.973-1.972z"/>
              </svg>
              <span class="open-sans color-blanc no-select">Mon projet</span>
        </a>
      </div>
    </footer>

    {# Affichage de la note d'information sur les Tags #}
    {{ include('/accueil/_modal_information_tag.html.twig') }}

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

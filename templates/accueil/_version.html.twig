  <div class="grid-container grid-padding-x">
    <fieldset class="fieldset fieldset-container js-versions cell">
      <legend class="open-sans">Mes projets par version (<strong>{{nombre_projet_favori}}</strong>).</legend>
      {% if nombre_projet_favori > 0 %}
        <p class="open-sans">
          <span class="lead color-reliability"><strong>F</strong><span>iabilité -
          <span class="lead color-security"><strong>S</strong></span>écurité -
          <span class="lead color-hotspot"><strong>H</strong></span>otspot -
          <span class="lead color-code-smell"><strong>M</strong></span>aintenabilité
        </p>
        <div class="grid-x cell">
          {# Information sur les versions #}
          {% set n,m = 0,0 %}
          {% for apps in favori %}
            {% if m > 0 %}
              <div class="grid-x cell"></div>
            {% endif %}
            {% set m = m + 1 %}
            {% for app in apps.version %}
              {% set n = n + 1 %}
              <div class="callout callout-information">
                <div class="callout-body">
                  <h1 class="h5 claire-hand text-center">Informations
                    <button aria-label="Ouvre la page de suivi du projet" rel="link">
                      <svg id="raccourci-{{m}}{{n}}"version="1.1" xmlns="http://www.w3.org/2000/svg"
                        width="100%" height="100%" viewbox="0 0 32 32" class="tableau-de-board-svg" data-mavenkey="{{app.mavenkey}}">
                        <title>Icône pour le bouton Suivi du Projet</title>
                        <desc>Ouvre la page de suivi du projet.</desc>

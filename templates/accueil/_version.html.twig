-.158v4.03h-9.509v-.515c0-.457.013-.49.086-.345.119.239.383.351.62.265.1-.04.456-.344.793-.675l.608-.609.429.41c.462.444.693.517.95.292.074-.06.45-.537.833-1.06l.707-.94h.746c.62 0 .772-.02.885-.118.072-.06.376-.53.673-1.033l.548-.92.35.702c.198.383.416.734.482.774zM3.345 21.348a.517.517 0 00-.165.364c0 .126.06.265.165.364l.158.166H14.48l.158-.166a.487.487 0 000-.728l-.158-.165H3.503zm0 2.118a.516.516 0 00-.165.364c0 .126.06.265.165.364l.158.166H14.48l.158-.166a.487.487 0 000-.728l-.158-.165H3.503zm0 2.118a.516.516 0 00-.165.364c0 .126.06.265.165.364l.158.166H14.48l.158-.166a.487.487 0 000-.728l-.158-.165H3.503zm0 2.118a.516.516 0 00-.165.364c0 .126.06.265.165.364l.158.166h8.334l.159-.166a.517.517 0 00.165-.364.517.517 0 00-.165-.364l-.159-.165H3.503zm10.037 0a.516.516 0 00-.165.364c0 .126.06.265.165.364.14.146.218.166.628.166.41 0 .489-.02.627-.166a.517.517 0 00.165-.364.517.517 0 00-.165-.364c-.138-.145-.218-.165-.627-.165-.41 0-.489.02-.628.165z"/>
                    </svg>
                  </h1>
                </div>
                <div class="callout-footer open-sans">
                  {% if app.nom|length >20 %}
                    {% set taille="nom-small" %}
                  {% else %}
                    {% set taille="nom-normal" %}
                  {% endif %}
                  <p class="ligne-favori open-sans">Nom&nbsp;:
                    <span class="float-right result-favori {{taille}}">{{app.nom}}</span>
                  </p>
                  <p class="ligne-favori open-sans">Version&nbsp;:
                    <span class="float-right result-favori">{{app.version}}</span>
                  </p>
                  <p class="ligne-favori open-sans">Date&nbsp;:
                    <span class="float-right result-favori">{{app.date|date("d/m/Y", "Europe/Paris")}}</span>
                  </p>
                  <table aria-label="tableau-favori">
                    <thead>
                      <tr>
                        <th scope="col">
                          <span class="note-favori color-reliability">&nbsp;F&nbsp;</span>
                        </th>
                        <th scope="col">
                          <span class="note-favori color-security">&nbsp;S&nbsp;</span>
                        </th>
                        <th scope="col">
                          <span class="note-favori color-hotspot">&nbsp;H&nbsp;</span>
                        </th>
                        <th scope="col">
                          <span class="note-favori color-code-smell">&nbsp;M&nbsp;</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr scope="row">
                        <td>
                          <span id="note-reliability" class="open-sans">
                            <span class="note note-{{app.reliability|lower}}">{{app.reliability}}</span>
                          </span>
                        </td>
                        <td>
                          <span id="note-security" class="open-sans">
                            <span class="note note-{{app.security|lower}}">{{app.security}}</span>
                          </span>
                        </td>
                        <td>
                          <span class="open-sans">
                            <span class="note note-{{app.hotspot|lower}}">{{app.hotspot}}</span>
                          </span>
                        </td>
                        <td>
                          <span class="open-sans">
                            <span class="note note-{{app.sqale|lower}}">{{app.sqale}}</span>
                          </span>
                        </td>
                      </tr>
                      <tr scope="row">
                        <td>
                          <span class="nombre-favori open-sans">
                            {% if app.bug < 10 %}
                              00{{app.bug}}
                            {% endif %}
                            {% if app.bug >= 10 and app.bug < 100 %}
                              0{{app.bug}}
                            {% endif %}
                            {% if app.bug >= 100 and app.bug < 1000 %}
                              {{app.bug}}
                            {% endif %}
                            {% if app.bug >= 1000 and app.bug < 100000 %}
                              {% set k = (app.bug / 1000)|number_format(1, '.', ',') %}
                              {{k}}K
                            {% endif %}
                          </span>
                        </td>
                        <td>
                          <span class="nombre-favori open-sans">
                            {% if app.vulnerability < 10 %}
                              00{{app.vulnerability}}
                            {% endif %}
                            {% if app.vulnerability >= 10 and app.vulnerability <100%}
                              0{{app.vulnerability}}
                            {% endif %}
                            {% if app.vulnerability >=100 and app.vulnerability <1000 %}
                              {{app.vulnerability}}
                            {% endif %}
                            {% if app.vulnerability >=1000 and app.vulnerability <100000 %}
                              {% set k=(app.vulnerability/1000)|number_format(1, '.', ',') %}
                              {{k}}K
                            {% endif %}
                          </span>
                        </td>
                        <td>
                          <span class="nombre-favori open-sans">
                            {% if app.hotspots <10 %}
                              00{{app.hotspots}}
                            {% endif %}
                            {% if app.hotspots >=10 and app.hotspots <100 %}
                              0{{app.hotspots}}
                            {% endif %}
                            {% if app.hotspots >=100 and app.hotspots <1000 %}
                              {{app.hotspots}}
                            {% endif %}
                            {% if app.hotspots >=1000 and app.hotspots <100000 %}
                              {% set k=(app.hotspots/1000)|number_format(1, '.', ',') %}
                              {{k}}K
                            {% endif %}
                          </span>
                        </td>
                        <td>
                          <span class="nombre-favori open-sans">
                            {% if app.code_smell <10 %}
                              00{{app.code_smell}}
                            {% endif %}
                            {% if app.code_smell >=10 and app.code_smell <100%}
                              0{{app.code_smell}}
                            {% endif %}
                            {% if app.code_smell >=100 and app.code_smell <1000 %}
                              {{app.code_smell}}
                            {% endif %}
                            {% if app.code_smell >=1000 and app.code_smell <100000 %}
                              {% set k=(app.code_smell/1000)|number_format(1, '.', ',') %}
                              {{k}}K</span>
                          {% endif %}
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}
    </fieldset>
  </div>

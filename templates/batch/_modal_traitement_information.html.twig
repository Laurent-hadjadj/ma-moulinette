{# ────────────────────────────────────────
Affichage des informations du traitement.
------------------------------------------------
BLOC : header   → titre + bouton de fermeture
BLOC : body     → contenu principal
BLOC : footer   → actions / bouton fermer
------------------------------------------------
#}
<dialog id="modal-traitement-information"
        class="reveal large"
        data-reveal
        aria-modal="true"
        data-close-on-click="true"
        data-animation-in="fade-in"
        data-animation-out="fade-out"
        aria-label="Information sur le traitement">

    {# ------- Header (titre) ------- #}
    <header>
        <h2 class="h3 claire-hand header-h1">
            <span aria-hidden="true">ℹ️</span>Information
        </h2>
        <h3 class="h4 claire-hand header-h2">
            <span aria-hidden="true">📌</span>
            <span class="js-nom-traitement"></span>
        </h3>
    </header>

    <section>
        <div class="batch-info grid-x grid-margin-x">
            <div class="small-12 cell">
                <p class="open-sans"><strong>Référence :</strong> <span class="js-reference color-noir">--</span></p>
                <p class="open-sans"><strong>Portefeuille :</strong> <span class="js-portefeuille color-noir">--</span>
                </p>
            </div>
        </div>

        <div class="batch-info-tiles grid-x grid-margin-x grid-margin-y">
            <div class="small-6 medium-4 large-2 cell">
                <div class="info-tile">
                    <span class="info-tile-title">Nombre de projets</span>
                    <span class="info-tile-divider" aria-hidden="true"></span>
                    <span class="info-tile-value js-nombre-projet">--</span>
                </div>
            </div>
            <div class="small-6 medium-4 large-2 cell">
                <div class="info-tile">
                    <span class="info-tile-title">Mode de collecte</span>
                    <span class="info-tile-divider" aria-hidden="true"></span>
                    <span class="info-tile-value js-mode-collecte">--</span>
                </div>
            </div>
            <div class="small-6 medium-4 large-2 cell">
                <div class="info-tile">
                    <span class="info-tile-title">Durée</span>
                    <span class="info-tile-divider" aria-hidden="true"></span>
                    <span class="info-tile-value js-time-elapse">--</span>
                </div>
            </div>
            <div class="small-6 medium-4 large-3 cell">
                <div class="info-tile js-statut-tile">
                    <span class="info-tile-title">Résultat</span>
                    <span class="info-tile-divider" aria-hidden="true"></span>
                    <span class="info-tile-value js-statut">--</span>
                </div>
            </div>
            <div class="small-6 medium-4 large-3 cell">
                <div class="info-tile js-activated-tile">
                    <span class="info-tile-title">Activé</span>
                    <span class="info-tile-divider" aria-hidden="true"></span>
                    <span class="info-tile-value js-activated">--</span>
                </div>
            </div>
            <div class="small-12 timeline-container cell">
                <h4 class="h5 claire-hand"><span aria-hidden="true">⏱️</span> Timeline</h4>
                <div class="timeline">
                    <div class="timeline-start"><span class="js-start-at">--</span></div>
                    <div class="timeline-bar">
                        <div class="timeline-progress"></div>
                    </div>
                    <div class="timeline-end"><span class="js-end-at">--</span></div>
                </div>
                <div class="timeline-progress-legend">
                    <span class="open-sans timeline-legend-title">Taux de réussite (succès + déjà à jour) :</span>
                    <span class="timeline-legend-item"><span class="timeline-legend-dot timeline-legend-dot-ok" aria-hidden="true"></span> ≥ 80 %</span>
                    <span class="timeline-legend-item"><span class="timeline-legend-dot timeline-legend-dot-warning" aria-hidden="true"></span> 40-79 %</span>
                    <span class="timeline-legend-item"><span class="timeline-legend-dot timeline-legend-dot-error" aria-hidden="true"></span> &lt; 40 %</span>
                </div>
                <div class="timeline-summary">
                    <span class="text-success">✔️ <span class="js-nb-ok"></span> succès</span>
                    <span class="text-error">❌ <span class="js-nb-ko"></span> erreur(s)</span>
                    <span class="text-muted">⁉️ <span class="js-nb-oko"></span> déjà à jour</span>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="journal-selector-container margin-top-2">
            <h4 class="h5 claire-hand">
                <span aria-hidden="true">📘</span> Consulter un journal d'exécution
            </h4>

            <label for="select-journal" class="open-sans">Choisir un projet :</label>
            <select id="select-journal" class="js-select-journal width-100-percent">
                <option value="">-- Sélectionner un projet --</option>
            </select>
        </div>

    </section>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-information" class="button open-sans focus-dark-light" type="button"
                aria-label="Ferme la fenêtre"><span aria-hidden="true">❌</span> Fermer
            </button>
        </div>
    </footer>
</dialog>

{# Deuxième modale, pour le contenu du journal.
Déclarée en dehors de #modal-traitement-information : Foundation Reveal ne gère pas
une modale imbriquée dans une autre. #}
<dialog id="modal-journal" class="reveal large" data-reveal aria-modal="true" data-close-on-click="true"
    aria-label="Journal d'exécution">
    <header>
        <h3 class="h4 claire-hand">
            <span aria-hidden="true">📓</span>
            Journal d'exécution – <span class="js-journal-nom"></span>
        </h3>
    </header>

    <section class="journal-content journal-content-section js-journal-content open-sans">
        <p class="text-center text-muted">Aucun journal chargé.</p>
    </section>

    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button id="bouton-fermer-journal" class="button secondary open-sans focus-dark-light" type="button"
                aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span> Fermer
            </button>
        </div>
    </footer>
</dialog>

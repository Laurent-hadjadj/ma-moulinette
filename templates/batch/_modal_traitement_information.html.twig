    {# Affichage des informations du traitement. #}
    <div id="modal-traitement-information" class="reveal large" data-reveal data-close-on-click="true" aria-modal="true">
      <h1 class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Information du l'execution du traitement</h1>
      <h2 class="h4 claire-hand"><span aria-hidden="true">📌</span><span class="js-nom-traitement"></span></h2>

      <div class="batch-info grid-x grid-margin-x">
        <div class="cell small-12 medium-6">
            <span><strong>Portefeuille      :</strong> <span class="js-portefeuille badge info">--</span></span><br>
            <span><strong>Nombre de projets :</strong> <span class="js-nombre-projet badge secondary">--</span></span><br>
            <span><strong>Mode de collecte  :</strong> <span class="js-mode-collecte badge warning">--</span></span>
        </div>
        <div class="cell small-12 medium-6">
            <span><strong>Durée  :</strong> <span class="js-time-elapse badge">--</span></span><br>
            <span><strong>Statut :</strong> <span class="js-statut badge">--</span></span><br>
            <span><strong>Activé :</strong> <span class="js-activated badge">--</span></span>
        </div>
      </div>

      <div class="timeline-container">
        <h3 class="h5 claire-hand"><span aria-hidden="true">⏱️</span> Timeline</h3>
        <div class="timeline">
            <div class="timeline-start"><span class="js-start-at">--</span></div>
            <div class="timeline-bar"><div class="timeline-progress"></div></div>
            <div class="timeline-end"><span class="js-end-at">--</span></div>
        </div>
      </div>

      <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
          <button id="bouton-fermer-information" data-close
                  class="button open-sans focus-light"
                  type="button"
                  aria-label="Ferme la fenêtre"><span arial-hidden="true">❌</span> Fermer
          </button>
      </footer>
    </div>

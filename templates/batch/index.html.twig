              {% else %}
                {# Pas de traitement, liste vide #}
                <tr class="open-sans text-center">
                  <td id="n-execution-{{i}}">--</td>
                  <td id="n-success-{{i}}">--</td>
                  <td id="n-responsable-{{i}}">--</td>
                  <td id="n-portefeuille-{{i}}">--</td>
                  <td id="n-projet-{{i}}">--</td>
                  <td id="n-time-{{i}}">--</td>
                  <td id="n-outil-{{i}}">--</td>
                </tr>
              {% endif %}

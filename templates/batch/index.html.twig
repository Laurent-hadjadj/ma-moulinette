          </tbody>
        </table>
      </div>
      {% if is_granted('ROLE_BATCH') %}
      <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
          <button id="bouton-traitement-automatique"
                  class="button open-sans focus-light"
                  type="button"
                  aria-label="Traitement automatique"
                  data-session="{{csrf_token(salt)}}">Traitement automatique
          </button>
        </div>
        <div class="cell shrink">
          <button id="bouton-affiche-rapport"
                  class="button open-sans focus-light"
                  type="button"
                  aria-label="Liste des rapports">Liste des rapports
          </button>
        </div>
      </footer>
      {% endif %}
      {# Fin du container #}

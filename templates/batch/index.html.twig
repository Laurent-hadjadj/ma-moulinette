                    {% endif %}
                    <span class="show-for-medium"><br>{{traitement.mode_collecte}}</span>
                  </td>
                  <td id="result-{{i}}"
                      class="text-center span {{traitement.css}}">
                    <span class="show-for-small-only">
                      <strong>
                        {% if traitement.message == "Erreur" %}KO
                        {% endif %}
                        {% if traitement.message == "Succès" %}OK
                        {% endif %}
                        {% if traitement.message == "---" %}
                          {{traitement.message}}
                        {% endif %}
                      </strong>
                    </span>
                    <span class="show-for-medium">
                      <strong>{{traitement.message}}</strong>
                    </span>
                  </td>
                  <td id="responsable-{{i}}"
                      class="text-left">
                      <div class="user-badge">
                        <span class="avatar-circle avatar-color-{{traitement.color}}"></span>
                        <span>{{traitement.initiales}}</span>
                        <span>{{traitement.nom}}</span>
                    </div>
                  </td>
                  <td id="portefeuille-{{i}}"
                      class="text-left"
                    data-titre="{{traitement.titre}}">{{traitement.portefeuille}}
                    </td>
                  <td id="projet-{{i}}"
                      class="text-center">{{traitement.projet}}</td>
                  <td id="temps-execution-{{i}}"
                      class="text-center">
                    {% if traitement.execution != "--:--.--" %}
                      {{traitement.execution|format_datetime('none', 'medium', locale='fr')}}
                    {% else %}
                      {{traitement.execution}}
                    {% endif %}

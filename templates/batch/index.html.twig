{% set title = 'La collecteuse.' %}
{% set description = 'Tableau de suivi des traitements de masse. Collecte des données par portefeuille de projets.' %}
{% set type_content = "Application Ma-Moulinette, tableau de suivi des traitements de masse." %}
{% set bottom = "footer-fixed" %}
<!DOCTYPE html>
<!--
.. __  __             __  __             _ _            _   _
  |  \/  | __ _      |  \/  | ___  _   _| (_)_ __   ___| |_| |_ ___
  | |\/| |/ _` |_____| |\/| |/ _ \| | | | | | '_ \ / _ \ __| __/ _ \
  | |  | | (_| |_____| |  | | (_) | |_| | | | | | |  __/ |_| ||  __/

    {# Affichage de la liste des traitements pour un job. #}
    <div id="modal-information" class="reveal" data-reveal data-close-on-click="true" aria-modal="true">
      <h1 class="h3 claire-hand">Journal d'Audit</h1>
      <h2 id="js-nom-projet" class="h4 claire-hand">&nbsp;</h2>
      {# Éditeur TinyMCE #}
      <textarea id="js-journal" class="tinymce" name="textarea"></textarea>

      {# fermeture de la fenêtre modale #}
      <button id="fermer-traitement-liste" class="expanded button open-sans" data-close aria-label="Close reveal" type="button">Fermer
      </button>
      <a class="close-button" data-close aria-label="Close reveal">&#215;</a>
    </div>

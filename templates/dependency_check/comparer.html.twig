{% set title = 'OWASP Dependency-Check - Comparer' %}
{% set description = 'Ma Moulinette - comparaison side-by-side de plusieurs applications.' %}
{% set bottom = 'footer-fixed' %}

{# MODIF 2026-05-13 : page comparateur multi-apps. #}
<!DOCTYPE html>

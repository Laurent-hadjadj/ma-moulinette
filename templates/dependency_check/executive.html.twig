{% set title = 'OWASP DC - Vue exécutive - ' ~ project_artifact %}
{% set description = 'Ma Moulinette - rapport exécutif scan DependencyCheck.' %}
{% set bottom = 'footer-fixed' %}
{# MODIF 2026-05-09 : page exécutive prise de
décision pour un scan DependencyCheck.
11 sections : contexte, vue globale, sévérité, familles, top deps,
radar CWE, CVE prioritaires, table CVE→Décision, plan de remédiation,
diff vs scan précédent, top 5 actions. #}

<!DOCTYPE html>
<!--

{% set title = 'OWASP Dependency-Check - KPIs' %}
{% set description = 'Ma Moulinette - KPIs et pilotage SLA du module DependencyCheck.' %}
{% set bottom = 'footer-fixed' %}

{# MODIF 2026-05-13 : page KPI niveau DSI/RSSI. Synthèse macro
  du parc + tendance 90j + top 5 risque / top 5 sain. #}

<html lang="fr">
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {% block importmap %}{{ importmap('dependency-check') }}{% endblock %}
  </head>

  <body>
    {{ include('header.html.twig') }}

    <header class="grid-container margin-top-1">
      <nav aria-label="Fil d'Ariane, vous etes ici">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('dc_index') }}">Dependency-Check</a></li>
          <li aria-current="page">{{ project_artifact }} {{ project_version }}</li>
        </ol>
      </nav>
    </header>

    {{ include('_message.html.twig') }}

    <main class="grid-container margin-bottom-2">
      <h2 class="h4 claire-hand">
        <span aria-hidden="true">🔍</span> {{ project_artifact }}
        <span class="text-muted">({{ project_group }})</span>
        &mdash; <span class="open-sans">{{ project_version }}</span>
      </h2>

      {% if scan is not null %}
      {# MODIF 2026-05-09 : bouton vers la vue exécutive
        (rapport de prise de décision.
        MODIF 2026-05-13 : bouton "Dashboard"
        ajouté pour permettre de remonter à la vue cross-projets sans passer
        par le breadcrumb (Accueil → Dependency-Check → Dashboard). #}
      <div class="cell shrink margin-bottom-1">
        <a id="bouton-ouvrir-vue-executive"
          href="{{ path('dc_projet_executive', {
                  'group': project_group,
                  'artifact': project_artifact,
                  'version': project_version}) }}"
          class="button open-sans focus-light">
          <span aria-hidden="true">🎯</span> Vue exécutive
        </a>
        <a id="bouton-ouvrir-rapport-PDF"
          href="{{ path('dc_projet_pdf', {
                  'group': project_group,
                  'artifact': project_artifact,
                  'version': project_version}) }}"
          class="button open-sans focus-light" target="_blank" rel="noopener">
          <span aria-hidden="true">📄</span> Rapport PDF
        </a>
        <a id="bouton-ouvrir-dc-dashboard"
          href="{{ path('dc_dashboard') }}"
          class="button open-sans focus-light"
          title="Retour à la vue agrégée cross-projets">
          <span aria-hidden="true">📊</span> Dashboard
        </a>
        {# MODIF 2026-05-13 : bouton vers la page d'historique de l'application (line chart + scans cumulés). #}
        <a id="bouton-ouvrir-dc-history"
          href="{{ path('dc_projet_history', {'group': project_group, 'artifact': project_artifact}) }}"
          class="button open-sans focus-light"
          title="Évolution temporelle des CVE de cette application">
          <span aria-hidden="true">📈</span> Historique
        </a>
        {# MODIF 2026-05-13 : bouton vers
          la page complète des mutualisables, pré-filtrée sur le socle du
          projet si renseigné. Si le projet est standalone (pas de socle),
          le bouton mène à la page sans filtre. #}
        {% set has_socle = scan.parentLabel is not null and scan.parentVersion is not null %}
        <a id="bouton-ouvrir-dc-mutualisables"
          href="{{ has_socle
                    ? path('dc_mutualisables', {'socle': scan.parentLabel ~ '@' ~ scan.parentVersion})
                    : path('dc_mutualisables') }}"
          class="button open-sans focus-light"
          title="{{ has_socle
                    ? 'Dépendances mutualisables avec les autres projets utilisant le socle ' ~ scan.parentLabel ~ ' v' ~ scan.parentVersion
                    : 'Toutes les dépendances mutualisables du périmètre' }}">
          <span aria-hidden="true">🔗</span> Mutualisables{{ has_socle ? ' (socle)' : '' }}
        </a>
      </div>
      {% endif %}

      {# Variables pre-calculées : valeur réelle si scan disponible, '---' sinon. #}
      {% set v_scan_date    = scan ? scan.scanDate|date('Y-m-d H:i')           : '---' %}
      {% set v_engine       = scan and scan.engineVersion ? scan.engineVersion : '---' %}
      {% set v_dep_total    = scan ? scan.depCountTotal                        : '---' %}
      {% set v_dep_vuln     = scan ? scan.depCountVulnerable                   : '---' %}
      {% set v_cve_total    = scan ? scan.cveCountTotal                        : '---' %}
      {% set v_cve_critical = scan ? scan.cveCountCritical                     : '---' %}
      {% set v_cve_high     = scan ? scan.cveCountHigh                         : '---' %}
      {% set v_cve_medium   = scan ? scan.cveCountMedium                       : '---' %}
      {% set v_cve_low      = scan ? scan.cveCountLow                          : '---' %}
      {% set v_cve_info     = scan ? scan.cveCountInfo                         : '---' %}

      {# Synthèse chiffrée — toujours rendue, '---' si pas de scan. #}
      <div class="grid-x grid-margin-x margin-bottom-1">
        <div class="cell small-12 medium-3">
          <div class="callout alert-callout-border secondary">
            <p class="open-sans"><strong>Scan du</strong></p>
            <p>{{ v_scan_date }}</p>
            <p class="text-muted">Engine: {{ v_engine }}</p>
          </div>
        </div>
        <div class="cell small-12 medium-3">
          <div class="callout alert-callout-border info">
            <p class="open-sans"><strong>Dépendances</strong></p>
            <p><strong>{{ v_dep_vuln }}</strong> vulnérables / {{ v_dep_total }} total</p>
          </div>
        </div>
        <div class="cell small-12 medium-3">
          <div class="callout alert-callout-border error">
            <p class="open-sans"><strong>CVE détectées</strong></p>
            <p><strong>{{ v_cve_total }}</strong> au total</p>
          </div>
        </div>
        <div class="cell small-12 medium-3">
          <div class="callout alert-callout-border critical">
            <p class="open-sans"><strong>Critiques</strong></p>
            <p><strong>{{ v_cve_critical }}</strong> CRITICAL / {{ v_cve_high }} HIGH</p>
          </div>
        </div>
      </div>

      <h3 class="h5 claire-hand"><span aria-hidden="true">📊</span> Repartition par sévérité</h3>
      <div class="grid-x grid-margin-x grid-margin-y severity-summary margin-bottom-1">
        <div class="cell small-12 medium-auto large-auto severity-cell">
          <span class="badge-level critical">CRITICAL</span>
          <span class="severity-count">{{ v_cve_critical }}</span>
        </div>
        <div class="cell small-12 medium-auto large-auto severity-cell">
          <span class="badge-level high">HIGH</span>
          <span class="severity-count">{{ v_cve_high }}</span>
        </div>
        <div class="cell small-12 medium-auto large-auto severity-cell">
          <span class="badge-level medium">MEDIUM</span>
          <span class="severity-count">{{ v_cve_medium }}</span>
        </div>
        <div class="cell small-12 medium-auto large-auto severity-cell">
          <span class="badge-level low">LOW</span>
          <span class="severity-count">{{ v_cve_low }}</span>
        </div>
        <div class="cell small-12 medium-auto large-auto severity-cell">
          <span class="badge-level info">INFO</span>
          <span class="severity-count">{{ v_cve_info }}</span>
        </div>
      </div>

      <h3 class="h5 claire-hand"><span aria-hidden="true">🔎</span> Liste des CVE détectées ({{ findings|length }})</h3>
      {% if findings is empty %}
        <p class="open-sans">Aucune CVE détectée.</p>
      {% else %}
          {% set severities = [
            { key: 'CRITICAL', label: 'Vulnérabilités CRITICAL', badge: 'critical' },
            { key: 'HIGH',     label: 'Vulnérabilités HIGH',     badge: 'high' },
            { key: 'MEDIUM',   label: 'Vulnérabilités MEDIUM',   badge: 'medium' },
            { key: 'LOW',      label: 'Vulnérabilités LOW',      badge: 'low' },
            { key: 'INFO',     label: 'Vulnérabilités INFO',     badge: 'info' },
            { key: 'UNKNOWN',  label: 'Sévérité inconnue',       badge: 'unknown' },
          ] %}

          {% for sev in severities %}
            {% set sev_findings = findings|filter(f => f.severity == sev.key) %}
            {% if sev_findings|length > 0 %}
              <h4 class="h5 claire-hand margin-top-1">
                {{ sev.label }}
                <span class="badge-count {{ sev.badge }}">{{ sev_findings|length }}</span>
              </h4>
              <div class="cell table-scroll">
                <table class="open-sans v-middle">
                  <thead>
                    <tr>
                      <th class="text-center">CVSS</th>
                      <th>CVE</th>
                      <th>Dépendance</th>
                      <th class="text-center">Version</th>
                      <th>CWE</th>
                      <th>Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for f in sev_findings %}
                    <tr class="v-middle">
                      <td class="text-center v-middle">{{ f.cvss is not null ? f.cvss : '-' }}</td>
                      <td class="v-middle"><strong>{{ f.cve_id }}</strong></td>
                      <td class="v-middle">{{ f.product ?: f.file_name }}</td>
                      <td class="text-center v-middle">{{ f.dep_version ?: '-' }}</td>
                      <td class="v-middle">
                        {% for cwe in f.cwes %}
                          <span class="badge-cve">{{ cwe }}</span>
                        {% endfor %}
                      </td>
                      <td class="v-middle">{{ f.description|slice(0, 200) }}{% if f.description|length > 200 %}…{% endif %}</td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      <div class="margin-bottom-2" aria-hidden="true">&nbsp;<div>
    </main>

    {{ include('footer.html.twig') }}
  </body>
</html>

<html lang="fr">
  {# Chargement de la section HEAD #}
  <head>
      <title>{{ title }}</title>
      {{ include('head.html.twig') }}
      {% block importmap %}{{ importmap('owasp') }}{% endblock %}
  </head>
  <body>
    {{ include('header.html.twig') }}

    <header class="grid-container margin-top-1">
      {# WCAG 2.4.8 : aria-label enrichi ; aria-current="page" ; <ol> pour sémantique ordonnée du fil d'Ariane #}
      <nav aria-label="Fil d'Ariane, vous êtes ici">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('projet', {}) }}">Projet</a></li>
          <li><a href="{{ path('owasp', {}) }}">Owasp</a></li>
          <li aria-current="page">{{ owasp.category }}</li>
        </ol>
      </nav>
    </header>

    {# WCAG 2.4.1 : wrapper <main> avec id="main-content" (cible du skip link). L'inclusion partielle contient les <h1> de la catégorie OWASP — ils seront corrigés dans les partiels owasp/__*.html.twig #}
    <main id="main-content">
      {{ include('owasp/' ~ owasp.lien) }}
    </main>

    {{ include('footer.html.twig') }}
  </body>
</html>

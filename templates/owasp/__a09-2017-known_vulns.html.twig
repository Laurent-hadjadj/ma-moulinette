      {{ owasp.description }}
    </div>
  </section>

  <section>
    <h2 class="h4 claire-hand"><strong>Facteurs de Menace/Vecteurs d'Attaque</strong></h2>
    <div class="table-scroll">
      <table class="responsive-card-table unstriped">
        <thead>
          <tr>
            <th>Facteurs | Vecteurs</th>

        {# Tableau détaillé des failles de sécurité #}
        <section id="failles de sécurité" class="grid-x">
            <h2 class="h4 claire-hand"><span aria-hidden="true">🗒️</span> Liste des failles de sécurité.</h3>
                <div class="detail">
                    <div class="table-scroll">
                        <table>
                            <caption>Liste détaillée des vulnérabilités détectées.</caption>
                            <thead>
                                <tr class="open-sans">
                                    <th class="text-center" scope="col">N°</th>
                                    <th class="text-center" id="rule" scope="col">Règle</th>
                                    <th class="text-center" id="severity" scope="col">Sévérité</th>
                                    <th class="text-center" id="component" scope="col">Component</th>
                                    <th class="text-center" id="ligne" scope="col">Ligne</th>
                                    <th class="text-center" id="message-details" scope="col">Message</th>
                                    <th class="text-center" id="status" scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody id="tbody"></tbody>
                        </table>
                    </div>
                </div>
        </section>

        {# Conteneur pour le diagramme en baton #}
        <section id="repartition-des-failles" class="margin-top-1">
            <h2 class="h4 claire-hand"><span aria-hidden="true">📊</span>Répartition des failles Owasp.</h3>
                <div id="owasp-bar-chart-container" class="owasp-bar-chart-container">
                    <canvas id="owasp-bar-chart"></canvas>
                </div>
        </section>

        {# Comparaison OWASP #}
        <section id="comparaison-owasp">
            <h2 class="h4 claire-hand"><span aria-hidden="true">📋</span> Comparaison des référentiels OWASP</h3>
                <!-- Bouton pour comparer les référentiels -->
                <button id="bouton-ouvrir-comparaison-owasp" class="button open-sans focus-light" type="button"><span
                        aria-hidden="true">🔎</span> OWASP 2017/2021/2025
                </button>
        </section>

        {# Référentiel OWASP 2017, 2021 et 2025 - Doc #}
        <section id="referential-owasp" class="margin-top-1">
            <h2 class="h4 claire-hand"><span aria-hidden="true">📘</span> Référentiel OWASP</h3>
                <div class="grid-x">
                    <div class="small-12 medium-6 large-6 cell">
                        <label for="js-owasp-select">Choisis ton référentiel :</label>
                        {# MODIF 2026-07-18 : `selected` aligné sur referentiel_affiche_defaut —
                        sans ça, le select montrait toujours "2017" par défaut même quand
                        l'accordéon affichait 2021/2025, un état incohérent entre les deux. #}
                        <select id="js-owasp-select" name="owasp" data-tags="true"
                            data-placeholder='Cliquez pour ouvrir la liste' data-language='fr'>
                            <option value="2017" {{ referentiel_affiche_defaut == '2017' ? 'selected' : '' }}>OWASP 2017</option>
                            <option value="2021" {{ referentiel_affiche_defaut == '2021' ? 'selected' : '' }}>OWASP 2021</option>
                            <option value="2025" {{ referentiel_affiche_defaut == '2025' ? 'selected' : '' }}>OWASP 2025</option>
                        </select>
                    </div>
                </div>
        </section>

        {# Référentiel OWASP 2017 #}
        <section id="owasp-2017" class="grid-container owasp-content {{ display_off_2017 }} margin-bottom-2">
            <legend class="container-owasp-description open-sans color-noir font-size-1">Documentation Owasp 2017
            </legend>
            <ul class="vertical menu accordion-menu" data-accordion-menu>
                {% if owasp_2017 is defined and owasp_2017['liste']|length >0 %}
                {% for item in owasp_2017['liste'] %}
                <li id="o{{ loop.index }}" class="referential-owasp-menu">
                    <a class="claire-hand referential-owasp-titre">{{ item.category }}</a>
                    <ul class="menu vertical owasp-padding-left-right">
                        <li>
                            <p class="open-sans text-justify">{{ item.description }}</p>
                            <footer class="grid-x grid-margin-x align-right margin-top-2">
                                <div class="cell shrink">
                                    <a class="bouton-ouvrir-details open-sans focus-light"
                                        href="{{ path('owasp_detail', { id: item.id }) }}"
                                        aria-label="Plus de détails...">
                                        <span aria-hidden="true">🔎</span> Plus de détails...
                                    </a>
                                </div>
                            </footer>
                        </li>
                    </ul>
                </li>
                {% endfor %}
                {% endif %}
            </ul>
        </section>

        {# Référentiel OWASP 2021 #}
        <section id="owasp-2021" class="grid-container owasp-content {{ display_off_2021 }} margin-bottom-2">
            <legend class="container-owasp-description open-sans color-noir font-size-1">Documentation Owasp 2021
            </legend>
            <ul class="vertical menu accordion-menu" data-accordion-menu>
                {% if owasp_2021 is defined and owasp_2021['liste']|length >0 %}
                {% for item in owasp_2021['liste'] %}
                <li id="o{{ loop.index }}" class="referential-owasp-menu">
                    <a class="claire-hand referential-owasp-titre" href="#">{{ item.category }}</a>
                    <ul class="menu vertical owasp-padding-left-right">
                        <li>
                            <p class="open-sans text-justify">{{ item.description }}</p>
                            <footer class="grid-x grid-margin-x align-right margin-top-2">
                                <div class="cell shrink">
                                    <a class="bouton-ouvrir-details open-sans focus-light"
                                        href="{{ path('owasp_detail', { id: item.id }) }}"
                                        aria-label="Plus de détails...">
                                        <span aria-hidden="true">🔎</span> Plus de détails...
                                    </a>
                                </div>
                            </footer>
                        </li>
                    </ul>
                </li>
                {% endfor %}
                {% endif %}
            </ul>
        </section>

        {# Référentiel OWASP 2025 #}
        <section id="owasp-2025" class="grid-container owasp-content {{ display_off_2025 }} margin-bottom-2">
            <legend class="container-owasp-description open-sans color-noir font-size-1">Documentation Owasp 2025
            </legend>
            <ul class="vertical menu accordion-menu" data-accordion-menu>
                {% if owasp_2025 is defined and owasp_2025['liste']|length >0 %}
                {% for item in owasp_2025['liste'] %}
                <li id="o{{ loop.index }}" class="referential-owasp-menu">
                    <a class="claire-hand referential-owasp-titre" href="#">{{ item.category }}</a>
                    <ul class="menu vertical owasp-padding-left-right">
                        <li>
                            <p class="open-sans text-justify">{{ item.description }}</p>
                            <footer class="grid-x grid-margin-x align-right margin-top-2">
                                <div class="cell shrink">
                                    <a class="bouton-ouvrir-details open-sans focus-light"
                                        href="{{ path('owasp_detail', { id: item.id }) }}"
                                        aria-label="Plus de détails...">
                                        <span aria-hidden="true">🔎</span> Plus de détails...
                                    </a>
                                </div>
                            </footer>
                        </li>
                    </ul>
                </li>
                {% endfor %}
                {% endif %}
            </ul>
        </section>
    </main>

    {# Modal Owasp et points chauds #}
    <dialog class="reveal" id="details" data-reveal data-close-on-click="true" data-animation-in="fade-in">
        <h2 class="h3 open-sans">Owasp et Points chauds.</h2>
        <p class="lead details-titre"></p>
        <ul class="stat-list">
            <li>
                <span class="stat-list-label note-e stat-detail">Élevée</span>
                <span id="detail-haut" class="stat stat-list-bleu">0</span>
            </li>
            <li>
                <span class="stat-list-label note-d stat-detail">Moyenne</span>
                <span id="detail-moyen" class="stat stat-list-bleu">0</span>
            </li>
            <li>
                <span class="stat-list-label note-c stat-detail">Faible</span>
                <span id="detail-faible" class="stat stat-list-bleu">0</span>
            </li>
        </ul>
        <footer class="grid-x grid-margin-x align-right margin-top-2">
            <div class="cell shrink">
                <button id="bouton-fermer-details-owasp" class="button open-sans focus-light" type="button"
                    aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
                </button>
            </div>
        </footer>
    </dialog>

    {# Modal comparaison owasp 2017/2021 #}
    <dialog class="reveal large" id="compare-owasp-modal" data-reveal>
        <h2 class="claire-hand h4">OWASP 2017/2021 VS OWASP 2025</h2>
        <img class="by" src="{{ asset('images/comparaison_owasp_2017-2025-811-501.svg') }}"
            alt="Comparaison des référentiels 2017/2025">

        <footer class="grid-x grid-margin-x align-right margin-top-2">
            <div class="cell shrink">
                <button id="bouton-fermer-comparaison-owasp" class="button open-sans focus-light" type="button"
                    aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
                </button>
            </div>
        </footer>
    </dialog>

    <div class="margin-bottom-1">&nbsp;</div>
    {{ include('footer.html.twig') }}
</body>

</html>

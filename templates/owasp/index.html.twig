{% set title = 'Analyse Owasp' %}
{% set description = 'Ma Moulinette - analyse OWASP.' %}
{% set bottom="footer-fixed" %}

{# Active/désactive les boutons de référentiel selon la version de SonarQube.
L'intégration SonarQube d'un référentiel OWASP ne suit pas sa date de
publication : même la dernière version connue ne classe pas encore les
failles selon OWASP Top 10 2025 (cf. application/owasp.md). Tant qu'aucune
version SonarQube ne le supporte, 2025 reste désactivé quelle que soit
sonar.version — pas de seuil numérique à deviner. #}
{% set version = sonar_version +0 %}
{% set referential_2017 = 'enable' %}
{% set referential_2021 = version >= 9 ? 'enable' : 'disable' %}
{% set referential_2025 = 'disable' %}

{# MODIF 2026-07-18 : les 3 blocs de l'accordéon Référentiel démarraient tous
masqués (display-off) — rien n'était visible tant qu'on n'avait pas cliqué,
ce qui donnait l'impression que le premier clic ne faisait rien. On affiche
par défaut le référentiel actif le plus récent (2025 > 2021 > 2017), sans
appel SonarQube : c'est de la documentation déjà chargée par le contrôleur. #}
{% set display_off_2017 = 'display-off' %}
{% set display_off_2021 = 'display-off' %}
{% set display_off_2025 = 'display-off' %}
{% set referentiel_affiche_defaut = '2017' %}
{% if referential_2025 == 'enable' %}
    {% set display_off_2025 = '' %}
    {% set referentiel_affiche_defaut = '2025' %}
{% elseif referential_2021 == 'enable' %}
    {% set display_off_2021 = '' %}
    {% set referentiel_affiche_defaut = '2021' %}
{% else %}
    {% set display_off_2017 = '' %}
{% endif %}


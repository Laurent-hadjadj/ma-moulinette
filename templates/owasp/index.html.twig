{% set title = 'Analyse Owasp' %}
{% set description = 'Ma Moulinette - analyse OWASP.' %}
{% set bottom="footer-fixed" %}

{# On active ou pas le bouton owasp 2021 #}
{% if sonar_version == 8 %}
  {% set referential_2017 = 'enable' %}
  {% set referential_2021 = 'disable' %}
{% else %}
  {% set referential_2017 = 'enable' %}
  {% set referential_2021 = 'enable' %}
{% endif %}

<!DOCTYPE html>

<html lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {% block importmap %}{{ importmap('owasp') }}{% endblock %}
  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container margin-top-1">
      <nav aria-label="Vous êtes Ici : ">
        <ul class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('projet', {}) }}">Projet</a></li>
          <li><span class="show-for-sr">Vous êtes ici:</span>Owasp</li>
        </ul>
      </nav>
    </header>

    {# Message d'information php #}
    {{ include('_message.html.twig') }}

    <div class="grid-container grid-x">
      <h1 class="h2 claire-hand">Vulnérabilités OWASP et points chauds.</h1>
      <div id="js-serveur" class="cell" data-serveur="{{ serveur|default('none') }}">
        {# On ajoute un caractère pour éviter une erreur W3C #}
        <h2 id="js-application" class="h3 claire-hand">&nbsp;</h2>
        <p id="js-application-version" class="h4 open-sans">&nbsp;</p>
        <br>
        <div id="message"></div>
      </div>

      <div id="version-buttons">
        <button id="version-2017" class="version-button {{referential_2017}}">Version 2017</button>
        <button id="version-2021" class="version-button {{referential_2021}}">Version 2021</button>
      </div>

      {# Affiche la version du référentiel owasp disponible #}
      <p id="owasp-version" class="open-sans cell"></p>
      <fieldset class="fieldset cell">
        <legend>Informations.</legend>
        <p class="open-sans">Le tableau ci-dessous liste
          <strong>uniquement</strong>
          les vulnérabilités de type OWASP et les hotspots OWASP.
        </p>
        {# Vulnérabilité OWASP #}
        <p class="ligne open-sans">
          <strong>Vulnérabilité</strong>&nbsp;:
          <span id="nombre-faille-owasp" class="stat result"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Bloquante&nbsp;:
          <span id="nombre-faille-bloquant" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Critique&nbsp;:
          <span id="nombre-faille-critique" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Majeure&nbsp;:
          <span id="nombre-faille-majeur" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Mineure&nbsp;:
          <span id="nombre-faille-mineur" class="stat-owasp result light"></span>
        </p>
        <br>

        {# Vulnérabilité Hotspot #}
        <p class="ligne open-sans">
          <strong>Hotspot</strong>&nbsp;:
          <span id="hotspot-total" class="stat result"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">HIGH&nbsp;:
          <span id="nombre-hotspot-high" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">MEDIUM&nbsp;:
          <span id="nombre-hotspot-medium" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">LOW&nbsp;:
          <span id="nombre-hotspot-low" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans">Examiné&nbsp;:
          <span id="hotspot-reviewed" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans">A vérifier&nbsp;:
          <span id="hotspot-to-review" class="stat-owasp result light"></span>
        </p>
        <p class="ligne open-sans">Note&nbsp;:
          <span id="note-hotspot" class="stat-note result"></span>
        </p>
        <br>

        {# Répartition par module #}
        <p class="ligne open-sans">
          <strong>Module</strong>&nbsp;:</p>
        <p class="ligne open-sans owasp-padding-left">Frontend&nbsp;:
          <span id="frontend" class="result"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Backend&nbsp;:
          <span id="backend" class="result"></span>
        </p>
        <p class="ligne open-sans owasp-padding-left">Autres&nbsp;:
          <span id="autre" class="result"></span>
        </p>
      </fieldset>

      <fieldset class="fieldset cell">
        <legend>Synthèse.</legend>
        <table>
          <caption>Liste des vulnérabilités OWASP et des Hotspots SonarQube.</caption>
          <thead>
            <tr class="open-sans">
              <th scope="col"></th>
              <th scope="col" class="show-for-small-only">Cat.</th>
              <th scope="col" class="show-for-medium">Catégorie</th>
              <th scope="col" class="show-for-small-only text-center">Faille</th>
              <th scope="col" class="show-for-medium text-center">Vulnérabilité</th>
              <th scope="col" class="show-for-small-only text-center">Hotspot</th>
              <th scope="col" class="show-for-medium text-center">Hotspot Review</th>
            </tr>
          </thead>
          <tbody class="open-sans">
            <tr>

    {# Tableau détaillé des failles de sécurité #}
    <div class="grid-container grid-x">
      <h3 class="h4 claire-hand">Liste des failles de sécurité.</h3>
      <div class="detail cell">
        <table class="table-scroll">
          <caption>Liste détaillée des vulnérabilités détectées.</caption>
          <thead>
            <tr class="open-sans">
              <th class="text-center" scope="col">N°</th>
              <th class="text-center" id="rule" scope="col">Règle</th>
              <th class="text-center" id="severity" scope="col">Sévérité</th>
              <th class="text-center" id="component" scope="col">Component</th>
              <th class="text-center" id="ligne" scope="col">Ligne</th>
              <th class="text-center" id="message-details" scope="col">Message</th>
              <th class="text-center" id="status" scope="col">Status</th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
    <br>

    <!-- Conteneur pour le diagramme circulaire -->
    <div class="grid-container">
      <h3 class="h4 claire-hand">Répartition des failles Owasp.</h3>
      <div id="owasp-bar-chart-container" class"owasp-bar-chart-container">
        <canvas id="owasp-bar-chart"></canvas>
      </div>
    </div>
    <br><br>

    {# Référentiel OWASP 2017 et 2021 - Doc #}
    <div class="grid-container">
      <h1 class="h2 claire-hand">Référentiel OWASP</h1>
      <div class="small-12 medium-12 large-12 cell">
        <label for="owasp-select">Choisis ton référentiel :</label>
        <select id="js-owasp-select" name="owasp" data-tags="true" data-placeholder='Cliquez pour ouvrir la liste' data-language='fr'>
          <option value="2017">OWASP 2017</option>
          <option value="2021">OWASP 2021</option>
        </select>

        <!-- Bouton pour comparer les référentiels -->
        <button class="button button-comparaison" data-open="compare-owasp-modal">Changements OWASP 2017/2011</button>
      </div>

        <!-- Référentiel OWASP 2017 -->
        <div id="owasp-2017" class="grid-container owasp-content hide">
          <ul class="vertical menu accordion-menu" data-accordion-menu>
          {% if owasp_2017 is defined and owasp_2017['liste']|length >0  %}
            {% for item in owasp_2017['liste'] %}
              <li id="o{{ loop.index }}" class="referential-owasp-menu">
                <a class="claire-hand referential-owasp-titre">{{ item.category }}</a>
                <ul class="menu vertical owasp-padding-left-right">
                  <li>
                    <p class="open-sans text-justify">{{ item.description }}</p>
                    <a href="{{ path('owasp_detail', { id: item.id }) }}" class="button bouton-affiche-details">Plus de détails...</a><br>
                  </li>
                </ul>
              </li>
            {% endfor %}
          {% endif %}
          </ul>
        </div>

        <!-- Référentiel OWASP 2021 -->
        <div id="owasp-2021" class="grid-container owasp-content hide">
          <legend class="container-owasp-description open-sans color-noir font-size-1">Documentation Owasp 2021</legend>
          <ul class="vertical menu accordion-menu" data-accordion-menu>
          {% if owasp_2021 is defined and owasp_2021['liste']|length >0 %}
            {% for item in owasp_2021['liste'] %}
              <li id="o{{ loop.index }}" class="referential-owasp-menu">
                <a class="claire-hand referential-owasp-titre" href="#">{{ item.category }}</a>
                <ul class="menu vertical owasp-padding-left-right">
                  <li>
                    <p class="open-sans text-justify">{{ item.description }}</p>
                    <a href="{{ path('owasp_detail', { id: item.id }) }}" class="button bouton-affiche-details">Plus de détails...</a><br>
                  </li>
                </ul>
              </li>
            {% endfor %}
          {% endif %}
          </ul>
        </div>
    </div>

    {# Modal Owasp et points chauds #}
    <div class="reveal" id="details" data-reveal data-close-on-click="true" data-animation-in="fade-in">
      <h2 class="h3 open-sans">Owasp et Points chauds.</h2>
      <p class="lead details-titre"></p>
      <ul class="stat-list">
        <li>
          <span class="stat-list-label note-e stat-detail">Élevée</span>
          <span id="detail-haut" class="stat stat-list-bleu">0</span>
        </li>
        <li>
          <span class="stat-list-label note-d stat-detail">Moyenne</span>
          <span id="detail-moyen" class="stat stat-list-bleu">0</span>
        </li>
        <li>
          <span class="stat-list-label note-c stat-detail">Faible</span>
          <span id="detail-faible" class="stat stat-list-bleu">0</span>
        </li>
      </ul>
      <button class="close-button" data-close aria-label="Close modal" type="button"><span aria-hidden="true">&times;</span>
      </button>
    </div>

    <!-- Modal comparaison owasp 2017/2021-->
    <div class="reveal" id="compare-owasp-modal" data-reveal>
      <h2 class="claire-hand h3">OWASP 2017 VS OWASP 2021</h2>

      <img class="by" src="{{ asset('images/comparaison-owasp-2017-2021-514x504.svg') }}" alt="Comparaison des référentiels 2017/2021">
      <br><br>
      {# fermeture de la fenêtre modale #}
      <button class="expanded button open-sans fermer-comparaison-owasp" data-close aria-label="Close reveal" type="button">Fermer</button>
    </div>

    <br><br>
    {{ include('footer.html.twig') }}
  </body>
</html>

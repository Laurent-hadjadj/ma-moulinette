{% set title = 'Profils qualités' %}
{% set description = 'Ma Moulinette - profils qualités.' %}
{% set type_content = "Application Ma-Moulinette, Mise à jour des profils qualités SonarQube." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>

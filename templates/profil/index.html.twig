<html	lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('profil') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container">
      <nav id="fil-ariane" aria-label="vous êtes ici :">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><span class="show-for-sr">vous êtes ici :</span>Profil</li>
        </ol>
      </nav>
    </header>

    {# Gestion des messages flash & JS #}
    <header>
      {% for message in app.flashes('notice') %}
      <div class="callout {{ message.type }} alert-callout-border callout-ombre js-flash-box" role="alert" data-closable>
        <p class="open-sans text-justify callout-message">
            <strong>{{ message.titre }}</strong> {{ message.message }}
        </p>
        {% if app.environment == 'dev' and message.debug is defined %}
        <p class"open-sans">{{message.debug}}</p>
        {% endif %}

        <button class="close-button {{message.type}}"
                type="button"
                aria-label="Dismiss alert" data-close><span aria-hidden="true">&times;</span>
        </button>
      </div>
      {% endfor %}

      {# Message d'information JS#}
      <div id="message-box" class="callout alert-callout-border callout-ombre hide" role="alert" data-closable>
          <button id="message-button-close" class="close-button" aria-label="Close alert" type="button" data-close>
          <span aria-hidden="true">&times;</span>
          </button>
          <p id="message-text"></p>
      </div>
    </header>

    <main class="grid-container margin-bottom-1" role="main">
      {% if liste|length <= 1 %}
        {% set s='' %}
      {% else %}
        {% set s='s' %}
      {% endif %}
      <h1 class="h3 claire-hand" aria-label="Liste des profils qualités">
        <span aria-hidden="true">📋</span> Liste des profils qualités
      </h1>
      <h2 class="h4 claire-hand" aria-label="{{liste|length}} profils qualité par défaut trouvés">
        <span id="affiche-total-profil" class="h4 stat">{{liste|length}}</span>
        <span aria-hidden="true">🗂️</span> profil{{s}} par défaut trouvé{{s}}.
      </h2>

      {# Affiche le nombre total de règles #}
      {% set total = 0 %}
      {% for profil in liste %}
          {% set total = total + profil.rule %}
      {% endfor %}
      <header class="grid-x grid-margin-x align-right margin-top-1">
        <div class="cell shrink bouton-wrapper">
          <div class="js-wrapper-refresh disabled-wrapper">
            <button id="bouton-refresh-profil"
                    class="button open-sans focus-light"
                    type="button"
                    aria-label="Rafraîchir la liste des profils qualités">
              <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 32 32" class="profil-refresh-svg">
                <path d="M23.329 2.501C19.845-.143 15.644-.719 11.693.91c-.742.306-2.128 1.09-2.403 1.356-.798.77-1.046 2.097-.588 3.164.416.98 1.255 1.49 2.17 1.32.299-.054.577-.175 1.103-.484 1.81-1.055 3.631-1.403 5.53-1.054 2.953.546 5.524 2.889 6.696 6.105.21.567.504 1.623.468 1.677-.013.02-.252-.115-.533-.306-.825-.553-1.19-.567-1.579-.059-.24.314-.32.643-.243.984.084.379 3.378 7.87 3.55 8.077.288.34.81.365 1.163.06.076-.064 1.198-1.71 2.492-3.655l2.347-3.537.042-.301c.096-.662-.38-1.286-.941-1.23-.092.009-.523.162-.955.33-.436.172-.806.303-.818.291-.012-.01-.056-.273-.096-.57-.35-2.66-1.35-5.313-2.797-7.418-.728-1.056-2.028-2.438-2.972-3.158zM5.624 9.702a.813.813 0 00-.731.19c-.075.065-1.198 1.711-2.492 3.656L.054 17.085l-.042.302c-.096.662.38 1.285.942 1.23.091-.01.522-.163.955-.33.436-.172.805-.303.817-.292.012.011.056.273.096.571.297 2.253 1.097 4.61 2.194 6.46 1.906 3.22 4.694 5.416 7.939 6.265 2.913.754 5.949.309 8.701-1.277.83-.479 1.061-.66 1.327-1.06.83-1.254.494-3.172-.675-3.84-.718-.414-1.33-.343-2.363.264-1.81 1.055-3.63 1.403-5.53 1.053-2.953-.545-5.524-2.888-6.696-6.105-.21-.567-.504-1.623-.468-1.677.013-.02.252.116.533.306.825.553 1.19.568 1.579.06.24-.315.32-.644.243-.985-.027-.127-.802-1.956-1.723-4.061-1.17-2.685-1.722-3.886-1.842-4.022a.705.705 0 00-.417-.245z"/>
              </svg>
              <span class="show-for-medium open-sans color-blanc">Mise à jour de la liste</span>
            </button>
          </div>
          <button id="bouton-affiche-graphique"
                  class="button open-sans focus-light js-profil-graphique"
                  type="button"
                  aria-haspopup="dialog"
                  aria-controls="modal-affiche-graphique"
                  aria-label="Affiche la répartition des langages">
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 32 32" class="profil-graphique-svg">
                <path d="M13.65.425C7.32 1.335 2.076 5.97.5 12.06c-.4 1.553-.492 2.294-.492 3.952 0 1.652.1 2.527.464 3.945 1.37 5.399 5.693 9.795 11.115 11.298 4.21 1.165 8.761.586 12.443-1.588 4.252-2.505 7.027-6.626 7.72-11.467.056-.388.106-.776.106-.861v-.162l-8.161-.014c-8.12-.022-8.17-.022-8.362-.17a1.934 1.934 0 01-.343-.339c-.15-.19-.15-.24-.17-8.27L14.804.312l-.235.007c-.122.007-.543.05-.92.106z"/><path d="M17.088 7.616v7.303h14.768v-.162c0-.085-.05-.473-.107-.86-.47-3.303-1.912-6.274-4.209-8.702-2.461-2.59-6-4.368-9.596-4.806a11.163 11.163 0 00-.728-.077c-.12 0-.128.352-.128 7.304z"/>
            </svg>
              <span class="show-for-medium open-sans color-blanc">Répartition des langages</span>
          </button>
        </div>
      </header>

      <p class="open-sans">ℹ️ Le référentiel des règles de développement contient
          <strong><span class="js-total">{{ total|format_number(locale='fr') }}</span></strong>
          règles.
      </p>
      <div id="js-container-langage" class="grid-x cell">
        {% set id = 0 %}
        {% for profil in liste %}
          {% set id = id + 1 %}
          {% set zero = '' %}
          {% if profil.nb_profils_par_langage < 10 %} {% set zero = '0' %} {% endif %}
          {# On affiche la callbox pour le langage #}
          <caption><span class="show-for-sr">Détails du langage {{ profil.langage }}</span></caption>
          <div class="small-12 medium-12 large-6 cell">
            <div class="callout secondary box-langage">
              <h3 class="h5 claire-hand">{{ profil.langage }} <span class="open-sans float-right text-right bulle-nombre-profil">{{zero}}{{profil.nb_profils_par_langage}}</span></h3>
              <table class="hover">
                <thead>
                  <tr>
                    <th scope="col" class="open-sans text-center"></th>
                    <th scope="col" id="profil-version-{{id}}" class="open-sans text-center">Version</th>
                    <th scope="col" id="profil-rule-{{id}}" class="open-sans text-center">Règle</th>
                    <th scope="col" id="profil-{{id}}" class="open-sans text-center">Date</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="open-sans">
                    <td id="profil-{{id}}"
                        class="js-profil-information profil-font-size"
                        data-profil="{{profil.profil}}"
                        role="button"
                        tabindex={{id}}
                        data-language="{{profil.langage}}"
                        aria-labelledby="title-{{id}} desc-{{id}}">
                      <svg id="i-{{id}}" version="1.1" xmlns="http://www.w3.org/2000/svg"
                        width="100%" height="100%" viewbox="0 0 28 28" class="profil-information-fixe-svg" role="img"
                        aria-labelledby="title-{{id}} desc-{{id}}">
                        <title id="title-{{id}}">Afficher les informations du profil {{profil.langage}}</title>
                        <desc id="desc-{{id}}">Cliquer pour voir les détails du langage {{profil.langage}} associé au profil {{profil.profil}}</desc>
                        <path d="M9.142.079c-.932.228-1.804 1.055-2.07 1.963l-.08.288h-.987c-.829 0-1.007.016-1.116.087-.173.125-.276.402-.276.755v.3H3.6c-1.512 0-2.026.168-2.725.87-.401.402-.666.858-.786 1.364-.119.527-.119 15.88 0 16.407.19.805.802 1.571 1.544 1.92a3.7 3.7 0 00.694.255c.195.038 1.663.06 4.54.06 3.873 0 4.268-.006 4.41-.093.297-.174.362-.609.14-.87l-.13-.152-4.383-.027-4.377-.027-.363-.18c-.411-.2-.65-.445-.85-.88l-.141-.3V6l.179-.364c.2-.413.444-.652.877-.853.282-.136.352-.142 1.344-.158l1.04-.022v.332c0 .701.184 1.169.607 1.566.482.445.276.424 4.648.424h3.873l.309-.153c.336-.168.628-.456.807-.81.092-.18.13-.364.152-.777l.032-.544h1.057c1.03 0 1.062.006 1.36.142.373.179.688.483.866.842.13.267.13.283.157 2.333.028 2.229.033 2.24.325 2.392.2.103.342.103.548-.006.303-.152.32-.272.32-2.234 0-2.088-.033-2.387-.32-2.98-.347-.728-.856-1.195-1.61-1.484-.351-.13-.444-.141-1.549-.163l-1.18-.021v-.397c0-.348-.017-.424-.13-.555l-.13-.152-1.046-.027-1.04-.027-.065-.223C12.176.617 10.62-.28 9.142.079zm1.408 1.24c.553.255.916.772.997 1.413.087.696.168.74 1.409.74h.92v.924c0 1.049-.043 1.207-.351 1.337-.271.114-7.092.114-7.363 0-.336-.141-.357-.217-.357-1.294v-.968h.926c1.208 0 1.29-.043 1.376-.734.07-.554.39-1.06.829-1.315.53-.315 1.078-.348 1.614-.103z"/><path d="M3.762 9.354c-.308.152-.363.663-.092.919l.141.13 5.954.016c6.625.017 6.203.038 6.365-.353a.564.564 0 00-.178-.669c-.136-.109-.2-.109-6.106-.103-4.014 0-6.002.022-6.084.06zm0 3.48c-.308.151-.363.662-.092.918l.141.13 4.22.017c4.703.016 4.475.032 4.632-.354a.564.564 0 00-.179-.668c-.135-.11-.205-.11-4.371-.104-2.812 0-4.27.022-4.35.06zm15.261.01c-3.288.587-5.77 3.153-6.235 6.442-.081.577-.038 1.963.081 2.506a7.525 7.525 0 001.988 3.725c1.09 1.125 2.335 1.815 3.884 2.158.786.174 2.205.174 2.985 0 1.544-.348 2.72-.99 3.803-2.072 1.079-1.087 1.718-2.267 2.065-3.816.173-.783.173-2.207 0-2.995a7.397 7.397 0 00-.688-1.936c-.401-.777-.819-1.332-1.463-1.962a7.472 7.472 0 00-3.684-1.99c-.526-.12-2.194-.158-2.736-.06zm2.6 1.223a6.422 6.422 0 014.768 4.66c.552 2.152-.092 4.468-1.674 6.061-2.183 2.19-5.515 2.49-8.105.734-.763-.517-1.636-1.528-2.08-2.408-.52-1.044-.753-2.403-.601-3.583.352-2.827 2.508-5.083 5.298-5.54.623-.103 1.777-.065 2.395.076z"/><path d="M19.83 16.405a.571.571 0 00.141.902c.342.19.759-.021.824-.424.08-.527-.585-.859-.965-.478zm.19 2.202c-.358.157-.347.07-.347 2.816 0 1.712.017 2.528.06 2.62.152.326.66.386.92.109l.13-.141.017-2.496c.016-2.778.016-2.756-.341-2.908-.222-.093-.228-.093-.439 0zM3.762 16.312c-.308.153-.363.664-.092.92l.141.13h6.263l.14-.13c.277-.262.217-.773-.108-.925-.179-.082-6.17-.076-6.344.005z"/>
                      </svg>
                    </td>
                    <td class="profil-font-size">{{ profil.profil }}</td>
                    <td class="text-center mini-stat color-noir">{{ profil.rule|format_number(locale='fr') }}</td>
                    <td class="text-left profil-font-size" >
                      <span class="show-for-small-only">{{profil.date|date("d/m/y", "Europe/Paris")}}</span>
                      <span class="show-for-medium">{{profil.date|date("d/m/Y à H:i", "Europe/Paris")}}</span>
                    </td>
                  </tr>
                </tbody>
              </table>
              <footer class="grid-x grid-margin-x align-right margin-top-1">
                <div class="cell shrink">
                  {% set isDisabled = (profil.nb_profils_par_langage == 1) %}
                  {% set boutonClass = isDisabled ? "disabled-bouton" : "" %}
                  {% set ariaLabel = isDisabled
                    ? "Aucun autre profil n'est disponible"
                    : "Affiche la liste des autres langages" %}
                  {% set ariaDisabled = isDisabled ? 'true' : null %}
                  {% set tabIndex = isDisabled ? '-1' : null %}
                  {% set icon = isDisabled ? '🚫' : '📂' %}

                  <button id="bouton-language-{{ profil.langage }}"
                          class="button open-sans focus-light js-bouton-autre-profil {{ boutonClass }}"
                          type="button"
                          data-language="{{ profil.langage }}"
                          aria-haspopup="dialog"
                          aria-controls="modal-autre-profil"
                          aria-label="{{ ariaLabel }}"
                          {% if ariaDisabled %} aria-disabled="{{ ariaDisabled }}" {% endif %}
                          {% if tabIndex %} tabindex="{{ tabIndex }}" {% endif %}>
                    <span class="show-for-small-only open-sans color-blanc no-select">
                      <span aria-hidden="true">{{ icon }}</span>Détails
                    </span>
                    <span class="show-for-medium open-sans color-blanc no-select">
                      <span aria-hidden="true">{{ icon }}</span>Afficher les autres profils
                    </span>
                  </button>
                </div>
              </footer>
            </div>
          </div>
        {% endfor %}
      </div>
    </main>

    {# Fenêtre modale pour afficher les autres référentiels #}
    {{ include('/profil/_modal_autres_versions.html.twig') }}

    {# Fenêtre modale pour afficher le graphique #}
    {{ include('/profil/_modal_affiche_graphique.html.twig') }}

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

<html lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('profil-details') }}{% endblock %}
  </head>

  <body>
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container">
      <nav aria-label="Vous êtes Ici :" role="navigation">
        <ul class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('profil', {}) }}">Profil</a></li>
          <li><span class="show-for-sr">Vous êtes ici :</span>Détails</li>
        </ul>
      </nav>
    </header>

    {# Message d'information du contrôleur #}
    <div class="grid-container grid-x" role="alert" aria-label="messages d'information">
      {% for message in app.flashes('notice') %}
        <div class="callout alert-callout-border js-message-flash {{message.type}} role="alert" cell" data-closable>
          <p class="open-sans text-justify callout-message">
            <strong>{{message.titre}}</strong> {{ message.message }}.</p>
          <button class="close-button {{message.type}}" aria-label="Dismiss alert" type="button" data-close>
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
      {% endfor %}
    </div>

    <div class="grid-container">
      <h1 class="h3 claire-hand">Détails des changements pour le profil.</h1>
      {% if total_rule|length > 1 %}
        {% set s = "s" %}
      {% else %}
        {% set s = "" %}
      {% endif %}
      <h2 class="h4 profil-titre">
        <span id="affiche-titre">Langage</span>
        <span class="color-noir">{{langage|upper}}, </span>
        <span id="affiche-total-profil" class="stat">{{total_rule|length}}</span>
        changement{{s}} trouvé{{s}}.
      </h2>

      <br>
      <h3 class="h4 profil-titre">Informations générales</h3>
      {# Message d'alerte sur le nombre de changements récupéré #}
      <div class="callout alert-callout-border primary">
        <strong>Attention</strong> - Seul les 500 premiers changements sont affichés.
        <button class="close-button primary" aria-label="Dismiss alert"
                type="button" data-close><span aria-hidden="true">&times;</span>
        </button>
      </div>

      {# Version initiale #}
      <div class="grid-x">
        <div class="open-sans small-6 cell">
          <span class="show-for-small-only">Init. :</span>
          <span class="show-for-medium">Initialisation :</span>
        </div>
        <div class="open-sans color-noir small-6 cell">
          {% if premier is not empty %}
          <span class="show-for-small-only profil-first-date float-right">{{premier["date"]|date("d/m/y H:m", "Europe/Paris")}}</span>
          <span class="show-for-medium profil-first-date float-right">{{premier["date"]|date("d/m/y H:m:s", "Europe/Paris")}}</span>
          {% endif %}
        </div>
      </div>

      {# Dernière Version #}
      <div class="grid-x">
        <div class="open-sans small-6 cell">
          <span class="show-for-small-only">Dernière modif. :</span>
          <span class="show-for-medium">Dernière modification :</span>
        </div>
        <div class="open-sans small-6 cell">
          {% if dernier is not empty %}
          <span class="show-for-small-only profil-last-date float-right">{{dernier["date"]|date("d/m/y H:m", "Europe/Paris")}}</span>
          <span class="show-for-medium profil-last-date float-right">{{dernier["date"]|date("d/m/y H:m:s", "Europe/Paris")}}</span>
          {% endif %}
        </div>
      </div>

      {# Nombre de règles #}
      <div class="grid-x cell flex-container">
        <div class="open-sans small-4 cell">
          <span class="show-for-small-only">Règles :</span>
          <span class="show-for-medium">Nombre de règles :</span>
        </div>
        <div class="open-sans small-8 cell">
          <span class="profil-total float-right">{{total_rule}}</span>
        </div>
      </div>

      {# Nombre de règles Activated #}
      <div class="grid-x cell flex-container">
        <div class="open-sans small-4 cell">
          <span class="show-for-small-only">Règles activées :</span>
          <span class="show-for-medium">Nombre de règles activé :</span>
        </div>
        <div class="open-sans small-8 cell">
          <span class="profil-opened float-right">{{opened}}</span>
        </div>
      </div>

      {# Nombre de règles Updated #}
      <div class="grid-x cell flex-container">
        <div class="open-sans small-4 cell">
          <span class="show-for-small-only">Règles modifiées :</span>
          <span class="show-for-medium">Nombre de règles modifié :</span>
        </div>
        <div class="open-sans small-8 cell">
          <span class="profil-updated float-right">{{updated}}</span>
        </div>
      </div>

      {# Nombre de règles deactivated #}
      <div class="grid-x cell flex-container">
        <div class="open-sans small-4 cell">
          <span class="show-for-small-only">Règles désactivées :</span>
          <span class="show-for-medium">Nombre de règles désactivé :</span>
        </div>
        <div class="open-sans small-8 cell">
          <span class="profil-closed float-right">{{closed}}</span>
        </div>
      </div>

      {% set i = 0 %}
      {% if liste is not empty %}
        {% for groupe in liste %}
          {% if badge[i].badgeA < 10 %}
            {% set a,aa ="&nbsp;&nbsp;","&nbsp;&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeA > 10 and badge[i].badgeA < 100 %}
            {% set a,aa ="&nbsp;","&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeA > 100 %}
            {% set a,aa ="","" %}
          {% endif %}
          {% if badge[i].badgeU < 10 %}
            {% set b,bb ="&nbsp;&nbsp;","&nbsp;&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeU > 10 and badge[i].badgeU < 100 %}
            {% set b,bb ="&nbsp;","&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeU > 100 %}
            {% set b,bb ="","" %}
          {% endif %}
          {% if badge[i].badgeD < 10 %}
            {% set c,cc ="&nbsp;&nbsp;","&nbsp;&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeD > 10 and badge[i].badgeD < 100 %}
            {% set c,cc ="&nbsp;","&nbsp;" %}
          {% endif %}
          {% if badge[i].badgeD > 100 %}
            {% set c,cc ="",";" %}
          {% endif %}

          <ul class="vertical menu accordion-menu" data-accordion-menu>
            <li class="liste-changement-menu">
              <a class="claire-hand liste-changement-titre">
                <span>{{date_groupe[i]|date("d/m/y H:m", "Europe/Paris")}}</span>
                <span class="bulle activated bulle-marge">{{a|raw}}{{badge[i].badgeA}}{{aa|raw}}</span>
                <span class="bulle updated">{{b|raw}}{{badge[i].badgeU}}{{bb|raw}}</span>
                <span class="bulle deactivated">{{c|raw}}{{badge[i].badgeD}}{{cc|raw}}</span>
                <span class="nombre-rule float-right text-right">{{liste[i]|length}}</span>
              </a>
              <ul class="menu vertical liste-padding-left-right">
                {% set x = 1 %}
                {% for item in liste[i] %}
                  <ul class="fieldset changement">
                    {% if item.action == "ACTIVATED" %}
                      {% set css,statut  =  "activated", "A" %}
                    {% endif %}
                    {% if item.action == "DEACTIVATED" %}
                      {% set css,statut  =  "deactivated", "D" %}
                    {% endif %}
                    {% if item.action == "UPDATED" %}
                      {% set css,statut  =  "updated", "U" %}
                    {% endif %}
                    {% if item.action not in ["UPDATED", "DEACTIVATED", "ACTIVATED"] %}
                      {% set css,statut  =  "xoxo", "X" %}
                    {% endif %}
                    <li class="stat profil-stat text-right">{{x}}</li>
                    <li class="open-sans">
                      <span class="text-justify"><strong>Statut :</strong></span>
                      <span class="float-right bulle {{css}}">{{statut}}</span>
                    </li>
                    <li class="open-sans">
                      <span class="text-justify"><strong>Règle :</strong></span>
                      <span class="show-for-small-only"><br></span>
                      <span class="text-justify profil-rule">{{item.rule}}</span>
                    </li>
                    <li class="open-sans">
                      <span class="text-justify"><strong>Description :</strong></span>
                      <span class="show-for-small-only"><br></span>
                      <span class="text-justify profil-description">{{item.description}}.</span>
                    </li>
                    <li class="show-for-medium open-sans">
                      <span class="text-justify"><strong>Détails :</strong></span>
                      <span class="show-for-small-only"><br></span>
                      <span class="text-justify profil-details">{{item.detail}}.</span>
                    </li>
                    <li class="open-sans">
                      <span class="text-justify"><strong>Auteur :</strong></span>
                      <span class="show-for-small-only"><br></span>
                      <span class="text-justify profil-auteur">{{item.auteur}}.</span>
                    </li>
                  </ul>
                  {% set x = x + 1 %}
                {% endfor %}
              </ul>
            </li>
          </ul>
          {% set i = i + 1 %}
        {% endfor %}
      {% endif %}
    </div>

    <br><br>
    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

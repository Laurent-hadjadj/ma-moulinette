{% set title = "Statistiques — Environnement technique" %}
{% set description = "Ma Moulinette - Tableau de bord technique" %}
{% set type_content = "Application Ma-Moulinette, informations techniques sur l'environnement." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>

{% set title = "Statistiques" %}
{% set description = "Ma-moulinette, statistiques utilisateur" %}
{% set type_content = "Application Ma-moulinette, La page des statistiques utilisateur." %}
{% set bottom="footer-fixed footer-fixed-small" %}
{% if nombre_utilisateur_disponible != 0 %}
  {% set adhesion = (nombre_utilisateur_actif / nombre_utilisateur_disponible) %}
  {% if adhesion < 25 %} {% set couleur = 'stats-list-rouge' %} {% endif %}
  {% if adhesion > 25 and adhesion < 50 %} {% set couleur = 'stats-list-orange' %} {% endif %}
  {% if adhesion > 50 and adhesion < 75 %} {% set couleur = 'stats-list-bleu' %} {% endif %}
  {% if adhesion > 75 %} {% set couleur = 'stats-list-vert' %} {% endif %}
  {% else %}
    {% set couleur = 'stats-list-rouge' %}
  {% endif %}
<!DOCTYPE html>

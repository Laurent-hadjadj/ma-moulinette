{% set title = "Statistiques" %}
{% set description = "Ma-Moulinette, page des statistiques" %}
{% set type_content = "Application Ma-moulinette, La page d'accès aux statistiques." %}
{% set bottom="footer-fixed footer-fixed-small" %}

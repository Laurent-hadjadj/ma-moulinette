{% set title = "Statistiques — Sonar-Report" %}
{% set description = "Ma Moulinette - Statistiques fonctionnelles SonarQube" %}
{% set type_content = "Application Ma-Moulinette, statistiques fonctionnelles SonarQube." %}
{% set bottom="" %}
<!DOCTYPE html>

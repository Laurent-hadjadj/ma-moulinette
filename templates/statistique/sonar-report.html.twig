<html lang="fr">
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {% block importmap %}{{ importmap('admin-stats') }}{% endblock %}
  </head>

  <body dir="ltr">
    {{ include('no-script.html.twig') }}
    {{ include('header.html.twig') }}

    {# Données JSON pour Chart.js #}
    <script type="application/json" id="admin-stats-data">
    {
        "anomalies": {{ chart_anomalies|raw }},
        "projets":   {{ chart_projets|raw }}
    }
    </script>

    {# MODIF 2026-06-09 : breadcrumb navigation — remplace lien back-admin #}
    <header class="grid-container">
      <nav id="fil-ariane" aria-label="Fil d'Ariane, vous êtes ici">
        <ol class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('statistiques', {}) }}">Statistiques</a></li>
          <li aria-current="page">Sonar-Report</li>
        </ol>
      </nav>
    </header>

    <main id="main-content" class="grid-container" role="main">

      <h2 class="claire-hand">Statistiques fonctionnelles</h2>

      {# ===== Section Utilisateurs & SonarQube ===== #}
      <h3 class="section-title open-sans"><i class="fas fa-users" aria-hidden="true"></i> Application</h3>
      <div class="grid-x grid-padding-x small-up-2 medium-up-3 large-up-5">
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Utilisateurs</p>
              <p class="metric-value">{{ application_utilisateur }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Projets SonarQube</p>
              <p class="metric-value">{{ projet_projet }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Profils qualité</p>
              <p class="metric-value">{{ projet_profile }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Règles actives</p>
              <p class="metric-value">{{ projet_regle|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Historique</p>
              <p class="metric-value">{{ projet_historique }}</p>
            </div>
          </div>
        </div>
      </div>

      {# ===== Section Lignes & Tests ===== #}
      <h3 class="section-title open-sans"><i class="fas fa-chart-bar" aria-hidden="true"></i> Mesures SonarQube</h3>
      <div class="grid-x grid-padding-x small-up-2 medium-up-3 large-up-4">
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Projets analysés</p>
              <p class="metric-value">{{ projet_anomalie }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Lignes de code</p>
              <p class="metric-value">{{ projet_line|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-sonar">
            <div class="card-section text-center">
              <p class="metric-label">Tests unitaires</p>
              <p class="metric-value">{{ projet_test|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
      </div>

      {# ===== Section Anomalies ===== #}
      <h3 class="section-title open-sans"><i class="fas fa-bug" aria-hidden="true"></i> Anomalies globales</h3>
      <div class="grid-x grid-padding-x small-up-2 medium-up-2 large-up-4">
        <div class="cell">
          <div class="card metric-card accent-anomaly">
            <div class="card-section text-center">
              <p class="metric-label">Total signalements</p>
              <p class="metric-value">{{ mesure_signalement|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-anomaly">
            <div class="card-section text-center">
              <p class="metric-label">Fiabilité (bugs)</p>
              <p class="metric-value">{{ mesure_bug|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-anomaly">
            <div class="card-section text-center">
              <p class="metric-label">Sécurité</p>
              <p class="metric-value">{{ mesure_vulnerability|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
        <div class="cell">
          <div class="card metric-card accent-anomaly">
            <div class="card-section text-center">
              <p class="metric-label">Maintenabilité</p>
              <p class="metric-value">{{ mesure_code_smell|number_format(0, '.', ' ') }}</p>
            </div>
          </div>
        </div>
      </div>

      {# ===== Section Charts ===== #}
      <h3 class="section-title open-sans"><i class="fas fa-chart-pie" aria-hidden="true"></i> Visualisations</h3>
      <div class="grid-x grid-padding-x">
        <div class="cell small-12 medium-6">
          <div class="card">
            <div class="card-section">
              <canvas id="chart-anomalies" aria-label="Répartition des anomalies" role="img" height="280"></canvas>
            </div>
          </div>
        </div>
        <div class="cell small-12 medium-6">
          <div class="card">
            <div class="card-section">
              <canvas id="chart-projets" aria-label="Métriques SonarQube" role="img" height="280"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div aria-hidden="true" style="margin-bottom:3rem;"></div>
    </main>

    {{ include('footer.html.twig') }}
  </body>
</html>

{% set title = "Statistiques — Projets" %}
{% set description = "Ma Moulinette - Métriques par projet" %}
{% set type_content = "Application Ma-Moulinette, tableau de bord des métriques par projet." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>
<!--
.  ____            _      _
. |  _ \ _ __ ___ (_) ___| |_

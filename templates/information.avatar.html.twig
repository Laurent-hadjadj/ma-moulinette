{# MODIF 2026-09-14 : tabindex/role/aria-pressed sur les vignettes avatar (focus clavier + état sélectionné, cf. common.css .thumbnail) #}
{# affiche la liste des avatar #}
<dialog
    id="mes-avatars"
    class="grid-container large reveal"
    data-reveal
>
    <header>
        <h2 id="titre-modal-avatar" class="h3 claire-hand">
            <span aria-hidden="true">🖼️</span> Choix de l'avatar</h2>
        <p id="desc-modal-avatar" class="show-for-sr">Sélectionne ton avatar.</p>
    </header>
    <p class="open-sans">Sélectionne ton avatar parmi les avatars disponible.</p>
    <ul id="ajouter-mes-avatars" class="accordion" data-accordion data-multi-open="true">
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Chiffres</strong>
                </span>
                <span class="open-sans float-right avatar-chiffre">1</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            <button
                    id="js-ajouter-chiffre-1"
                    class="avatar-choice"
                    type="button"
                    aria-label="Choisir l'avatar chiffre 1"
                    aria-pressed="false">
            <img
                id="ajouter-chiffre-1"
                class="thumbnail gray-scale"
                alt=""
                width="42"
                height="42"
                loading="lazy"
                decoding="async"
                data-src="{{ asset('avatar/chiffre/1.png') }}"
                data-theme="chiffre"
                data-image="1">
            </button>
            </div>
        </li>
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Émoticônes</strong>
                </span>
                <span class="open-sans float-right avatar-emoticon">35</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            {% for i in 1..35 %}
            {% set number = '%02d'|format(i) %}
                <button
                        id="js-ajouter-emoticon-{{ number }}"
                        class="avatar-choice"
                        type="button"
                        aria-label="Choisir l'avatar emoticon {{ number }}"
                        aria-pressed="false">
                <img
                    id="ajouter-emoticon-{{ number }}"
                    class="thumbnail gray-scale"
                    alt=""
                    width="42"
                    height="42"
                    loading="lazy"
                    decoding="async"
                    data-src="{{ asset('avatar/emoticon/' ~ number ~ '.png') }}"
                    data-theme="emoticon"
                    data-image="{{ number }}">
                </button>
            {% endfor %}
            </div>
        </li>
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Filles (1)</strong>
                </span>
                <span class="open-sans float-right avatar-fille1">27</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            {% for i in 1..27 %}
                {% set number = '%02d'|format(i) %}
                <button
                        id="js-ajouter-fille-1-{{ number }}"
                        class="avatar-choice"
                        type="button"
                        aria-label="Choisir l'avatar du set fille 1 {{ number }}"
                        aria-pressed="false">
                <img
                    id="ajouter-fille-1-{{ number }}"
                    class="thumbnail gray-scale"
                    alt=""
                    width="42"
                    height="42"
                    loading="lazy"
                    decoding="async"
                    data-src="{{ asset('avatar/fille-1/' ~ number ~ '.png') }}"
                    data-theme="fille-1"
                    data-image="{{ number }}">
                </button>
            {% endfor %}
            </div>
        </li>
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Filles (2)</strong>
                </span>
                <span class="open-sans float-right avatar-fille2">27</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            {% for i in 1..26 %}
                {% set number = '%02d'|format(i) %}
                <button
                        id="js-ajouter-fille-2-{{ number }}"
                        class="avatar-choice"
                        type="button"
                        aria-label="Choisir l'avatar du set fille 2 {{ number }}"
                        aria-pressed="false">
                <img
                    id="ajouter-fille-2-{{ number }}"
                    class="thumbnail gray-scale"
                    alt=""
                    width="42"
                    height="42"
                    loading="lazy"
                    decoding="async"
                    data-src="{{ asset('avatar/fille-2/' ~ number ~ '.png') }}"
                    data-theme="fille-2"
                    data-image="{{ number }}">
                </button>
                {% endfor %}
            </div>
        </li>
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Garçon (1)</strong>
                </span>
                <span class="open-sans float-right avatar-garcon1">23</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            {% for i in 1..23 %}
                {% set number = '%02d'|format(i) %}
                <button
                        id="js-ajouter-garcon-1-{{ number }}"
                        class="avatar-choice"
                        type="button"
                        aria-label="Choisir l'avatar du set garcon 1 {{ number }}"
                        aria-pressed="false">
                <img
                    id="ajouter-garcon-1-{{ number }}"
                    class="thumbnail gray-scale"
                    alt=""
                    width="42"
                    height="42"
                    loading="lazy"
                    decoding="async"
                    data-src="{{ asset('avatar/garcon-1/' ~ number ~ '.png') }}"
                    data-theme="garcon-1"
                    data-image="{{ number }}">
                </button>
                {% endfor %}
            </div>
        </li>
        <li class="accordion-item menu-accordion" data-accordion-item>
            <a class="accordion-title color-bleu">
                <span class="open-sans">
                    <strong>Garçon (2)</strong>
                </span>
                <span class="open-sans float-right avatar-garcon2">23</span>
            </a>
            <div class="accordion-content background-color-blanc" data-tab-content>
            {% for i in 1..24 %}
                {% set number = '%02d'|format(i) %}
                <button
                        id="js-ajouter-garcon-2-{{ number }}"
                        class="avatar-choice"
                        type="button"
                        aria-label="Choisir l'avatar du set garcon 2 {{ number }}"
                        aria-pressed="false">
                <img
                    id="ajouter-garcon-2-{{ number }}"
                    class="thumbnail gray-scale"
                    alt=""
                    width="42"
                    height="42"
                    loading="lazy"
                    decoding="async"
                    data-src="{{ asset('avatar/garcon-2/' ~ number ~ '.png') }}"
                    data-theme="garcon-2"
                    data-image="{{ number }}">
                </button>
                {% endfor %}
            </div>
        </li>
    </ul>

    {# fermeture de la fenêtre modale #}
    <footer class="grid-x grid-margin-x align-right margin-top-2">
        <div class="cell shrink">
            <button
                id="bouton-fermer-mes-avatars"
                class="button open-sans focus-dark-light"
                type="button"
                aria-label="Fermer la fenêtre"
            ><span aria-hidden="true">❌</span>Fermer
            </button>
        </div>
    </footer>
</dialog>

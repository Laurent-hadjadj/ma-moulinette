          {% else %}
            <img id="ajouter-garcon-2-{{i}}" class="thumbnail gray-scale" alt="m0i" height="42" width="42" src="{{ asset('avatar/garcon-2/' ~ i ~ '.png')}}" data-theme="garcon-2" data-image="{{i}}">
          {% endif %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <title>{{ title }}</title>
        {{ include('head.html.twig') }}
        {% block importmap %}
            {{ importmap('profiling') }}
        {% endblock %}
    </head>

    <body dir="ltr">
        {{ include('no-script.html.twig') }}
        {{ include('header.html.twig') }}

        <header class="grid-container margin-top-1">
            {# WCAG 2.4.8 : aria-label enrichi ; <ol> à la place de <ul> ; aria-current="page" sur l'élément courant #}
            <nav aria-label="Fil d'Ariane, vous êtes ici">
                <ol class="claire-hand breadcrumbs">
                    <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
                    <li><a href="{{ path('traitement_suivi', {}) }}">Traitement</a></li>
                    <li aria-current="page">Dashboard Profiling</li>
                </ol>
            </nav>
        </header>

        {# Message d'information php #}
        {{ include('_message.html.twig') }}

        {# WCAG 2.4.1 / 4.1.1 : id="main-content" (cible du skip link) ; retrait du role="main" redondant #}
        <main id="main-content" class="grid-container margin-top-2">
            {# WCAG 1.3.1 / 2.4.6 : un seul <h1> par page ; descente d'un niveau (h1->h2, h2->h3) ; aria-label retiré car redondant #}
            <h2 class="h3 claire-hand">
                <span aria-hidden="true">📊</span> Dashboard Profiling
            </h2>

            <div class="profiling-summary">
                {# WCAG 1.3.1 : descente d'un niveau #}
                <h4 class="h4 claire-hand">Résumé global des performances</h4>
                <table id="summaryTable">
                    <thead>
                        <tr>
                            <th>Temps total moyen (s)</th>
                            <th>Temps moyen projet (s)</th>
                            <th>Mémoire moyenne (Mo)</th>
                            <th>Pic mémoire moyen (Mo)</th>
                            <th>Pic mémoire max (Mo)</th>
                            <th>Dernière exécution</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="profiling-summary-charts">
                    <h3 class="h4 claire-hand">Indicateurs de performances </h3>
                    <div class="charts-grid">
                        <div class="hauteur-max">
                            <canvas id="chart-kpi-time-donut"></canvas>
                        </div>
                        <div class="hauteur-max">
                            <canvas id="chart-kpi-memory-donut"></canvas>
                        </div>
                        <div class="hauteur-max">
                            <canvas id="chart-kpi-memory-bar" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard margin-top-2">
                <h3 class="h4 claire-hand">Tableaux de bord</h3>

                <h4 class="h5 claire-hand">Granularité</h4>
                <div id="indicateur-granularite" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>
                <h4 class="h5 claire-hand">Période</h4>
                <div id="indicateur-periode" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>

                <h4 class="h5 claire-hand">Utilisateurs</h4>
                <div id="indicateur-utilisateur" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>
                <h4 class="h5 claire-hand">Portefeuille</h4>
                <div id="indicateur-portefeuille" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>
                <h4 class="h5 claire-hand">Execution</h4>
                <div id="indicateur-exec" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>
                <h4 class="h5 claire-hand">Dernière execution</h4>
                <div id="indicateur-execution" class="card-container">
                    <!-- Les cartes utilisateurs seront insérées ici -->
                </div>

            </div>

            {# Graphiques globaux #}
            <section class="grid-x grid-margin-x margin-top-2">
                <div class="cell medium-6">
                    <h3 class="h4">Temps moyen par portefeuille</h3>
                    <div class="chart-container">
                        <canvas id="chartTime"></canvas>
                    </div>
                </div>
                <div class="cell medium-6">
                    <h3 class="h4">Mémoire peak moyenne</h3>
                    <div class="chart-container">
                        <canvas id="chartMemory"></canvas>
                    </div>
                </div>
            </section>

            {# Évolution hebdomadaire #}
            <section class="grid-x grid-margin-x margin-top-2">
                <div class="cell medium-6">
                    <h3 class="h4">Évolution hebdomadaire - Temps moyen</h3>
                    <div class="chart-container">
                        <canvas id="chartWeeklyTime"></canvas>
                    </div>
                </div>
                <div class="cell medium-6">
                    <h3 class="h4">Évolution hebdomadaire - Mémoire</h3>
                    <div class="chart-container">
                        <canvas id="chartWeeklyMemory"></canvas>
                    </div>
                </div>
            </section>

            {# Évolution mensuelle #}
            <section class="grid-x grid-margin-x margin-top-2">
                <div class="cell medium-6">
                    <h3 class="h4">Évolution mensuelle - Temps moyen</h3>
                    <div class="chart-container">
                        <canvas id="chartMonthlyTime"></canvas>
                    </div>
                </div>
                <div class="cell medium-6">
                    <h2 class="h4">Évolution mensuelle - Mémoire</h2>
                    <div class="chart-container">
                        <canvas id="chartMonthlyMemory"></canvas>
                    </div>
                </div>
            </section>

            {# Comparaison utilisateurs #}
            <section class="grid-x grid-margin-x margin-top-2">
                <div class="cell medium-6">
                    <h3 class="h4">Comparaison utilisateur - Temps moyen</h3>
                    <canvas id="chartUsersTime"></canvas>
                </div>
                <div class="cell medium-6">
                    <h3  class="h4">Comparaison utilisateur - Mémoire</h3>
                    <div class="chart-container">
                        <canvas id="chartUsersMemory"></canvas>
                    </div>
                </div>
            </section>

            {# Tableau dernières exécutions #}
            <section class="margin-top-2">
                <h3 class="h4">Dernières exécutions</h3>
                <table class="table-scroll" id="tableExecutions">
                    <thead>
                        <tr>
                            <th>Portefeuille</th>
                            <th>Utilisateur</th>
                            <th>Nb Projets</th>
                            <th>Temps moyen (s)</th>
                            <th>Mémoire moyenne (Mo)</th>
                            <th>Date exécution</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
        </main>

        {# Chargement de la section footer #}
        {{ include('footer.html.twig') }}
    </body>
</html>

{% set title = 'Réinitialisation' %}
{% set description = 'Ma-Moulinette - Changer son mot de passe.' %}
{% set type_content = "Application Ma-Moulinette, changer son mot de passe très compliqué." %}
{% set bottom="footer-fixed" %}

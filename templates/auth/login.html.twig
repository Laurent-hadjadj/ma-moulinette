{% set title = 'Authentification' %}
{% set description = 'Ma-Moulinette - Authentification' %}
{% set type_content = "Application Ma-Moulinette, l'authentification sécurisée." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>

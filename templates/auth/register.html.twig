{% set title = 'Inscription' %}
{% set description = 'Ma-Moulinette - Inscription' %}
{% set type_content = "Application Ma-Moulinette, formulaire d'inscription." %}
{% set bottom="footer-fixed" %}
<!DOCTYPE html>
<!--

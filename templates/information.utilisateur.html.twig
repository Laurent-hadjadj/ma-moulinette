{# Menu Information utilisateur #}
{% if is_granted('ROLE_UTILISATEUR') %}
<dialog id="modal-information-utilisateur"
        class="reveal small" data-reveal
        data-close-on-click="true"
        data-animation-in="fade-in" data-animation-out="fade-out"
        aria-modal="true"
        aria-labelledby="titre-modal-information-utilisateur"
        aria-describedby="desc-modal-information-utilisateur">

  <header class="grid-x align-justify align-middle margin-bottom-1">
    <p class="show-for-sr">Appuyez sur la touche Échap pour fermer cette fenêtre.</p>
    <div class="cell auto">
      <h1 id="titre-modal-information-utilisateur" class="h3 claire-hand">
        <span aria-hidden="true">ℹ️</span> Informations</h1>
      <p id="desc-modal-information-utilisateur" class="show-for-sr">
          Affiche les informations personnelles de l'utilisateur et permet de changer son mot de passe.
      </p>
    </div>
  </header>

  <section>
    <p class="open-sans">
      <strong>Nom&nbsp;:</strong> <span class="color-noir">{{ app.user.nom|upper}}</span>
    </p>
    <p class="open-sans">
      <strong>Prénom&nbsp;:</strong> <span class="color-noir">{{ app.user.prenom|capitalize }}</span>
    </p>
    <p class="open-sans">
      <strong>Courriel&nbsp;:</strong> <span class="color-noir">{{ app.user.courriel }}</span>
    </p>
    <p class="open-sans">
      <strong>Créer le&nbsp;:</strong> <span class="color-noir">{{ app.user.dateEnregistrement|date("d/m/Y", "Europe/Paris")}}</span>
    </p>
    <p class="open-sans">
      <strong>Modifier le&nbsp;:</strong> <span class="color-noir">{{ app.user.dateModification|date("d/m/Y H:i:s", "Europe/Paris") }}</span>
    </p>
    <div class="grid-x margin-top-1">
      <p class="open-sans">Mise à jour du mot-de-passe&nbsp;?&nbsp;</p>
      <div class="switch switch-reset-password small">
        <input id="js-reset-password"
              class="switch-input"
              type="checkbox"
              role="switch"
              aria-checked="false"
              aria-label="Mise à jour du mot de passe"
              name="variationSwitch"
              data-reset-password="{{app.user.resetPassword}}">
        <label class="switch-paddle switch-paddle-reset-password" for="js-reset-password">
          <span class="show-for-sr">Mise à jour du mot-de-passe&nbsp;?</span>
          <span class="switch-active switch-reset-password-active" aria-hidden="true">Oui</span>
          <span class="switch-inactive switch-reset-password-inactive" aria-hidden="true">Non</span>
        </label>
      </div>
    </div>
  </section>

  <output id="mise-a-jour-message" class="open-sans text-justify"></output>

  <footer class="grid-x grid-padding-x align-right margin-top-2">
      <div class="cell shrink">
        <button id="bouton-fermer-information-utilisateur"
                type="button"
                class="button open-sans focus-dark-light"
                data-close
                aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span> Fermer</button>
      </div>
  </footer>
</dialog>
{% endif %}

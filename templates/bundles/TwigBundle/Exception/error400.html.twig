<html lang="fr" dir="ltr">

  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {% block importmap %}{{ importmap('errors') }}{% endblock %}
  </head>

  <body>
    {# WCAG 4.1.3 : bloc d'erreur annoncé immédiatement comme alerte aux lecteurs d'écran #}
    <div id="guru" role="alert" aria-label="Message d'erreur système">
      <p>
        <span class="lol-eod">Software failure.</span>
        <span class="press-left-button">Press left mouse button to continue.</span>
      </p>
      <p>Guru Meditation #
        {{ random(0, 5000 ) }}{{ random('abcdef') }}{{ random(0, 400) }}.{{ random() }}
      </p>
    </div>

    {# WCAG 2.4.1 : id="main-content" pour cohérence avec le reste du site ; le <h1> de la page est l'unique <h1> (page standalone sans header.html.twig) #}
    <main id="main-content" class="main-content">
      {# WCAG 1.3.1 : aria-label explicite pour que le lecteur d'écran annonce l'erreur complète (et pas seulement le code) #}
      <h1 class="code-erreur pop-pins" aria-label="Erreur 400, mauvaise requête">400</h1>

      <div class="logo-mm-container">
        <svg xmlns="http://www.w3.org/2000/svg" class="logo-mm-svg" aria-hidden="true" focusable="false" viewBox="0 0 256 256" opacity=".991" shape-rendering="geometricprecision" text-rendering="geometricprecision" image-rendering="optimizequality" fill-rule="evenodd" clip-rule="evenodd"><path d="M28 0h10c4.596 2.76 8.43 6.427 11.5 11 3.654 6.8 6.82 13.8 9.5 21A114.845 114.845 0 0174.5 4 35.491 35.491 0 0080 0h10c7.857 4.996 13.357 11.996 16.5 21a142.514 142.514 0 019 36 536.283 536.283 0 013 54c.5 48.332.667 96.666.5 145H85c.167-51.334 0-102.668-.5-154-3.145-11.938-5.812-11.605-8 1-.5 50.999-.667 101.999-.5 153H42c.167-51.334 0-102.668-.5-154 .013-3.624-1.32-6.624-4-9-2.316 3.277-3.649 6.944-4 11-.5 50.666-.667 101.332-.5 152H0V76c1.572-18.014 5.405-35.68 11.5-53C14.597 13.42 20.097 5.754 28 0zM160.84.462h10c4.597 2.76 8.43 6.427 11.5 11 3.655 6.8 6.82 13.8 9.5 21a114.848 114.848 0 0115.5-28 35.491 35.491 0 005.5-4h10c7.858 4.996 13.358 11.996 16.5 21 6.432 18.611 10.265 37.611 11.5 57v178h-33c.168-51.334 0-102.668-.5-154-3.19-11.889-5.856-11.556-8 1-.5 51-.666 102-.5 153h-34c.168-51.334 0-102.668-.5-154 .014-3.624-1.32-6.624-4-9-2.314 3.277-3.648 6.944-4 11-.5 50.666-.666 101.332-.5 152h-34c-.166-51.668 0-103.334.5-155-.798-28.62 3.869-56.288 14-83 3.207-7.47 8.04-13.47 14.5-18z"/></svg>
      </div>
      <h2 class="message-erreur pop-pins">Oups ! Mauvaise requête.</h2>

      <p class="information-erreur pop-pins">Le serveur ne peut ou ne veut pas traiter la demande en raison d'une erreur du client.</p>

      <div class="bouton-container" >
        {# WCAG 4.1.2 : le nesting <button><a> n'est pas valide en HTML (interactif dans interactif) ; remplacé par un <a> stylé comme bouton #}
        <a href="{{ path('accueil', {}) }}" class="bouton pop-pins" aria-label="Aller à la page d'accueil">Accueil</a>
      </div>
    </main>
  </body>
</html>

{# Formulaire - Modifier les versions #}
<div id="modal-modifier-analyse"
      class="reveal large"
      data-close-on-click="true"
      data-animation-in="fade-in"
      data-animation-out="fade-out"
      data-reveal
      aria-modal="true"
      aria-labelledby="titre-modifier-version"
      aria-describedby="desc-modifier-version">

  <header>
    <h1 id="titre-modifier-version" class="h3 claire-hand"><span aria-hidden="true">ℹ️</span>Suivi des versions</h1>
    <h2 id="desc-modifier-version" class="h4 claire-hand"><span aria-hidden="true">📋</span>Modifier les paramètres d'une version</h2>
    <span class="show-for-sr">
      Cette page présente la listes des version présentes dans l'historique de suivi.
    </span>
  </header>

  <div class="table-scroll">
    <table class="hover">
      <caption class="claire-hand">Modifier les propriétés d'une version.</caption>
      <thead>
        <tr class="open-sans text-center">
          <th id="action" scope="col">Action</th>
          <th id="modifier-date" scope="col">Date</th>
          <th id="modifier-version" scope="col">Version</th>
          <th id="modifier-favori" scope="col">Favori</th>
          <th id="modifier-reference" scope="col">Référence</th>
        </tr>
      </thead>
      <tbody id="tableau-liste-version" class="open-sans">
        {# On ajoute des lignes vides pour éviter d'avoir une erreur W3C #}
        <tr><td>&nbsp;</td></tr>
      </tbody>
    </table>
  </div>

  {# fermeture de la fenêtre modale #}
  <footer class="grid-x grid-margin-x align-right margin-top-2">
    <div class="cell shrink">
      <button id="bouton-fermer-modifier-analyse" data-close
              class="button open-sans focus-light"
              type="button"
              aria-label="Fermer la fenêtre"><span aria-hidden="true">❌</span>Fermer
      </button>
  </footer>
</div>

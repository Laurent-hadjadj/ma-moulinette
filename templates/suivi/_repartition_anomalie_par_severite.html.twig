            {% endif %}

            {% if i !=0 and details[i]["code_smell_minor"] > details[i-1]["code_smell_minor"] %}
              {% set text3 = "text-down" %}
            {% else %}
              {% set text3 = "text-up" %}
            {% endif %}

            {% if i==0  %}
              {% set text1, text2, text3 = "text-noir", "text-noir", "text-noir" %}
            {% endif %}

            {% if details[i]["bug_minor"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text1}}">
                {{details[i]["bug_minor"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["vulnerability_minor"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text2}}">
                {{details[i]["vulnerability_minor"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["code_smell_minor"]==-1  %}

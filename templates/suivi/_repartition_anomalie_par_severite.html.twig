{# Affiche le tableau des anomalies par sévérité détaillée #}
<div class="table-scroll">
  <table class="hover">
    <caption class="claire-hand">Répartition des anomalies par type de sévérité.</caption>
    <thead>
      <tr>
        <th scope="col"></th>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {# 0 = FALSE, 1 = TRUE  #}
            {% if details[i]["initial"]==1 %}
              {% set reference="reference" %}
            {% else %}
              {% set reference="null" %}
            {% endif %}
            <th colspan="3" scope="col" class="open-sans text-center {{reference}}">
              {{details[i]["version"]}}
            </th>
          {% endfor %}
        {% endif %}
      </tr>
      <tr>
        <th scope="col"></th>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            <th colspan="3" scope="col" class="text-center">
              <span>{{details[i]["date"]|date("d/m/Y", "Europe/Paris")}}</span>
            </th>
          {% endfor %}
        {% endif %}
      </tr>
    </thead>
    <tbody id="tableau-anomalie-type-severite" class="open-sans">
      <tr>
        <td></td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            <td class="c-rouge text-right">
              <strong>Bug</strong>
            </td>
            <td class="c-rouge text-right">
              <strong>Faille</strong>
            </td>
            <td class="c-rouge text-right">
              <strong>MP</strong>
            </td>
          {% endfor %}
        {% endif %}
      </tr>
      <tr>
        <td class="text-rouge">Bloquant</td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {% if i !=0 and details[i]["bug_blocker"]> details[i-1]["bug_blocker"] %}
              {% set text1 = "text-down" %}
            {% else %}
              {% set text1 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["vulnerability_blocker"] > details[i-1]["vulnerability_blocker"] %}
              {% set text2 = "text-down" %}
            {% else %}
              {% set text2 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["code_smell_blocker"] > details[i-1]["code_smell_blocker"] %}
              {% set text3 = "text-down" %}
            {% else %}
              {% set text3 = "text-up" %}
            {% endif %}

            {% if i==0 %}
              {% set text1, text2, text3 = "text-noir", "text-noir", "text-noir" %}
            {% endif %}
            {% if details[i]["bug_blocker"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              {% else %}
                <td class="text-right {{text1}}">
                  {{details[i]["bug_blocker"]|format_number(locale='fr')}}
                </td>
              {% endif %}

              {% if details[i]["vulnerability_blocker"]==-1 %}
                <td class="text-center text-noir separation-gauche">
                  <span>-</span>
                </td>
              {% else %}
                <td class="text-right {{text2}}">
                  {{details[i]["vulnerability_blocker"]|format_number(locale='fr')}}
                </td>
              {% endif %}

              {% if details[i]["code_smell_blocker"]==-1  %}
                <td class="text-center text-noir separation-gauche">
                  <span>-</span>
                </td>
              {% else %}
                <td class="text-right {{text3}} separation-gauche">
                  {{details[i]["code_smell_blocker"]|format_number(locale='fr')}}
                </td>
              {% endif %}
            {% endfor %}
          {% endif %}
        </tr>
      </tr>
      <tr>
        <td class="text-orange">Critique</td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {% if i !=0 and details[i]["bug_critical"] > details[i-1]["bug_critical"] %}
              {% set text1 = "text-down" %}
            {% else %}
              {% set text1 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["vulnerability_critical"] > details[i-1]["vulnerability_critical"] %}
              {% set text2 = "text-down" %}
            {% else %}
              {% set text2 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["code_smell_critical"] > details[i-1]["code_smell_critical"] %}
              {% set text3 = "text-down" %}
            {% else %}
              {% set text3 = "text-up" %}
            {% endif %}

            {% if i==0  %}
              {% set text1, text2, text3 = "text-noir", "text-noir", "text-noir" %}
            {% endif %}

            {% if details[i]["bug_critical"]==-1 %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text1}}">
                {{details[i]["bug_critical"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["vulnerability_critical"]==-1 %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text2}}">
                {{details[i]["vulnerability_critical"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["code_smell_critical"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text3}} separation-gauche">
                {{details[i]["code_smell_critical"]|format_number(locale='fr')}}
              </td>
            {% endif %}
          {% endfor %}
        {% endif %}
      </tr>
      <tr>
        <td class="text-jaune">Majeur</td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {% if i !=0 and details[i]["bug_major"] > details[i-1]["bug_major"] %}
              {% set text1 = "text-down" %}
            {% else %}
              {% set text1 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["vulnerability_major"] > details[i-1]["vulnerability_major"] %}

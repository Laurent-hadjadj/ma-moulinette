            {% if i !=0 and details[i]["code_smell_major"] > details[i-1]["code_smell_major"] %}
              {% set text3 = "text-down" %}
            {% else %}
              {% set text3 = "text-up" %}
            {% endif %}

            {% if i==0  %}
              {% set text1, text2, text3 = "text-noir", "text-noir", "text-noir" %}
            {% endif %}

            {% if details[i]["bug_major"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text1}}">
                {{details[i]["bug_major"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["vulnerability_major"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text2}}">
                {{details[i]["vulnerability_major"]|format_number(locale='fr')}}
              </td>
            {% endif %}

            {% if details[i]["code_smell_major"]==-1  %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text3}} separation-gauche">
                {{details[i]["code_smell_major"]|format_number(locale='fr')}}
              </td>
            {% endif %}
          {% endfor %}
        {% endif %}
      </tr>
      <tr>
        <td class="text-vert">Mineur</td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {% if i !=0 and details[i]["bug_minor"] > details[i-1]["bug_minor"] %}
              {% set text1 = "text-down" %}

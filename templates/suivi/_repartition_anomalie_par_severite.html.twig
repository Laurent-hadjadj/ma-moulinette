            {% endif %}

            {% if i==0  %}
              {% set text1, text2, text3 = "text-noir", "text-noir", "text-noir" %}
            {% endif %}

            {% if details[i]["bug_info"]==-1 %}
              <td class="text-center text-noir separation-gauche">
                <span>-</span>
              </td>
            {% else %}
              <td class="text-right {{text1}}">
                {{details[i]["bug_info"]|format_number(locale='fr')}}

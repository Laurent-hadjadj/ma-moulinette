              </td>
            {% else %}
              <td class="text-right {{text3}} separation-gauche">
                {{details[i]["code_smell_minor"]|format_number(locale='fr')}}
              </td>
            {% endif %}
          {% endfor %}
        {% endif %}
      </tr>
      <tr>
        <td class="text-bleu">Info</td>
        {% if details is not empty %}
          {% for i in 0..details|length-1 %}
            {% if i !=0 and details[i]["bug_info"] > details[i-1]["bug_info"] %}
              {% set text1 = "text-down" %}
            {% else %}
              {% set text1 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["vulnerability_info"] > details[i-1]["vulnerability_info"] %}
              {% set text2 = "text-down" %}
            {% else %}
              {% set text2 = "text-up" %}
            {% endif %}

            {% if i !=0 and details[i]["code_smell_info"] > details[i-1]["code_smell_info"] %}
              {% set text3 = "text-down" %}
            {% else %}

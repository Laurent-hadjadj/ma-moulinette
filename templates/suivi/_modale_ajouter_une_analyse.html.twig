{# Formulaire Ajout d'une version de l'historique #}
<dialog id="modal-ajouter-analyse" class="reveal large" data-reveal data-close-on-click="true" data-animation-in="fade-in" data-animation-out="fade-out" aria-modal="true">
  <h1 class="h2 claire-hand">Ajouter une version.</h1>
  <br>

  <div class="enregistrer-analyse-container">
    <button class="js-enregistrer-analyse enregistrer-analyse no-select"
            aria-label="Ajouter une analyse du projet dans l'historique.">
      <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 32 32" class="enregistrer-analyse-svg" aria-hidden="true">
        <path d="M10.452.092C9.386.36 8.389 1.323 8.086 2.383l-.093.336H6.866c-.948 0-1.152.02-1.276.102-.199.146-.316.47-.316.882v.349H4.116c-1.728 0-2.317.197-3.116 1.015C.542 5.537.238 6.07.102 6.66c-.136.615-.136 18.535 0 19.15.217.94.917 1.835 1.765 2.24.254.128.614.261.793.299.223.044 1.902.07 5.19.07 4.429 0 4.88-.007 5.042-.108.34-.203.415-.71.16-1.015l-.148-.178-5.01-.032-5.005-.031-.415-.21c-.47-.235-.743-.52-.972-1.028l-.161-.349V7.003l.204-.426c.23-.482.508-.761 1.004-.996.322-.158.402-.165 1.536-.184l1.189-.025v.387c0 .818.21 1.364.693 1.827.552.52.316.495 5.315.495h4.428l.353-.177c.384-.197.718-.533.923-.946.105-.21.148-.425.173-.907l.037-.635h1.208c1.177 0 1.214.007 1.555.165.427.21.786.565.99.984.15.31.15.33.18 2.722.031 2.602.037 2.614.372 2.792.229.12.39.12.625-.006.347-.178.366-.318.366-2.608 0-2.437-.037-2.786-.366-3.478-.396-.85-.978-1.396-1.84-1.732-.402-.152-.507-.165-1.77-.19l-1.35-.026v-.463c0-.406-.02-.495-.15-.647l-.148-.178-1.195-.032-1.19-.031-.074-.26C13.92.72 12.142-.328 10.452.091zm1.61 1.447c.632.298 1.047.901 1.14 1.65.099.812.192.863 1.61.863h1.053V5.13c0 1.224-.05 1.408-.403 1.56-.31.134-8.107.134-8.417 0-.384-.164-.409-.253-.409-1.51v-1.13h1.06c1.38 0 1.474-.05 1.573-.856.08-.647.446-1.237.947-1.535.607-.368 1.233-.407 1.846-.121z"/><path d="M4.301 10.918c-.353.177-.415.774-.105 1.072l.161.152 6.807.02c7.575.019 7.091.044 7.277-.413a.667.667 0 00-.204-.78c-.155-.127-.23-.127-6.98-.121-4.59 0-6.863.025-6.956.07zm0 4.06c-.353.179-.415.775-.105 1.073l.161.153 4.825.019c5.376.019 5.116.038 5.295-.413a.667.667 0 00-.204-.78c-.155-.127-.235-.127-4.998-.12-3.215 0-4.88.025-4.974.069zm17.448.014c-3.76.685-6.597 3.68-7.13 7.52-.092.672-.043 2.29.094 2.924.359 1.682 1.108 3.122 2.273 4.347 1.245 1.314 2.67 2.12 4.44 2.52.899.202 2.521.202 3.413 0 1.765-.407 3.11-1.156 4.348-2.418 1.233-1.27 1.963-2.646 2.36-4.455.198-.914.198-2.576 0-3.496a8.753 8.753 0 00-.787-2.26c-.458-.907-.935-1.554-1.672-2.29a8.491 8.491 0 00-4.212-2.323c-.6-.14-2.50
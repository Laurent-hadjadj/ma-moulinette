      </svg><span class="open-sans color-blanc">&nbsp;Ajouter</span>
    </button>
  </div>

  {# Versions disponibles #}
  <div class="grid-x cell">
    <div class="small-12 medium-12 large-12 cell">
      <h2 class="h4 open-sans">Liste des versions disponibles.</h2>
      <label for="liste-version">Choisissez une version :</label>
      <select id="liste-version" class="js-version open-class" name="version">
        <option value="TheID" selected="selected">--- Version ---</option>
      </select>
    </div>
  </div>
  <br>
  <div id="message-ajout-projet"></div>

  {# Tableau des indicateurs de la version #}
  <div class="fieldset cell">
    <div class="grid-x">
      <div class="small-12 medium-7 large-7 cell">
        <p class="open-sans ligne">Clé maven :
          <span id="key-maven" class="result"></span>
        </p>
        <p class="open-sans ligne">nom :
          <span id="nom" class="result"></span>
        </p>
        <p class="open-sans ligne">Version :
          <span id="version" class="result"></span>
        </p>
        <p class="open-sans ligne">Date :
          <span id="date" class="result"></span>
        </p>
      </div>
      <div class="small-12 medium-5 large-5 cell">
        <p class="open-sans ligne">Violation :
          <span id="violations" class="result"></span>
          <span class="result-note"></span>
        </p>
        <p class="open-sans ligne">Fiabilité :
          <span id="bugs" class="result"></span>
          <span id="reliability-rating" class="result-note"></span>
        </p>
        <p class="open-sans ligne">Sécurité :
          <span id="vulnerabilities" class="result"></span>
          <span id="security-rating" class="result-note"></span>
        </p>
        <p class="open-sans ligne">Hotspot :
          <span id="security-hotspots" class="result"></span>
          <span id="security-review-rating" class="result-note"></span>
        </p>
        <p class="open-sans ligne">Maintenabilité :
          <span id="code-smells" class="result"></span>
          <span id="sqale-rating" class="result-note"></span>
        </p>
      </div>
    </div>
  </div>

  {# Tableau des indicateurs du Projet #}
  <div class="fieldset cell">
    <div class="grid-x">
      {# Colonne gauche #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">Langages :
          <span id="ncloc-language-distribution" class="result"></span>
        </p>
        <p class="open-sans ligne">Fichier :
          <span id="files" class="result"></span>
        </p>
        <p class="open-sans ligne">Classe :
          <span id="classes" class="result"></span>
        </p>
        <p class="open-sans ligne">Fonction/méthode :
          <span id="functions" class="result"></span>
        </p>
      </div>
      {# Colonne droite #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">&nbsp;</p>
        <p class="open-sans ligne">Ligne :
          <span id="lines" class="result"></span>
        </p>
        <p class="open-sans ligne">NcLoc :
          <span id="ncloc" class="result"></span>
        </p>
      </div>
    </div>
  </div>
  <div class="fieldset cell">
    <div class="grid-x">
      {# Colonne gauche #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">Commentaire :
          <span id="comment-lines" class="result"></span>
        </p>
        <p class="open-sans ligne">% Duplication :
          <span id="duplicated-lines-density" class="result"></span>
        </p>
        <p class="open-sans ligne">Dette (j/h):
          <span id="dette" class="result"></span>
        </p>
      </div>
      {# Colonne droite #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">% Commentaire :
          <span id="comment-lines-density" class="result"></span>
        </p>
        <p class="open-sans ligne">% Couverture :
          <span id="coverage" class="result"></span>
        </p>
        <p class="open-sans ligne">Ratio de dette technique :
          <span id="sqale-debt-ratio" class="result"></span>
        </p>
      </div>
    </div>
  </div>
  <div class="fieldset cell">
    <div class="grid-x">
      {# Colonne gauche #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">Tests :
          <span id="tests" class="result"></span>
        </p>
        <p class="open-sans ligne">Tests non exécutés :
          <span id="skipped-tests" class="result"></span>
        </p>
        <p class="open-sans ligne">Tests en erreur :
          <span id="test-errors" class="result"></span>
        </p>
      </div>
      {# Colonne droite #}
      <div class="small-12 medium-6 large-6 cell">
        <p class="open-sans ligne">&nbsp;</p>
        <p class="open-sans ligne">Tests en échec :
          <span id="test-failures" class="result"></span>
        </p>
        <p class="open-sans ligne">% de succès :
          <span id="test-success-density" class="result"></span>
        </p>
      </div>
    </div>
  </div>

  <br>
  {# fermeture de la fenêtre modale #}
  <button id="fermer-choisir-analyse" class="expanded button open-sans" data-close aria-label="Close reveal" type="button">Fermer</button>
</dialog>

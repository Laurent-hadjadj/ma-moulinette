<html	lang="fr">
  {# Chargement de la section HEAD #}
  <head>
    <title>{{ title }}</title>
    {{ include('head.html.twig') }}
    {# Chargement des assets JS et CSS #}
    {% block importmap %}{{ importmap('suivi') }}{% endblock %}
  </head>

  <body dir="ltr">
    {# no-script #}
    {{ include('no-script.html.twig') }}
    {# Chargement de la section header #}
    {{ include('header.html.twig') }}

    <header class="grid-container margin-top-1">
      <nav aria-label="vous êtes Ici : ">
        <ul class="claire-hand breadcrumbs">
          <li><a href="{{ path('accueil', {}) }}">Accueil</a></li>
          <li><a href="{{ path('projet', {}) }}">Projet</a></li>
          <li><span class="show-for-sr">Vous êtes sur la page : suivi</span>Suivi</li>
        </ul>
      </nav>
    </header>

    {# Message d'information php #}
    {{ include('_message.html.twig') }}

    <header class="grid-container"
              aria-labelledby="titre-sonarqube">
      <h1 id="titre-sonarqube" class="h3 claire-hand" aria-label="Collecte et analyse des indicateurs SonarQube" aria-describedby="titre-sonarqube"><span aria-hidden="true">📊</span>Collecte et analyse des indicateurs SonarQube</h1>
      <div class="show-for-sr">Sur cette page, vous pouvez collecter et visualiser les métriques clés de vos projets SonarQube.</div>
    </header>

    {# En-tête #}
    <header id="element1-to-print" class="pleine-page">
      <h1 id="titre-js-nom" class="h3 claire-hand"
          aria-label="Tableaux de suivi du projet"
          aria-describedby="titre-js-nom"
          data-maven="{{mavenKey}}"><span aria-hidden="true">🧭</span>Suivi des indicateurs pour {{nom}}
      </h1>
      <div class="show-for-sr">
        Cette page présente les principaux indicateurs de suivi du projet et permet de générer un rapport PDF, d'ajouter une version dans l'historique et de modifier la version de référence ou favorite.
      </div>

      {% set nombre=suivi|length %}
      {% if nombre>1 %}
        {% set s="s"%}
      {% else %}
        {% set s="" %}
      {% endif %}
      <h2 class="h4 claire-hand">
          <span id="affiche-total-profil" class="mini-stat">
            <span aria-hidden="true">🗂️</span>{{nombre | default('0') }}</span>
            <span>version{{s}} sélectionnée{{s}} pour ce projet.</span>
          </span>
      </h2>
    </header>

    {# Affichage du suivi des anomalies #}
    {{ include('/suivi/_suivi_anomalie.html.twig') }}

    {# Menu des outils  #}
    {{ include('/suivi/_menu_outils.html.twig') }}

    {# Affiche le graphique des courbes des anomalies #}
    {{ include('/suivi/_affiche_graphique_anomalie.html.twig') }}
    {{ include('/suivi/_suivi_mesures.html.twig') }}
    {{ include('/suivi/_repartition_par_module.html.twig') }}
    {{ include('/suivi/_repartition_par_severity.html.twig') }}

    {# Affiche le tableau des anomalies par sévérité détaillée #}
    {{ include('/suivi/_repartition_anomalie_par_severity.html.twig') }}

    {#-- fenêtre modale --#}
    {{ include('/suivi/_modale_ajouter_une_analyse.html.twig') }}
    {{ include('/suivi/_modale_modifier_les_versions.html.twig') }}

    {# Chargement de la section footer #}
    {{ include('footer.html.twig') }}
  </body>
</html>

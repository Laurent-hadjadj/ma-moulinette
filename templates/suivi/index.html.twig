{% set title = 'Suivi des indicateurs du projet' %}
{% set description = 'Ma Moulinette - Suivi des versions.' %}
{% set type_content = "Application Ma-Moulinette, Suivi des indicateurs SonarQube le projet." %}
{% set bottom="footer-fixed" %}

{% set title = 'Clean Code — Synthèse portefeuille' %}
{% set description = 'Ma Moulinette - Vue synthétique des indicateurs clean code sur l\'ensemble du portefeuille.' %}
{% set bottom = 'footer-fixed' %}

{# MODIF 2026-05-19 : tableau de bord multi-projets clean code #}

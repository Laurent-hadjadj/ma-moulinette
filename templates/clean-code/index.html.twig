{% set title = 'Clean Code — Taxonomy SonarQube 10+' %}
{% set description = 'Ma Moulinette - Indicateurs clean code et conformité OWASP/SANS/CWE.' %}
{% set bottom = 'footer-fixed' %}

{# MODIF 2026-05-17 : mini tableau de bord des indicateurs
SonarQube 10+ : catégories clean code, impact sévérités/qualités, conformité. #}

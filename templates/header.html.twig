  {% if is_granted('ROLE_UTILISATEUR') %}
    <div class="grid-container cell menu-identifiant">
      <ul class="dropdown menu" data-dropdown-menu>
        <li class="is-dropdown-submenu-parent">
          <a href="#">
            <span class="menu-identifiant-titre color-bleu">{{ app.user.courriel}}</span>
          </a>
          <ul class="menu">
            <li>
              <a class="color-bleu menu-identifiant-item" href="#" data-open="modal-details">
                <div class="container-information no-select">
                  <svg version="1.1" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" width="100%" height="100%" viewbox="0 0 22 22"  class="information-utilisateur-svg"><path opacity=".99" d="M10.053.194c2.381-.078 4.18.9 5.393 2.935 1.097 2.403.783 4.596-.942 6.58-1.713 1.582-3.684 2.016-5.911 1.302-2.026-.837-3.212-2.344-3.557-4.52C4.84 4.037 5.773 2.167 7.84.88a6.23 6.23 0 012.214-.687z"/><path opacity=".983" d="M15.988 11.319c2.627-.121 4.472 1.015 5.535 3.408.808 2.644.11 4.782-2.096 6.414-2.129 1.192-4.186 1.082-6.17-.331-1.698-1.486-2.302-3.34-1.815-5.562.714-2.255 2.23-3.565 4.546-3.93zm.565 2.035c.895.189 1.17.71.825 1.562-.491.528-1.01.56-1.555.095-.327-.527-.272-1.009.165-1.444.18-.114.368-.185.565-.213zm-.188 2.556c.46-.057.766.133.919.568.031.947.031 1.894 0 2.84-.214.538-.583.688-1.107.45a.972.972 0 01-.307-.402 45.258 45.48 0 010-2.935.897.897 0 01.495-.52z"/><path opacity=".985" d="M9.723 12.17c.788-.017 1.573.014 2.355.095-1.763 1.99-2.195 4.247-1.295 6.77a6.82 6.82 0 001.201 1.893 362.93 364.716 0 01-10.128.024c-.902-.102-1.444-.6-1.625-1.491-.374-1.901.152-3.487 1.578-4.758a11.016 11.016 0 013.533-1.799c1.44-.409 2.9-.654 4.381-.733z"/></svg>&nbsp;Information</div>

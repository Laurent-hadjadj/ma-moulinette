<!-- head -->
{% set badge ='' %}
{% if  env == 'DEV' %}
  {% set badge = 'label background-color-rouge' %}
{% endif %}
{% if  env == 'REC' %}
  {% set badge = 'label background-color-bleu' %}
{% endif %}
{% if  env == 'PROD' %}
  {% set badge = 'label background-color-gris' %}
{% endif %}
<div class="grid-x cell">
  <div class="small-6 medium-6 large-6 cell">
    <div class="logo-container">
      <div class="logo" aria-label="Logo ma-moulinette">
        <img class="show-for-medium marque-entreprise" src="{{ asset('images/' ~logo_entreprise) }}" alt="Marque entreprise">
        <img class="marque-mm" src="{{ asset('images/logo-mm-300x150.min.svg') }}" alt="Logo Ma-moulinette">
      </div>

      <div class="ma-moulinette-container">
        <h1 class="claire-hand">
          <a tabindex="0" class="ma-moulinette" href="{{ path('accueil', {}) }}" rel="next" title="Retour vers la page principale">Ma-Moulinette</a>
        </h1>
        <h2 class="show-for-small-only claire-hand version" aria-label="Version">
          V.
          {{version}}
          <span class="{{badge}} label-custom color-blanc">{{env| default('') }}</span>
        </h2>
        <h2 class="show-for-medium claire-hand version" aria-label="Version">
          Version
          {{version}}
          <span class="{{badge}} label-custom color-blanc">{{env| default('') }}</span>
        </h2>
      </div>
    </div>
  </div>

  {# ------------------- Menu icônes --------------------#}
  <div
    class="small-7 medium-6 large-6 cell">
    {# Preferences | Déconnexion  #}

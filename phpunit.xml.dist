<?xml version="1.0" encoding="UTF-8"?>

<!--
    MODIF 2026-05-04 : modernisation du fichier au format PHPUnit 11/13.
    Avant : format PHPUnit 9 (convertDeprecationsToExceptions, <listeners>, <extensions>, <coverage processUncoveredFiles>).
    Après : format PHPUnit 11/13 (cacheDirectory, <source>, plus de listeners/extensions vides).
    Bridge Symfony retiré (incohérent avec PHPUnit 13 — le bridge tirait PHPUnit 9.5 en parallèle).
    Sauvegarde dans phpunit.xml.dist.bak.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
        bootstrap="tests/bootstrap.php"
        colors="true"
        cacheDirectory="var/cache/.phpunit.cache"
        executionOrder="depends,defects"
        beStrictAboutOutputDuringTests="true"
        failOnRisky="true"
        failOnWarning="true"
        displayDetailsOnTestsThatTriggerDeprecations="true"
        displayDetailsOnTestsThatTriggerErrors="true"
        displayDetailsOnTestsThatTriggerNotices="true"
        displayDetailsOnTestsThatTriggerWarnings="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- MODIF 2026-05-21 : force les variables test avant bootEnv() pour éviter
            que .env.local.php (compilé par dump-env prod en CI) ne les écrase.
            force="true" → PHPUnit peuple $_ENV avant Dotenv::bootEnv() ;
            Dotenv (overrideExistingVars=false) ne surcharge pas ce qui est déjà défini. -->
        <env name="DC_INGEST_TOKEN" value="test-dc-ingest-token-32chars-aaaa" force="true" />
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/DataFixtures</directory>
            <directory>src/Migrations</directory>
            <file>src/Kernel.php</file>
        </exclude>
    </source>

    <coverage includeUncoveredFiles="true">
        <report>
            <clover outputFile="var/coverage/clover.xml" />
            <html outputDirectory="var/coverage/report" />
            <text outputFile="php://stdout" showOnlySummary="true" />
        </report>
    </coverage>

    <extensions>
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension" />
    </extensions>
</phpunit>
